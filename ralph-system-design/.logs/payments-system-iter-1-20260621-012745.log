;\n      letter-spacing: -0.02em;\n      margin: 0 0 0.5rem;\n    }\n    .lead {\n      color: var(--muted);\n      font-size: 1.05rem;\n      margin: 0 0 2rem;\n    }\n    .study-order {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 1rem 1.25rem;\n      margin-bottom: 2rem;\n      box-shadow: var(--shadow);\n      font-size: 0.95rem;\n    }\n    .study-order strong { color: var(--accent); }\n    .study-hint {\n      margin: 0.75rem 0 0;\n      font-size: 0.875rem;\n      color: var(--muted);\n    }\n    ul.sections {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n    ul.sections li {\n      margin-bottom: 0.65rem;\n    }\n    ul.sections a {\n      display: block;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 1rem 1.25rem;\n      text-decoration: none;\n      color: var(--text);\n      box-shadow: var(--shadow);\n      transition: border-color 0.15s, transform 0.1s;\n    }\n    ul.sections a:hover {\n      border-color: var(--accent);\n      transform: translateY(-1px);\n    }\n    ul.sections .num {\n      font-size: 0.75rem;\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 0.06em;\n      color: var(--accent);\n      margin-bottom: 0.25rem;\n    }\n    ul.sections .title {\n      font-weight: 600;\n      font-size: 1.05rem;\n    }\n    ul.sections .meta {\n      font-size: 0.85rem;\n      color: var(--muted);\n      margin-top: 0.2rem;\n    }\n    footer {\n      margin-top: 2.5rem;\n      font-size: 0.85rem;\n      color: var(--muted);\n    }\n    footer a { color: var(--accent); }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <h1>Payments System Frontend System Design</h1>\n    <p class=\"lead\">Interview-depth answers for every question in the prep doc. Open any section in your browser — diagrams use Mermaid CDN where present.</p>\n\n    <div class=\"study-order\">\n      <strong>Suggested order:</strong> 01 Checkout Flow → 02 Security/PCI → 03 State Management → 06 Error Handling → rest.\n      <p class=\"study-hint\">Each section covers 10 questions (7 Core + 3 Deep) with problem framing, approach, and tradeoffs. Mermaid sequence and flow diagrams are rendered inline.</p>\n      <p class=\"study-hint\"><a href=\"../payments-system-frontend-architecture.html\"><strong>Interactive architecture map</strong></a> — full-system diagram with layer filters, flow walkthroughs (checkout, decline/retry, 3DS, async payment, PSP failover), and links to every section.</p>\n      <p class=\"study-hint\"><a href=\"../payments-system-system-design-interview.html\"><strong>Interview template (45–60m)</strong></a> — full answer in Requirements → Architecture → Data Model → API/BFF → Deep Dive format, covering PCI SAQ-A, PaymentIntent FSM, idempotency, and Stripe Elements.</p>\n    </div>\n\n    <ul class=\"sections\">\n      <li>\n        <a href=\"01-checkout-flow-form-ux.html\">\n          <div class=\"num\">Section 1</div>\n          <div class=\"title\">Checkout Flow &amp; Form UX</div>\n          <div class=\"meta\">10 questions · Multi-step state machine, card masking, validation timing, loading states</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"02-payment-security-pci-compliance.html\">\n          <div class=\"num\">Section 2</div>\n          <div class=\"title\">Payment Security &amp; PCI Compliance</div>\n          <div class=\"meta\">10 questions · PCI DSS scope, Stripe Elements iframe, CSP, tokenization, clickjacking</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"03-state-management-transaction-lifecycle.html\">\n          <div class=\"num\">Section 3</div>\n          <div class=\"title\">State Management &amp; Transaction Lifecycle</div>\n          <div class=\"meta\">10 questions · PaymentIntent FSM, idempotency, optimistic UI, tab-close recovery</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"04-real-time-updates-webhooks.html\">\n          <div class=\"num\">Section 4</div>\n          <div class=\"title\">Real-Time Updates &amp; Webhooks</div>\n          <div class=\"meta\">10 questions · SSE vs WebSocket vs polling, webhook ground truth, async payment methods</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"05-performance-core-web-vitals.html\">\n          <div class=\"num\">Section 5</div>\n          <div class=\"title\">Performance &amp; Core Web Vitals</div>\n          <div class=\"meta\">10 questions · Stripe.js loading strategy, CLS prevention, bundle splitting, TBT/INP</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"06-error-handling-resilience.html\">\n          <div class=\"num\">Section 6</div>\n          <div class=\"title\">Error Handling &amp; Resilience</div>\n          <div class=\"meta\">10 questions · Decline taxonomy, 3DS challenge flow, circuit breaker, offline idempotency</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"07-internationalization-localization.html\">\n          <div class=\"num\">Section 7</div>\n          <div class=\"title\">Internationalization &amp; Localization</div>\n          <div class=\"meta\">10 questions · Intl.NumberFormat, RTL checkout, local payment methods, multi-currency</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"08-observability-analytics.html\">\n          <div class=\"num\">Section 8</div>\n          <div class=\"title\">Observability &amp; Analytics</div>\n          <div class=\"meta\">10 questions · Funnel events, PCI sanitization, RUM instrumentation, A/B experiments</div>\n        </a>\n      </li>\n      <li>\n        <a href=\"09-architecture-provider-abstraction.html\">\n          <div class=\"num\">Section 9</div>\n          <div class=\"title\">Architecture &amp; Provider Abstraction</div>\n          <div class=\"meta\">10 questions · IPaymentProvider adapter, PSP normalization, failover, Braintree→Stripe migration</div>\n        </a>\n      </li>\n    </ul>\n\n    <footer>\n      Source: <a href=\"../answers/\">markdown answers</a> ·\n      <a href=\"../payments-system-design-doc.md\">question bank</a>\n    </footer>\n  </div>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
