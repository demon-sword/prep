4\t      align-items: center;\n55\t      gap: 0.5rem;\n56\t      padding: 0 1rem;\n57\t      background: rgba(var(--surface-rgb, 255,255,255), .92);\n58\t      backdrop-filter: blur(10px);\n59\t      border-bottom: 1px solid var(--border);\n60\t      overflow-x: auto;\n61\t    }\n62\t    @media (prefers-color-scheme: dark) {\n63\t      .top-nav { background: rgba(23, 28, 40, .94); }\n64\t    }\n65\t    .top-nav a {\n66\t      font-size: 0.8125rem;\n67\t      white-space: nowrap;\n68\t      padding: 0.35rem 0.65rem;\n69\t      border-radius: 999px;\n70\t      text-decoration: none;\n71\t      color: var(--muted);\n72\t      border: 1px solid transparent;\n73\t    }\n74\t    .top-nav a:hover { color: var(--text); border-color: var(--border); }\n75\t    .top-nav a.active { background: var(--accent-soft); color: var(--accent); border-color: var(--accent); font-weight: 600; }\n76\t    .nav-title { font-weight: 700; font-size: 0.875rem; margin-right: 0.5rem; white-space: nowrap; }\n77\t    .nav-links { margin-left: auto; display: flex; gap: 0.5rem; font-size: 0.8125rem; }\n78\t    .nav-links a { color: var(--accent); text-decoration: none; white-space: nowrap; }\n79\t    .wrap { max-width: 920px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }\n80\t    .hero { margin-bottom: 2rem; }\n81\t    .hero h1 { font-size: 1.75rem; margin: 0 0 0.5rem; letter-spacing: -0.02em; }\n82\t    .hero p { color: var(--muted); margin: 0; max-width: 640px; }\n83\t    .timer-bar {\n84\t      display: flex;\n85\t      flex-wrap: wrap;\n86\t      gap: 0.5rem;\n87\t      margin: 1.25rem 0 0;\n88\t    }\n89\t    .timer-chip {\n90\t      font-size: 0.75rem;\n91\t      padding: 0.3rem 0.65rem;\n92\t      border-radius: 6px;\n93\t      border: 1px solid var(--border);\n94\t      background: var(--surface);\n95\t    }\n96\t    .timer-chip strong { color: var(--accent); }\n97\t\n98\t    .section-block {\n99\t      margin-bottom: 2.5rem;\n100\t      background: var(--surface);\n101\t      border: 1px solid var(--border);\n102\t      border-radius: 12px;\n103\t      box-shadow: var(--shadow);\n104\t      overflow: hidden;\n105\t    }\n106\t    .section-head {\n107\t      display: flex;\n108\t      align-items: flex-start;\n109\t      gap: 1rem;\n110\t      padding: 1.25rem 1.5rem;\n111\t      border-bottom: 1px solid var(--border);\n112\t      cursor: pointer;\n113\t      user-select: none;\n114\t    }\n115\t    .section-head:hover { background: var(--surface2); }\n116\t    .section-num {\n117\t      flex-shrink: 0;\n118\t      width: 2.5rem;\n119\t      height: 2.5rem;\n120\t      border-radius: 8px;\n121\t      display: flex;\n122\t      align-items: center;\n123\t      justify-content: center;\n124\t      font-weight: 800;\n125\t      font-size: 0.875rem;\n126\t      color: #fff;\n127\t    }\n128\t    .section-num.req { background: var(--req); }\n129\t    .section-num.arch { background: var(--arch); }\n130\t    .section-num.data { background: var(--data); }\n131\t    .section-num.api { background: var(--api); }\n132\t    .section-num.deep { background: var(--deep); }\n133\t    .section-head h2 { margin: 0; font-size: 1.2rem; }\n134\t    .section-meta { font-size: 0.8125rem; color: var(--muted); margin-top: 0.15rem; }\n135\t    .chevron { margin-left: auto; color: var(--muted); transition: transform 0.2s; }\n136\t    .section-block.collapsed .chevron { transform: rotate(-90deg); }\n137\t    .section-block.collapsed .section-body { display: none; }\n138\t    .section-body { padding: 1.25rem 1.5rem 1.5rem; }\n139\t\n140\t    h3 {\n141\t      font-size: 0.9375rem;\n142\t      margin: 1.25rem 0 0.5rem;\n143\t      color: var(--accent);\n144\t    }\n145\t    h3:first-child { margin-top: 0; }\n146\t    p, li { font-size: 0.9375rem; }\n147\t    ul { padding-left: 1.25rem; }\n148\t    table {\n149\t      width: 100%;\n150\t      border-collapse: collapse;\n151\t      font-size: 0.875rem;\n152\t      margin: 0.75rem 0;\n153\t    }\n154\t    th, td {\n155\t      border: 1px solid var(--border);\n156\t      padding: 0.55rem 0.75rem;\n157\t      text-align: left;\n158\t      vertical-align: top;\n159\t    }\n160\t    th { background: var(--surface2); font-weight: 600; }\n161\t    .callout {\n162\t      padding: 0.85rem 1rem;\n163\t      border-left: 3px solid var(--accent);\n164\t      background: var(--accent-soft);\n165\t      border-radius: 0 8px 8px 0;\n166\t      font-size: 0.875rem;\n167\t      margin: 1rem 0;\n168\t    }\n169\t    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }\n170\t    @media (max-width: 700px) { .grid-2 { grid-template-columns: 1fr; } }\n171\t\n172\t    .card {\n173\t      border: 1px solid var(--border);\n174\t      border-radius: 8px;\n175\t      padding: 1rem;\n176\t      background: var(--surface2);\n177\t    }\n178\t    .card h4 { margin: 0 0 0.35rem; font-size: 0.875rem; }\n179\t    .card p { margin: 0; font-size: 0.8125rem; color: var(--muted); }\n180\t\n181\t    .entity {\n182\t      font-family: ui-monospace, Menlo, Consolas, monospace;\n183\t      font-size: 0.8125rem;\n184\t      background: var(--bg);\n185\t      border: 1px solid var(--border);\n186\t      border-radius: 8px;\n187\t      padding: 1rem;\n188\t      margin: 0.75rem 0;\n189\t      white-space: pre-wrap;\n190\t      line-height: 1.5;\n191\t    }\n192\t    .entity .kw { color: var(--accent); font-weight: 600; }\n193\t\n194\t    .component-tree {\n195\t      font-family: ui-monospace, Menlo, Consolas, monospace;\n196\t      font-size: 0.8125rem;\n197\t      background: var(--bg);\n198\t      border: 1px solid var(--border);\n199\t      border-radius: 8px;\n200\t      padding: 1rem 1.25rem;\n201\t      line-height: 1.55;\n202\t    }\n203\t    .component-tree .hl { color: var(--accent); font-weight: 600; }\n204\t\n205\t    .state-ladder {\n206\t      display: flex;\n207\t      flex-wrap: wrap;\n208\t      gap: 0.5rem;\n209\t      margin: 0.75rem 0;\n210\t    }\n211\t    .state-step {\n212\t      flex: 1;\n213\t      min-width: 120px;\n214\t      padding: 0.65rem;\n215\t      border: 1px solid var(--border);\n216\t      border-radius: 8px;\n217\t      text-align: center;\n218\t      font-size: 0.8125rem;\n219\t    }\n220\t    .state-step strong { display: block; font-size: 0.75rem; color: var(--accent); margin-bottom: 0.25rem; }\n221\t\n222\t    .deep-tabs {\n223\t      display: flex;\n224\t      flex-wrap: wrap;\n225\t      gap: 0.35rem;\n226\t      margin-bottom: 1rem;\n227\t    }\n228\t    .deep-tab {\n229\t      font: inherit;\n230\t      font-size: 0.8125rem;\n231\t      padding: 0.4rem 0.75rem;\n232\t      border: 1px solid var(--border);\n233\t      border-radius: 6px;\n234\t      background: var(--surface2);\n235\t      color: var(--muted);\n236\t      cursor: pointer;\n237\t    }\n238\t    .deep-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }\n239\t    .deep-panel { display: none; }\n240\t    .deep-panel.active { display: block; }\n241\t\n242\t    .mermaid-wrap {\n243\t      margin: 1rem 0;\n244\t      padding: 1rem;\n245\t      border: 1px solid var(--border);\n246\t      border-radius: 8px;\n247\t      overflow-x: auto;\n248\t    }\n249\t    .mermaid-wrap pre.mermaid:not([data-mermaid-rendered]) {\n250\t      background: transparent;\n251\t      color: var(--muted);\n252\t      font-size: 0.75rem;\n253\t      margin: 0;\n254\t    }\n255\t\n256\t    .checklist { list-style: none; padding: 0; margin: 0; }\n257\t    .checklist li {\n258\t      display: flex;\n259\t      align-items: flex-start;\n260\t      gap: 0.5rem;\n261\t      padding: 0.4rem 0;\n262\t      border-bottom: 1px dashed var(--border);\n263\t      font-size: 0.875rem;\n264\t    }\n265\t    .checklist input { margin-top: 0.25rem; accent-color: var(--accent); }\n266\t    .section-links { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 1rem; }\n267\t    .section-links a {\n268\t      font-size: 0.75rem;\n269\t      padding: 0.25rem 0.5rem;\n270\t      border-radius: 4px;\n271\t      background: var(--accent-soft);\n272\t      color: var(--accent);\n273\t      text-decoration: none;\n274\t    }\n275\t    footer {\n276\t      text-align: center;\n277\t      font-size: 0.8125rem;\n278\t      color: var(--muted);\n279\t      padding: 2rem 0;\n280\t    }\n281\t    footer a { color: var(--accent); }\n282\t  </style>\n283\t</head>\n284\t<body>\n285\t  <nav class=\"top-nav\" id=\"topNav\">\n286\t    <span class=\"nav-title\">Claude SD — Template</span>\n287\t    <a href=\"#requirements\" data-section=\"requirements\">① Requirements</a>\n288\t    <a href=\"#architecture\" data-section=\"architecture\">② Architecture</a>\n289\t    <a href=\"#data-model\" data-section=\"data-model\">③ Data Model</a>\n290\t    <a href=\"#api-design\" data-section=\"api-design\">④ API / BFF</a>\n291\t    <a href=\"#deep-dive\" data-section=\"deep-dive\">⑤ Deep Dive</a>\n292\t    <div class=\"nav-links\">\n293\t      <a href=\"claude-frontend-architecture.html\">Architecture map</a>\n294\t      <a href=\"answers-html/index.html\">All answers</a>\n295\t    </div>\n296\t  </nav>\n297\t\n298\t  <div class=\"wrap\">\n299\t    <header class=\"hero\">\n300\t      <h1>Design a Claude-Style AI Chat Frontend</h1>\n301\t      <p>Complete system design answer in interview format (~45–60 min). Use this as your master script; drill into section pages for question-level depth.</p>\n302\t      <div class=\"timer-bar\">\n303\t        <span class=\"timer-chip\"><strong>5–10m</strong> Requirements</span>\n304\t        <span class=\"timer-chip\"><strong>10–15m</strong> Architecture</span>\n305\t        <span class=\"timer-chip\"><strong>5m</strong> Data Model</span>\n306\t        <span class=\"timer-chip\"><strong>10m</strong> API / BFF</span>\n307\t        <span class=\"timer-chip\"><strong>10m</strong> Deep Dive</span>\n308\t      </div>\n309\t    </header>\n310\t\n311\t    <!-- ① REQUIREMENTS -->\n312\t    <article class=\"section-block\" id=\"requirements\" data-section=\"requirements\">\n313\t      <div class=\"section-head\">\n314\t        <div class=\"section-num req\">①</div>\n315\t        <div>\n316\t          <h2>Requirements</h2>\n317\t          <div class=\"section-meta\">5–10 min · Clarify with interviewer · Scope before designing</div>\n318\t        </div>\n319\t        <span class=\"chevron\">▼</span>\n320\t      </div>\n321\t      <div class=\"section-body\">\n322\t        <div class=\"callout\"><strong>Opening line:</strong> “Before I draw boxes, let me confirm functional scope, non-functional targets, and what we’re explicitly not building in v1.”</div>\n323\t\n324\t        <h3>Functional Requirements (Business)</h3>\n325\t        <table>\n326\t          <thead><tr><th>Area</th><th>Must have (v1)</th><th>Nice to have</th></tr></thead>\n327\t          <tbody>\n328\t            <tr><td>Chat</td><td>Multi-turn conversation, streaming assistant replies, stop generation, markdown + code blocks</td><td>Branch switcher, edit-any-message, voice input</td></tr>\n329\t            <tr><td>History</td><td>Sidebar conversation list, open/switch threads, persist across refresh</td><td>Search 10k+ convos, share public link</td></tr>\n330\t            <tr><td>Tools</td><td>Tool call pills (loading/success/error), confirm for destructive MCP actions</td><td>Multi-step agent chains, activity audit drawer</td></tr>\n331\t            <tr><td>Artifacts</td><td>— (scope out unless asked)</td><td>Sandboxed HTML/React preview, version timeline</td></tr>\n332\t            <tr><td>Input</td><td>Auto-grow composer, file/image attach, slash commands</td><td>PDF extract, token estimate footer</td></tr>\n333\t          </tbody>\n334\t        </table>\n335\t\n336\t        <h3>Non-Functional Requirements (Technical)</h3>\n337\t        <div class=\"grid-2\">\n338\t          <div class=\"card\">\n339\t            <h4>Latency</h4>\n340\t            <p>TTFT &lt; 500ms perceived; optimistic send &lt; 50ms; stream visible within 1 frame batch (~16ms)</p>\n341\t          </div>\n342\t          <div class=\"card\">\n343\t            <h4>Scale</h4>\n344\t            <p>500+ messages virtualized; 10k sidebar rows; concurrent tabs same conversation</p>\n345\t          </div>\n346\t          <div class=\"card\">\n347\t            <h4>Reliability</h4>\n348\t            <p>Partial stream preserved on disconnect; offline queue; idempotent confirms</p>\n349\t          </div>\n350\t          <div class=\"card\">\n351\t            <h4>Security</h4>\n352\t            <p>JWT + org scoping; upload sanitization; MCP egress allowlist; sandbox artifacts</p>\n353\t          </div>\n354\t        </div>\n355\t\n356\t        <h3>Metrics · Constraints · Assumptions</h3>\n357\t        <ul>\n358\t          <li><strong>Metrics:</strong> TTFT, tokens/sec render rate, stream recovery success %, tool confirm dedup rate</li>\n359\t          <li><strong>Constraints:</strong> Context window cap (~200k tokens); mobile Safari SSE limits; no raw MCP tokens in browser</li>\n360\t          <li><strong>Assumptions:</strong> BFF owns provider keys; single-region v1; authenticated users; Anthropic-primary with adapter layer</li>\n361\t        </ul>\n362\t\n363\t        <h3>Scoping questions to ask</h3>\n364\t        <ul class=\"checklist\" data-store=\"req\">\n365\t          <li><label><input type=\"checkbox\"> Multi-user / org tenancy or personal-only?</label></li>\n366\t          <li><label><input type=\"checkbox\"> Tool use / MCP in scope?</label></li>\n367\t          <li><label><input type=\"checkbox\"> Artifacts / code preview required?</label></li>\n368\t          <li><label><input type=\"checkbox\"> Offline support needed?</label></li>\n369\t          <li><label><input type=\"checkbox\"> Multi-tab sync same conversation?</label></li>\n370\t        </ul>\n371\t        <div class=\"section-links\">\n372\t          <a href=\"answers-html/10-killer-questions.html\">§10 Killer scenarios</a>\n373\t        </div>\n374\t      </div>\n375\t    </article>\n376\t\n377\t    <!-- ② ARCHITECTURE -->\n378\t    <article class=\"section-block\" id=\"architecture\" data-section=\"architecture\">\n379\t      <div class=\"section-head\">\n380\t        <div class=\"section-num arch\">②</div>\n381\t        <div>\n382\t          <h2>Architecture</h2>\n383\t          <div class=\"section-meta\">10–15 min · Framework · Component tree · State management</div>\n384\t        </div>\n385\t        <span class=\"chevron\">▼</span>\n386\t      </div>\n387\t      <div class=\"section-body\">\n388\t        <h3>Framework + High-Level Architecture</h3>\n389\t        <p><strong>Stack:</strong> React 18 + TypeScript · Zustand or Redux for conversation store · React Query for server cache · Vite build · SSE via fetch + ReadableStream (fallback EventSource)</p>\n390\t\n391\t        <div class=\"mermaid-wrap\">\n392\t          <pre class=\"mermaid\">flowchart TB\n393\t  subgraph UI[\"UI Layer\"]\n394\t    SB[Sidebar]\n395\t    ML[Virtualized Message List]\n396\t    CP[Composer]\n397\t    TP[Tool Pills]\n398\t  end\n399\t  subgraph Client[\"Client State\"]\n400\t    CS[Conversation Store]\n401\t    SP[Streaming Pipeline]\n402\t    BA[Branch Assembler]\n403\t    OL[Optimistic Layer]\n404\t  end\n405\t  subgraph Transport[\"Transport\"]\n406\t    REST[REST control]\n407\t    SSE[SSE tokens]\n408\t  end\n409\t  subgraph BFF[\"BFF / API\"]\n410\t    GW[Gateway]\n411\t    CV[Conversation Svc]\n412\t    ST[Stream Gateway]\n413\t    OR[Agent Orchestrator]\n414\t  end\n415\t  subgraph Data[\"Persistence\"]\n416\t    PG[(Postgres graph)]\n417\t    RD[(Redis)]\n418\t    IDB[(IndexedDB)]\n419\t  end\n420\t  CP --> OL --> CS\n421\t  ML --> SP\n422\t  CS --> BA\n423\t  OL --> REST\n424\t  SP --> SSE\n425\t  REST --> GW --> CV --> PG\n426\t  SSE --> ST --> OR\n427\t  CS --> IDB\n428\t  ST --> RD</pre>\n429\t        </div>\n430\t\n431\t        <h3>Component / Module Tree</h3>\n432\t        <div class=\"mermaid-wrap\">\n433\t          <pre class=\"mermaid\">flowchart TB\n434\t  AppShell[\"AppShell\"]\n435\t\n436\t  AppShell --> Sidebar\n437\t  AppShell --> ChatView\n438\t  AppShell --> ArtifactPanel\n439\t  AppShell --> GlobalProviders\n440\t\n441\t  subgraph Sidebar[\"Sidebar\"]\n442\t    direction TB\n443\t    CLV[\"ConversationListVirtualized\"]\n444\t    SB[\"SearchBar\"]\n445\t    OS[\"OrgSwitcher\"]\n446\t  end\n447\t\n448\t  subgraph ChatView[\"ChatView\"]\n449\t    direction TB\n450\t    MLV[\"MessageListVirtualized\"]\n451\t    COMP[\"Composer\"]\n452\t    SSB[\"StreamStatusBar\"]\n453\t    MLV --> UMB[\"UserMessageBubble\"]\n454\t    MLV --> AMB[\"AssistantMessageBubble\"]\n455\t    MLV --> SAC[\"ScrollAnchorController\"]\n456\t    AMB --> SM[\"StreamingMarkdown\"]\n457\t    AMB --> TPG[\"ToolPillGroup\"]\n458\t    AMB --> TI[\"TypingIndicator\"]\n459\t    TPG --> CC[\"ConfirmCard\"]\n460\t    TPG --> ED[\"EgressDisclosure\"]\n461\t    COMP --> TAG[\"TextareaAutoGrow\"]\n462\t    COMP --> AS[\"AttachmentStrip\"]\n463\t    COMP --> SLM[\"SlashMenu\"]\n464\t    COMP --> TF[\"TokenFooter\"]\n465\t  end\n466\t\n467\t  subgraph ArtifactPanel[\"ArtifactPanel (optional)\"]\n468\t    direction TB\n469\t    EDITOR[\"Code Editor\"]\n470\t    SBOX[\"SandboxIframe\"]\n471\t  end\n472\t\n473\t  subgraph GlobalProviders[\"GlobalProviders\"]\n474\t    direction TB\n475\t    AUTH[\"Auth\"]\n476\t    QC[\"QueryClient\"]\n477\t    TH[\"Theme\"]\n478\t    BC[\"BroadcastChannel\"]\n479\t  end</pre>\n480\t        </div>\n481\t\n482\t        <h3>State Management — Where State Lives</h3>\n483\t        <div class=\"state-ladder\">\n484\t          <div class=\"state-step\"><strong>Ephemeral (JS)</strong>Token buffer, rAF flush queue, parse cache, optimistic temp IDs</div>\n485\t          <div class=\"state-step\"><strong>Memory</strong>Active conversation graph view, height cache, sidebar prefetch (~20 threads)</div>\n486\t          <div class=\"state-step\"><strong>Disk (IDB)</strong>Message pages, offline outbox, upload resume, partial stream on drop</div>\n487\t          <div class=\"state-step\"><strong>localStorage</strong>Composer drafts, UI prefs, study progress</div>\n488\t          <div class=\"state-step\"><strong>Server (SoT)</strong>Message tree, active_leaf, generation checkpoints, tool ledger</div>\n489\t        </div>\n490\t        <div class=\"callout\"><strong>Rule:</strong> Server owns committed history + model context. Client owns interaction latency (draft, stream buffer, scroll). Never treat React <code>messages[]</code> as source of truth — it's a <em>view</em> over the graph.</div>\n491\t\n492\t        <div class=\"section-links\">\n493\t          <a href=\"answers-html/02-conversation-state-management.html\">§02 State</a>\n494\t          <a href=\"answers-html/01-streaming-real-time-rendering.html\">§01 Streaming</a>\n495\t          <a href=\"answers-html/05-performance-scalability.html\">§05 Performance</a>\n496\t          <a href=\"claude-frontend-architecture.html\">Interactive map</a>\n497\t        </div>\n498\t      </div>\n499\t    </article>\n500\t\n501\t    <!-- ③ DATA MODEL -->\n502\t    <article class=\"section-block\" id=\"data-model\" data-section=\"data-model\">\n503\t      <div class=\"section-head\">\n504\t        <div class=\"section-num data\">③</div>\n505\t        <div>\n506\t          <h2>Data Model</h2>\n507\t          <div class=\"section-meta\">~5 min · Entities · Relationships · IR blocks</div>\n508\t        </div>\n509\t        <span class=\"chevron\">▼</span>\n510\t      </div>\n511\t      <div class=\"section-body\">\n512\t        <p>Store as a <strong>message graph</strong>, not a flat array. Persist <strong>IR</strong> (Internal Representation) — provider-neutral content blocks — compile to Anthropic/OpenAI only at the adapter boundary.</p>\n513\t\n514\t        <div class=\"entity\"><span class=\"kw\">Conversation</span> {\n515\t  id, org_id?, owner_user_id,\n516\t  title, active_leaf_id,\n517\t  conversation_revision,   <span style=\"color:var(--muted)\">// optimistic concurrency</span>\n518\t  created_at, updated_at\n519\t}\n520\t\n521\t<span class=\"kw\">MessageNode</span> {\n522\t  id, conversation_id, parent_id?,   <span style=\"color:var(--muted)\">// tree edge</span>\n523\t  role: system | user | assistant,\n524\t  content: ContentBlock[],             <span style=\"color:var(--muted)\">// IR</span>\n525\t  status: final | streaming | superseded | cancelled,\n526\t  model_id?, branch_label?,\n527\t  created_at\n528\t}\n529\t\n530\t<span class=\"kw\">ContentBlock</span> = TextBlock | ImageBlock | ToolCallBlock | ToolResultBlock | ThinkingBlock\n531\t\n532\t<span class=\"kw\">ToolExecution</span> {\n533\t  tool_use_id, conversation_id, idempotency_key,\n534\t  status: pending | awaiting_approval | running | completed | failed,\n535\t  approved_by?, audit_hash\n536\t}\n537\t\n538\t<span class=\"kw\">Generation</span> {\n539\t  id, message_id, stream_cursor, last_event_id,\n540\t  status: running | interrupted | complete\n541\t}</div>\n542\t\n543\t        <h3>Key relationships</h3>\n544\t        <table>\n545\t          <thead><tr><th>Operation</th><th>Graph behavior</th></tr></thead>\n546\t          <tbody>\n547\t            <tr><td>Send message</td><td>New user node; child of current active leaf</td></tr>\n548\t            <tr><td>Stream reply</td><td>New assistant node; status streaming → final</td></tr>\n549\t            <tr><td>Edit message N</td><td><strong>Sibling fork</strong> under parent(N), not in-place overwrite</td></tr>\n550\t            <tr><td>Retry assistant</td><td>New assistant sibling under same user parent</td></tr>\n551\t            <tr><td>Tool result</td><td>Blocks appended to next user turn (Anthropic shape in IR)</td></tr>\n552\t          </tbody>\n553\t        </table>\n554\t\n555\t        <div class=\"section-links\">\n556\t          <a href=\"answers-html/02-conversation-state-management.html\">§02 Branching</a>\n557\t          <a href=\"answers-html/09-api-design-provider-abstraction.html\">§09 IR</a>\n558\t        </div>\n559\t      </div>\n560\t    </article>\n561\t\n562\t    <!-- ④ API DESIGN -->\n563\t    <article class=\"section-block\" id=\"api-design\" data-section=\"api-design\">\n564\t      <div class=\"section-head\">\n565\t        <div class=\"section-num api\">④</div>\n566\t        <div>\n567\t          <h2>API Design / BFF</h2>\n568\t          <div class=\"section-meta\">~10 min · Protocols · Endpoints · Real-time · Edge</div>\n569\t        </div>\n570\t        <span class=\"chevron\">▼</span>\n571\t      </div>\n572\t      <div class=\"section-body\">\n573\t        <h3>Protocol choice</h3>\n574\t        <table>\n575\t          <thead><tr><th>Pattern</th><th>Use in Claude chat</th><th>Why</th></tr></thead>\n576\t          <tbody>\n577\t            <tr><td><strong>SSE</strong></td><td>LLM token stream (default)</td><td>Server→client push; HTTP auth; Last-Event-ID reconnect; AbortController cancel</td></tr>\n578\t            <tr><td><strong>REST</strong></td><td>Send, edit, cancel, history pages, tool execute, uploads</td><td>Idempotency-Key; standard caching; clear error taxonomy</td></tr>\n579\t            <tr><td><strong>WebSocket</strong></td><td>Optional: multi-tab sync, presence, async job push</td><td>Full-duplex when client→server churn is high</td></tr>\n580\t            <tr><td>Long polling</td><td>Avoid for tokens</td><td>Higher latency than SSE for streaming text</td></tr>\n581\t            <tr><td>gRPC</td><td>Internal service-to-service</td><td>Not browser-facing; BFF translates to REST/SSE</td></tr>\n582\t          </tbody>\n583\t        </table>\n584\t\n585\t        <h3>Core endpoints (BFF)</h3>\n586\t        <table>\n587\t          <thead><tr><th>Method</th><th>Endpoint</th><th>Purpose</th></tr></thead>\n588\t          <tbody>\n589\t            <tr><td>POST</td><td><code>/conversations/:id/messages</code></td><td>Send user turn → returns stream_id / opens SSE</td></tr>\n590\t            <tr><td>POST</td><td><code>/conversations/:id/messages/:mid/edit</code></td><td>Fork branch + start regen</td></tr>\n591\t            <tr><td>POST</td><td><code>/generations/:id/cancel</code></td><td>Stop inference + finalize partial</td></tr>\n592\t            <tr><td>GET</td><td><code>/generations/:id/stream?after=cursor</code></td><td>Resume interrupted stream</td></tr>\n593\t            <tr><td>GET</td><td><code>/conversations/:id/messages?before=&limit=</code></td><td>Lazy-load history (cursor pagination)</td></tr>\n594\t            <tr><td>POST</td><td><code>/conversations/:id/tools/execute</code></td><td>HITL confirm; Idempotency-Key header</td></tr>\n595\t            <tr><td>POST</td><td><code>/uploads/presign</code></td><td>Multipart attach → quarantine → extract</td></tr>\n596\t            <tr><td>GET</td><td><code>/conversations?cursor=&q=</code></td><td>Sidebar list + search</td></tr>\n597\t          </tbody>\n598\t        </table>\n599\t\n600\t        <h3>Streaming adapter (normalized events)</h3>\n601\t        <p>Provider wire format → <code>StreamDecoder</code> → normalized events consumed by one client reducer:</p>\n602\t        <p><code>message_start · content_delta · tool_call_delta · thinking_delta · content_block_stop · message_stop · error</code></p>\n603\t\n604\t        <h3>Network lifecycle notes</h3>\n605\t        <ul>\n606\t          <li><strong>Cancel chain:</strong> UI AbortController → close SSE → BFF cancels provider job → client finalizes partial MD</li>\n607\t          <li><strong>Drop recovery:</strong> Keep partial UI → retry with Idempotency-Key OR resume with generation cursor</li>\n608\t          <li><strong>Backoff:</strong> Exponential 1s→2s→4s (cap 30s); honor Retry-After on 429</li>\n609\t          <li><strong>Edge:</strong> CDN for static assets; API at origin; optional edge auth refresh — not for SSE body</li>\n610\t        </ul>\n611\t\n612\t        <div class=\"section-links\">\n613\t          <a href=\"answers-html/01-streaming-real-time-rendering.html\">§01 SSE</a>\n614\t          <a href=\"answers-html/07-offline-resilience-error-handling.html\">§07 Resilience</a>\n615\t          <a href=\"answers-html/09-api-design-provider-abstraction.html\">§09 Adapters</a>\n616\t        </div>\n617\t      </div>\n618\t    </article>\n619\t\n620\t    <!-- ⑤ DEEP DIVE -->\n621\t    <article class=\"section-block\" id=\"deep-dive\" data-section=\"deep-dive\">\n622\t      <div class=\"section-head\">\n623\t        <div class=\"section-num deep\">⑤</div>\n624\t        <div>\n625\t          <h2>Deep Dive</h2>\n626\t          <div class=\"section-meta\">~10 min · Pick 1–2 areas the interviewer cares about</div>\n627\t        </div>\n628\t        <span class=\"chevron\">▼</span>\n629\t      </div>\n630\t      <div class=\"section-body\">\n631\t        <p>Say: <em>“I'll go deep on Performance and Security — happy to switch if you prefer observability or testing.”</em></p>\n632\t        <div class=\"deep-tabs\" id=\"deepTabs\">\n633\t          <button type=\"button\" class=\"deep-tab active\" data-panel=\"perf\">Performance</button>\n634\t          <button type=\"button\" class=\"deep-tab\" data-panel=\"sec\">Security</button>\n635\t          <button type=\"button\" class=\"deep-tab\" data-panel=\"obs\">Observability</button>\n636\t          <button type=\"button\" class=\"deep-tab\" data-panel=\"test\">Testing</button>\n637\t          <button type=\"button\" class=\"deep-tab\" data-panel=\"a11y\">A11y + i18n</button>\n638\t        </div>\n639\t\n640\t        <div class=\"deep-panel active\" id=\"panel-perf\">\n641\t          <ul>\n642\t            <li><strong>Virtualization:</strong> react-window/virtuoso; dynamic height cache; pin streaming row outside virtualizer or as last item</li>\n643\t            <li><strong>Streaming render:</strong> rAF batch + incremental markdown blocks; defer Shiki until fence closes</li>\n644\t            <li><strong>Backpressure:</strong> pause ReadableStream read(); coalesce tokens; shed highlight under load</li>\n645\t            <li><strong>TTFT:</strong> optimistic bubble immediately; measure provider TTFB vs client paint separately</li>\n646\t            <li><strong>Sidebar 10k:</strong> metadata-only rows, cursor pagination, FTS index, IDB cache</li>\n647\t          </ul>\n648\t        </div>\n649\t        <div class=\"deep-panel\" id=\"panel-sec\">\n650\t          <ul>\n651\t            <li><strong>Auth:</strong> JWT claims → ctx; Postgres RLS belt; org_id never from client body alone</li>\n652\t            <li><strong>XSS:</strong> Never dangerouslySetInnerHTML on full stream; escape code blocks; sanitize artifact sandbox</li>\n653\t            <li><strong>MCP trust:</strong> Egress allowlist; data minimization; audit log with input/output hashes</li>\n654\t            <li><strong>Uploads:</strong> Quarantine bucket; content firewall; never inject uploads into system role</li>\n655\t            <li><strong>Artifacts:</strong> iframe sandbox allow-scripts only; strict CSP; postMessage origin check</li>\n656\t            <li><strong>Idempotency:</strong> (user_id, key) unique — double confirm in 200ms → one booking</li>\n657\t          </ul>\n658\t        </div>\n659\t        <div class=\"deep-panel\" id=\"panel-obs\">\n660\t          <ul>\n661\t            <li>Client: tokens_received − tokens_rendered, frame p95, parse ms, stream recovery rate</li>\n662\t            <li>Server: TTFT, generation duration, tool latency, 429/529 rates, checkpoint lag</li>\n663\t            <li>Trace: request_id / generation_id across UI → BFF → provider</li>\n664\t            <li>Product analytics: branch edits, tool confirms, stream interrupts (not user abort)</li>\n665\t          </ul>\n666\t        </div>\n667\t        <div class=\"deep-panel\" id=\"panel-test\">\n668\t          <ul>\n669\t            <li>Unit: branch assembler, IR compile, markdown block parser, idempotency key derivation</li>\n670\t            <li>Integration: SSE reducer with fixture event streams; tool confirm dedup</li>\n671\t            <li>E2E: send → stream → stop; edit mid-thread → new branch; offline outbox drain</li>\n672\t            <li>Load: virtualizer with 500 synthetic messages; stream at 100 chunks/sec</li>\n673\t          </ul>\n674\t        </div>\n675\t        <div class=\"deep-panel\" id=\"panel-a11y\">\n676\t          <ul>\n677\t            <li><code>aria-live=\"polite\"</code> on message region; <code>aria-busy</code> until first token</li>\n678\t            <li>Stop button keyboard accessible; focus trap in confirm modal</li>\n679\t            <li>Reduced motion: disable typing dot bounce</li>\n680\t            <li>i18n: RTL composer; locale-aware dates in sidebar; CJK token estimate caveat</li>\n681\t          </ul>\n682\t        </div>\n683\t\n684\t        <h3>Interview close (30 sec)</h3>\n685\t        <div class=\"callout\">Three patterns I'd repeat: <strong>(1)</strong> server graph is source of truth with client optimism, <strong>(2)</strong> idempotency keys + stream cursors for duplicate actions and duplicate bytes, <strong>(3)</strong> bounded failure domains — sandbox kill, stream checkpoint, auth pause — never freeze the whole app.</div>\n686\t\n687\t        <div class=\"section-links\">\n688\t          <a href=\"answers-html/10-killer-questions.html\">§10 Killer Qs</a>\n689\t          <a href=\"answers-html/06-auth-security-multitenancy.html\">§06 Auth</a>\n690\t          <a href=\"answers-html/04-artifacts-sandboxed-rendering.html\">§04 Artifacts</a>\n691\t        </div>\n692\t      </div>\n693\t    </article>\n694\t\n695\t    <footer>\n696\t      <a href=\"answers-html/index.html\">Section answers</a> ·\n697\t      <a href=\"claude-frontend-architecture.html\">Architecture map</a> ·\n698\t      <a href=\"Claude-design-doc.md\">Question bank</a>\n699\t    </footer>\n700\t  </div>\n701\t\n702\t  <script type=\"module\">\n703\t    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';\n704\t    const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n705\t    mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'neutral', securityLevel: 'loose', flowchart: { useMaxWidth: true } });\n706\t\n707\t    document.querySelectorAll('.section-block .section-head').forEach(head => {\n708\t      head.addEventListener('click', () => head.parentElement.classList.toggle('collapsed'));\n709\t    });\n710\t\n711\t    document.querySelectorAll('#deepTabs .deep-tab').forEach(tab => {\n712\t      tab.addEventListener('click', () => {\n713\t        document.querySelectorAll('#deepTabs .deep-tab').forEach(t => t.classList.remove('active'));\n714\t        document.querySelectorAll('.deep-panel').forEach(p => p.classList.remove('active'));\n715\t        tab.classList.add('active');\n716\t        document.getElementById('panel-' + tab.dataset.panel).classList.add('active');\n717\t      });\n718\t    });\n719\t\n720\t    const navLinks = document.querySelectorAll('#topNav a[data-section]');\n721\t    const sections = document.querySelectorAll('[data-section]');\n722\t    const observer = new IntersectionObserver(entries => {\n723\t      entries.forEach(entry => {\n724\t        if (entry.isIntersecting) {\n725\t          navLinks.forEach(a => a.classList.toggle('active', a.dataset.section === entry.target.dataset.section));\n726\t        }\n727\t      });\n728\t    }, { rootMargin: '-40% 0px -50% 0px' });\n729\t    sections.forEach(s => observer.observe(s));\n730\t\n731\t    document.querySelectorAll('ul.checklist[data-store]').forEach(list => {\n732\t      const key = 'sd-interview-' + list.dataset.store;\n733\t      list.querySelectorAll('input').forEach((cb, i) => {\n734\t        const saved = JSON.parse(localStorage.getItem(key) || '[]');\n735\t        cb.checked = saved.includes(i);\n736\t        cb.addEventListener('change', () => {\n737\t          const checked = [...list.querySelectorAll('input')].map((c, j) => c.checked ? j : null).filter(x => x !== null);\n738\t          localStorage.setItem(key, JSON.stringify(checked));\n739\t        });\n740\t      });\n741\t    });\n742\t\n743\t    await mermaid.run({ querySelector: '.mermaid' });\n744\t  </script>\n745\t</body>\n746\t</html>\n747\t"}]},"parent_tool_use_id":null,"session_id":"f24c5cdf-0369-4a81-99d5-ba16ab3babb1","uuid":"bdd592ce-1772-4be9-8d69-996dc9cec620","timestamp":"2026-06-20T19:52:13.718Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sarthakagarwal/Desktop/projects/prep/system-design/claude/claude-system-design-interview.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Claude Frontend System Design — Interview Template</title>\n  <meta name=\"description\" content=\"Full Claude-style AI chat frontend system design in interview format: Requirements → Architecture → Data Model → API/BFF → Deep Dive.\">\n  <style>\n    :root {\n      --bg: #f4f2ef;\n      --surface: #fff;\n      --surface2: #faf8f5;\n      --text: #1a1d26;\n      --muted: #5c6370;\n      --border: #e2e6ed;\n      --accent: #b85c28;\n      --accent-soft: rgba(184, 92, 40, 0.1);\n      --req: #2e86ab;\n      --arch: #6a994e;\n      --data: #bc4749;\n      --api: #7b5ea7;\n      --deep: #495057;\n      --shadow: 0 2px 12px rgba(0,0,0,.06);\n      --nav-h: 3.25rem;\n    }\n    @media (prefers-color-scheme: dark) {\n      :root {\n        --bg: #0f1219;\n        --surface: #171c28;\n        --surface2: #1e2536;\n        --text: #e8ecf4;\n        --muted: #8b95a8;\n        --border: #2d3548;\n        --accent: #c97840;\n        --accent-soft: rgba(201, 120, 64, 0.15);\n        --shadow: 0 4px 20px rgba(0,0,0,.3);\n      }\n    }\n    *, *::before, *::after { box-sizing: border-box; }\n    html { scroll-behavior: smooth; scroll-padding-top: calc(var(--nav-h) + 1rem); }\n    body {\n      margin: 0;\n      font-family: \"Segoe UI\", system-ui, -apple-system, sans-serif;\n      background: var(--bg);\n      color: var(--text);\n      line-height: 1.6;\n    }\n    .top-nav {\n      position: sticky;\n      top: 0;\n      z-index: 100;\n      height: var(--nav-h);\n      display: flex;\n      align-items: center;\n      gap: 0.5rem;\n      padding: 0 1rem;\n      background: rgba(var(--surface-rgb, 255,255,255), .92);\n      backdrop-filter: blur(10px);\n      border-bottom: 1px solid var(--border);\n      overflow-x: auto;\n    }\n    @media (prefers-color-scheme: dark) {\n      .top-nav { background: rgba(23, 28, 40, .94); }\n    }\n    .top-nav a {\n      font-size: 0.8125rem;\n      white-space: nowrap;\n      padding: 0.35rem 0.65rem;\n      border-radius: 999px;\n      text-decoration: none;\n      color: var(--muted);\n      border: 1px solid transparent;\n    }\n    .top-nav a:hover { color: var(--text); border-color: var(--border); }\n    .top-nav a.active { background: var(--accent-soft); color: var(--accent); border-color: var(--accent); font-weight: 600; }\n    .nav-title { font-weight: 700; font-size: 0.875rem; margin-right: 0.5rem; white-space: nowrap; }\n    .nav-links { margin-left: auto; display: flex; gap: 0.5rem; font-size: 0.8125rem; }\n    .nav-links a { color: var(--accent); text-decoration: none; white-space: nowrap; }\n    .wrap { max-width: 920px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }\n    .hero { margin-bottom: 2rem; }\n    .hero h1 { font-size: 1.75rem; margin: 0 0 0.5rem; letter-spacing: -0.02em; }\n    .hero p { color: var(--muted); margin: 0; max-width: 640px; }\n    .timer-bar {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem;\n      margin: 1.25rem 0 0;\n    }\n    .timer-chip {\n      font-size: 0.75rem;\n      padding: 0.3rem 0.65rem;\n      border-radius: 6px;\n      border: 1px solid var(--border);\n      background: var(--surface);\n    }\n    .timer-chip strong { color: var(--accent); }\n\n    .section-block {\n      margin-bottom: 2.5rem;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      box-shadow: var(--shadow);\n      overflow: hidden;\n    }\n    .section-head {\n      display: flex;\n      align-items: flex-start;\n      gap: 1rem;\n      padding: 1.25rem 1.5rem;\n      border-bottom: 1px solid var(--border);\n      cursor: pointer;\n      user-select: none;\n    }\n    .section-head:hover { background: var(--surface2); }\n    .section-num {\n      flex-shrink: 0;\n      width: 2.5rem;\n      height: 2.5rem;\n      border-radius: 8px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: 800;\n      font-size: 0.875rem;\n      color: #fff;\n    }\n    .section-num.req { background: var(--req); }\n    .section-num.arch { background: var(--arch); }\n    .section-num.data { background: var(--data); }\n    .section-num.api { background: var(--api); }\n    .section-num.deep { background: var(--deep); }\n    .section-head h2 { margin: 0; font-size: 1.2rem; }\n    .section-meta { font-size: 0.8125rem; color: var(--muted); margin-top: 0.15rem; }\n    .chevron { margin-left: auto; color: var(--muted); transition: transform 0.2s; }\n    .section-block.collapsed .chevron { transform: rotate(-90deg); }\n    .section-block.collapsed .section-body { display: none; }\n    .section-body { padding: 1.25rem 1.5rem 1.5rem; }\n\n    h3 {\n      font-size: 0.9375rem;\n      margin: 1.25rem 0 0.5rem;\n      color: var(--accent);\n    }\n    h3:first-child { margin-top: 0; }\n    p, li { font-size: 0.9375rem; }\n    ul { padding-left: 1.25rem; }\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 0.875rem;\n      margin: 0.75rem 0;\n    }\n    th, td {\n      border: 1px solid var(--border);\n      padding: 0.55rem 0.75rem;\n      text-align: left;\n      vertical-align: top;\n    }\n    th { background: var(--surface2); font-weight: 600; }\n    .callout {\n      padding: 0.85rem 1rem;\n      border-left: 3px solid var(--accent);\n      background: var(--accent-soft);\n      border-radius: 0 8px 8px 0;\n      font-size: 0.875rem;\n      margin: 1rem 0;\n    }\n    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }\n    @media (max-width: 700px) { .grid-2 { grid-template-columns: 1fr; } }\n\n    .card {\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 1rem;\n      background: var(--surface2);\n    }\n    .card h4 { margin: 0 0 0.35rem; font-size: 0.875rem; }\n    .card p { margin: 0; font-size: 0.8125rem; color: var(--muted); }\n\n    .entity {\n      font-family: ui-monospace, Menlo, Consolas, monospace;\n      font-size: 0.8125rem;\n      background: var(--bg);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 1rem;\n      margin: 0.75rem 0;\n      white-space: pre-wrap;\n      line-height: 1.5;\n    }\n    .entity .kw { color: var(--accent); font-weight: 600; }\n\n    .component-tree {\n      font-family: ui-monospace, Menlo, Consolas, monospace;\n      font-size: 0.8125rem;\n      background: var(--bg);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 1rem 1.25rem;\n      line-height: 1.55;\n    }\n    .component-tree .hl { color: var(--accent); font-weight: 600; }\n\n    .state-ladder {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem;\n      margin: 0.75rem 0;\n    }\n    .state-step {\n      flex: 1;\n      min-width: 120px;\n      padding: 0.65rem;\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      text-align: center;\n      font-size: 0.8125rem;\n    }\n    .state-step strong { display: block; font-size: 0.75rem; color: var(--accent); margin-bottom: 0.25rem; }\n\n    .deep-tabs {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.35rem;\n      margin-bottom: 1rem;\n    }\n    .deep-tab {\n      font: inherit;\n      font-size: 0.8125rem;\n      padding: 0.4rem 0.75rem;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      background: var(--surface2);\n      color: var(--muted);\n      cursor: pointer;\n    }\n    .deep-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }\n    .deep-panel { display: none; }\n    .deep-panel.active { display: block; }\n\n    .mermaid-wrap {\n      margin: 1rem 0;\n      padding: 1rem;\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      overflow-x: auto;\n    }\n    .mermaid-wrap pre.mermaid:not([data-mermaid-rendered]) {\n      background: transparent;\n      color: var(--muted);\n      font-size: 0.75rem;\n      margin: 0;\n    }\n\n    .checklist { list-style: none; padding: 0; margin: 0; }\n    .checklist li {\n      display: flex;\n      align-items: flex-start;\n      gap: 0.5rem;\n      padding: 0.4rem 0;\n      border-bottom: 1px dashed var(--border);\n      font-size: 0.875rem;\n    }\n    .checklist input { margin-top: 0.25rem; accent-color: var(--accent); }\n    .section-links { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 1rem; }\n    .section-links a {\n      font-size: 0.75rem;\n      padding: 0.25rem 0.5rem;\n      border-radius: 4px;\n      background: var(--accent-soft);\n      color: var(--accent);\n      text-decoration: none;\n    }\n    footer {\n      text-align: center;\n      font-size: 0.8125rem;\n      color: var(--muted);\n      padding: 2rem 0;\n    }\n    footer a { color: var(--accent); }\n  </style>\n</head>\n<body>\n  <nav class=\"top-nav\" id=\"topNav\">\n    <span class=\"nav-title\">Claude SD — Template</span>\n    <a href=\"#requirements\" data-section=\"requirements\">① Requirements</a>\n    <a href=\"#architecture\" data-section=\"architecture\">② Architecture</a>\n    <a href=\"#data-model\" data-section=\"data-model\">③ Data Model</a>\n    <a href=\"#api-design\" data-section=\"api-design\">④ API / BFF</a>\n    <a href=\"#deep-dive\" data-section=\"deep-dive\">⑤ Deep Dive</a>\n    <div class=\"nav-links\">\n      <a href=\"claude-frontend-architecture.html\">Architecture map</a>\n      <a href=\"answers-html/index.html\">All answers</a>\n    </div>\n  </nav>\n\n  <div class=\"wrap\">\n    <header class=\"hero\">\n      <h1>Design a Claude-Style AI Chat Frontend</h1>\n      <p>Complete system design answer in interview format (~45–60 min). Use this as your master script; drill into section pages for question-level depth.</p>\n      <div class=\"timer-bar\">\n        <span class=\"timer-chip\"><strong>5–10m</strong> Requirements</span>\n        <span class=\"timer-chip\"><strong>10–15m</strong> Architecture</span>\n        <span class=\"timer-chip\"><strong>5m</strong> Data Model</span>\n        <span class=\"timer-chip\"><strong>10m</strong> API / BFF</span>\n        <span class=\"timer-chip\"><strong>10m</strong> Deep Dive</span>\n      </div>\n    </header>\n\n    <!-- ① REQUIREMENTS -->\n    <article class=\"section-block\" id=\"requirements\" data-section=\"requirements\">\n      <div class=\"section-head\">\n        <div class=\"section-num req\">①</div>\n        <div>\n          <h2>Requirements</h2>\n          <div class=\"section-meta\">5–10 min · Clarify with interviewer · Scope before designing</div>\n        </div>\n        <span class=\"chevron\">▼</span>\n      </div>\n      <div class=\"section-body\">\n        <div class=\"callout\"><strong>Opening line:</strong> “Before I draw boxes, let me confirm functional scope, non-functional targets, and what we’re explicitly not building in v1.”</div>\n\n        <h3>Functional Requirements (Business)</h3>\n        <table>\n          <thead><tr><th>Area</th><th>Must have (v1)</th><th>Nice to have</th></tr></thead>\n          <tbody>\n            <tr><td>Chat</td><td>Multi-turn conversation, streaming assistant replies, stop generation, markdown + code blocks</td><td>Branch switcher, edit-any-message, voice input</td></tr>\n            <tr><td>History</td><td>Sidebar conversation list, open/switch threads, persist across refresh</td><td>Search 10k+ convos, share public link</td></tr>\n            <tr><td>Tools</td><td>Tool call pills (loading/success/error), confirm for destructive MCP actions</td><td>Multi-step agent chains, activity audit drawer</td></tr>\n            <tr><td>Artifacts</td><td>— (scope out unless asked)</td><td>Sandboxed HTML/React preview, version timeline</td></tr>\n            <tr><td>Input</td><td>Auto-grow composer, file/image attach, slash commands</td><td>PDF extract, token estimate footer</td></tr>\n          </tbody>\n        </table>\n\n        <h3>Non-Functional Requirements (Technical)</h3>\n        <div class=\"grid-2\">\n          <div class=\"card\">\n            <h4>Latency</h4>\n            <p>TTFT &lt; 500ms perceived; optimistic send &lt; 50ms; stream visible within 1 frame batch (~16ms)</p>\n          </div>\n          <div class=\"card\">\n            <h4>Scale</h4>\n            <p>500+ messages virtualized; 10k sidebar rows; concurrent tabs same conversation</p>\n          </div>\n          <div class=\"card\">\n            <h4>Reliability</h4>\n            <p>Partial stream preserved on disconnect; offline queue; idempotent confirms</p>\n          </div>\n          <div class=\"card\">\n            <h4>Security</h4>\n            <p>JWT + org scoping; upload sanitization; MCP egress allowlist; sandbox artifacts</p>\n          </div>\n        </div>\n\n        <h3>Metrics · Constraints · Assumptions</h3>\n        <ul>\n          <li><strong>Metrics:</strong> TTFT, tokens/sec render rate, stream recovery success %, tool confirm dedup rate</li>\n          <li><strong>Constraints:</strong> Context window cap (~200k tokens); mobile Safari SSE limits; no raw MCP tokens in browser</li>\n          <li><strong>Assumptions:</strong> BFF owns provider keys; single-region v1; authenticated users; Anthropic-primary with adapter layer</li>\n        </ul>\n\n        <h3>Scoping questions to ask</h3>\n        <ul class=\"checklist\" data-store=\"req\">\n          <li><label><input type=\"checkbox\"> Multi-user / org tenancy or personal-only?</label></li>\n          <li><label><input type=\"checkbox\"> Tool use / MCP in scope?</label></li>\n          <li><label><input type=\"checkbox\"> Artifacts / code preview required?</label></li>\n          <li><label><input type=\"checkbox\"> Offline support needed?</label></li>\n          <li><label><input type=\"checkbox\"> Multi-tab sync same conversation?</label></li>\n        </ul>\n        <div class=\"section-links\">\n          <a href=\"answers-html/10-killer-questions.html\">§10 Killer scenarios</a>\n        </div>\n      </div>\n    </article>\n\n    <!-- ② ARCHITECTURE -->\n    <article class=\"section-block\" id=\"architecture\" data-section=\"architecture\">\n      <div class=\"section-head\">\n        <div class=\"section-num arch\">②</div>\n        <div>\n          <h2>Architecture</h2>\n          <div class=\"section-meta\">10–15 min · Framework · Component tree · State management</div>\n        </div>\n        <span class=\"chevron\">▼</span>\n      </div>\n      <div class=\"section-body\">\n        <h3>Framework + High-Level Architecture</h3>\n        <p><strong>Stack:</strong> React 18 + TypeScript · Zustand or Redux for conversation store · React Query for server cache · Vite build · SSE via fetch + ReadableStream (fallback EventSource)</p>\n\n        <div class=\"mermaid-wrap\">\n          <pre class=\"mermaid\">flowchart TB\n  subgraph UI[\"UI Layer\"]\n    SB[Sidebar]\n    ML[Virtualized Message List]\n    CP[Composer]\n    TP[Tool Pills]\n  end\n  subgraph Client[\"Client State\"]\n    CS[Conversation Store]\n    SP[Streaming Pipeline]\n    BA[Branch Assembler]\n    OL[Optimistic Layer]\n  end\n  subgraph Transport[\"Transport\"]\n    REST[REST control]\n    SSE[SSE tokens]\n  end\n  subgraph BFF[\"BFF / API\"]\n    GW[Gateway]\n    CV[Conversation Svc]\n    ST[Stream Gateway]\n    OR[Agent Orchestrator]\n  end\n  subgraph Data[\"Persistence\"]\n    PG[(Postgres graph)]\n    RD[(Redis)]\n    IDB[(IndexedDB)]\n  end\n  CP --> OL --> CS\n  ML --> SP\n  CS --> BA\n  OL --> REST\n  SP --> SSE\n  REST --> GW --> CV --> PG\n  SSE --> ST --> OR\n  CS --> IDB\n  ST --> RD</pre>\n        </div>\n\n        <h3>Component / Module Tree</h3>\n        <div class=\"mermaid-wrap\">\n          <pre class=\"mermaid\">flowchart TB\n  AppShell[\"AppShell\"]\n\n  AppShell --> Sidebar\n  AppShell --> ChatView\n  AppShell --> ArtifactPanel\n  AppShell --> GlobalProviders\n\n  subgraph Sidebar[\"Sidebar\"]\n    direction TB\n    CLV[\"ConversationListVirtualized\"]\n    SB[\"SearchBar\"]\n    OS[\"OrgSwitcher\"]\n  end\n\n  subgraph ChatView[\"ChatView\"]\n    direction TB\n    MLV[\"MessageListVirtualized\"]\n    COMP[\"Composer\"]\n    SSB[\"StreamStatusBar\"]\n    MLV --> UMB[\"UserMessageBubble\"]\n    MLV --> AMB[\"AssistantMessageBubble\"]\n    MLV --> SAC[\"ScrollAnchorController\"]\n    AMB --> SM[\"StreamingMarkdown\"]\n    AMB --> TPG[\"ToolPillGroup\"]\n    AMB --> TI[\"TypingIndicator\"]\n    TPG --> CC[\"ConfirmCard\"]\n    TPG --> ED[\"EgressDisclosure\"]\n    COMP --> TAG[\"TextareaAutoGrow\"]\n    COMP --> AS[\"AttachmentStrip\"]\n    COMP --> SLM[\"SlashMenu\"]\n    COMP --> TF[\"TokenFooter\"]\n  end\n\n  subgraph ArtifactPanel[\"ArtifactPanel (optional)\"]\n    direction TB\n    EDITOR[\"Code Editor\"]\n    SBOX[\"SandboxIframe\"]\n  end\n\n  subgraph GlobalProviders[\"GlobalProviders\"]\n    direction TB\n    AUTH[\"Auth\"]\n    QC[\"QueryClient\"]\n    TH[\"Theme\"]\n    BC[\"BroadcastChannel\"]\n  end</pre>\n        </div>\n\n        <h3>State Management — Where State Lives</h3>\n        <div class=\"state-ladder\">\n          <div class=\"state-step\"><strong>Ephemeral (JS)</strong>Token buffer, rAF flush queue, parse cache, optimistic temp IDs</div>\n          <div class=\"state-step\"><strong>Memory</strong>Active conversation graph view, height cache, sidebar prefetch (~20 threads)</div>\n          <div class=\"state-step\"><strong>Disk (IDB)</strong>Message pages, offline outbox, upload resume, partial stream on drop</div>\n          <div class=\"state-step\"><strong>localStorage</strong>Composer drafts, UI prefs, study progress</div>\n          <div class=\"state-step\"><strong>Server (SoT)</strong>Message tree, active_leaf, generation checkpoints, tool ledger</div>\n        </div>\n        <div class=\"callout\"><strong>Rule:</strong> Server owns committed history + model context. Client owns interaction latency (draft, stream buffer, scroll). Never treat React <code>messages[]</code> as source of truth — it's a <em>view</em> over the graph.</div>\n\n        <div class=\"section-links\">\n          <a href=\"answers-html/02-conversation-state-management.html\">§02 State</a>\n          <a href=\"answers-html/01-streaming-real-time-rendering.html\">§01 Streaming</a>\n          <a href=\"answers-html/05-performance-scalability.html\">§05 Performance</a>\n          <a href=\"claude-frontend-architecture.html\">Interactive map</a>\n        </div>\n      </div>\n    </article>\n\n    <!-- ③ DATA MODEL -->\n    <article class=\"section-block\" id=\"data-model\" data-section=\"data-model\">\n      <div class=\"section-head\">\n        <div class=\"section-num data\">③</div>\n        <div>\n          <h2>Data Model</h2>\n          <div class=\"section-meta\">~5 min · Entities · Relationships · IR blocks</div>\n        </div>\n        <span class=\"chevron\">▼</span>\n      </div>\n      <div class=\"section-body\">\n        <p>Store as a <strong>message graph</strong>, not a flat array. Persist <strong>IR</strong> (Internal Representation) — provider-neutral content blocks — compile to Anthropic/OpenAI only at the adapter boundary.</p>\n\n        <div class=\"entity\"><span class=\"kw\">Conversation</span> {\n  id, org_id?, owner_user_id,\n  title, active_leaf_id,\n  conversation_revision,   <span style=\"color:var(--muted)\">// optimistic concurrency</span>\n  created_at, updated_at\n}\n\n<span class=\"kw\">MessageNode</span> {\n  id, conversation_id, parent_id?,   <span style=\"color:var(--muted)\">// tree edge</span>\n  role: system | user | assistant,\n  content: ContentBlock[],             <span style=\"color:var(--muted)\">// IR</span>\n  status: final | streaming | superseded | cancelled,\n  model_id?, branch_label?,\n  created_at\n}\n\n<span class=\"kw\">ContentBlock</span> = TextBlock | ImageBlock | ToolCallBlock | ToolResultBlock | ThinkingBlock\n\n<span class=\"kw\">ToolExecution</span> {\n  tool_use_id, conversation_id, idempotency_key,\n  status: pending | awaiting_approval | running | completed | failed,\n  approved_by?, audit_hash\n}\n\n<span class=\"kw\">Generation</span> {\n  id, message_id, stream_cursor, last_event_id,\n  status: running | interrupted | complete\n}</div>\n\n        <h3>Key relationships</h3>\n        <table>\n          <thead><tr><th>Operation</th><th>Graph behavior</th></tr></thead>\n          <tbody>\n            <tr><td>Send message</td><td>New user node; child of current active leaf</td></tr>\n            <tr><td>Stream reply</td><td>New assistant node; status streaming → final</td></tr>\n            <tr><td>Edit message N</td><td><strong>Sibling fork</strong> under parent(N), not in-place overwrite</td></tr>\n            <tr><td>Retry assistant</td><td>New assistant sibling under same user parent</td></tr>\n            <tr><td>Tool result</td><td>Blocks appended to next user turn (Anthropic shape in IR)</td></tr>\n          </tbody>\n        </table>\n\n        <div class=\"section-links\">\n          <a href=\"answers-html/02-conversation-state-management.html\">§02 Branching</a>\n          <a href=\"answers-html/09-api-design-provider-abstraction.html\">§09 IR</a>\n        </div>\n      </div>\n    </article>\n\n    <!-- ④ API DESIGN -->\n    <article class=\"section-block\" id=\"api-design\" data-section=\"api-design\">\n      <div class=\"section-head\">\n        <div class=\"section-num api\">④</div>\n        <div>\n          <h2>API Design / BFF</h2>\n          <div class=\"section-meta\">~10 min · Protocols · Endpoints · Real-time · Edge</div>\n        </div>\n        <span class=\"chevron\">▼</span>\n      </div>\n      <div class=\"section-body\">\n        <h3>Protocol choice</h3>\n        <table>\n          <thead><tr><th>Pattern</th><th>Use in Claude chat</th><th>Why</th></tr></thead>\n          <tbody>\n            <tr><td><strong>SSE</strong></td><td>LLM token stream (default)</td><td>Server→client push; HTTP auth; Last-Event-ID reconnect; AbortController cancel</td></tr>\n            <tr><td><strong>REST</strong></td><td>Send, edit, cancel, history pages, tool execute, uploads</td><td>Idempotency-Key; standard caching; clear error taxonomy</td></tr>\n            <tr><td><strong>WebSocket</strong></td><td>Optional: multi-tab sync, presence, async job push</td><td>Full-duplex when client→server churn is high</td></tr>\n            <tr><td>Long polling</td><td>Avoid for tokens</td><td>Higher latency than SSE for streaming text</td></tr>\n            <tr><td>gRPC</td><td>Internal service-to-service</td><td>Not browser-facing; BFF translates to REST/SSE</td></tr>\n          </tbody>\n        </table>\n\n        <h3>Core endpoints (BFF)</h3>\n        <table>\n          <thead><tr><th>Method</th><th>Endpoint</th><th>Purpose</th></tr></thead>\n          <tbody>\n            <tr><td>POST</td><td><code>/conversations/:id/messages</code></td><td>Send user turn → returns stream_id / opens SSE</td></tr>\n            <tr><td>POST</td><td><code>/conversations/:id/messages/:mid/edit</code></td><td>Fork branch + start regen</td></tr>\n            <tr><td>POST</td><td><code>/generations/:id/cancel</code></td><td>Stop inference + finalize partial</td></tr>\n            <tr><td>GET</td><td><code>/generations/:id/stream?after=cursor</code></td><td>Resume interrupted stream</td></tr>\n            <tr><td>GET</td><td><code>/conversations/:id/messages?before=&limit=</code></td><td>Lazy-load history (cursor pagination)</td></tr>\n            <tr><td>POST</td><td><code>/conversations/:id/tools/execute</code></td><td>HITL confirm; Idempotency-Key header</td></tr>\n            <tr><td>POST</td><td><code>/uploads/presign</code></td><td>Multipart attach → quarantine → extract</td></tr>\n            <tr><td>GET</td><td><code>/conversations?cursor=&q=</code></td><td>Sidebar list + search</td></tr>\n          </tbody>\n        </table>\n\n        <h3>Streaming adapter (normalized events)</h3>\n        <p>Provider wire format → <code>StreamDecoder</code> → normalized events consumed by one client reducer:</p>\n        <p><code>message_start · content_delta · tool_call_delta · thinking_delta · content_block_stop · message_stop · error</code></p>\n\n        <h3>Network lifecycle notes</h3>\n        <ul>\n          <li><strong>Cancel chain:</strong> UI AbortController → close SSE → BFF cancels provider job → client finalizes partial MD</li>\n          <li><strong>Drop recovery:</strong> Keep partial UI → retry with Idempotency-Key OR resume with generation cursor</li>\n          <li><strong>Backoff:</strong> Exponential 1s→2s→4s (cap 30s); honor Retry-After on 429</li>\n          <li><strong>Edge:</strong> CDN for static assets; API at origin; optional edge auth refresh — not for SSE body</li>\n        </ul>\n\n        <div class=\"section-links\">\n          <a href=\"answers-html/01-streaming-real-time-rendering.html\">§01 SSE</a>\n          <a href=\"answers-html/07-offline-resilience-error-handling.html\">§07 Resilience</a>\n          <a href=\"answers-html/09-api-design-provider-abstraction.html\">§09 Adapters</a>\n        </div>\n      </div>\n    </article>\n\n    <!-- ⑤ DEEP DIVE -->\n    <article class=\"section-block\" id=\"deep-dive\" data-section=\"deep-dive\">\n      <div class=\"section-head\">\n        <div class=\"section-num deep\">⑤</div>\n        <div>\n          <h2>Deep Dive</h2>\n          <div class=\"section-meta\">~10 min · Pick 1–2 areas the interviewer cares about</div>\n        </div>\n        <span class=\"chevron\">▼</span>\n      </div>\n      <div class=\"section-body\">\n        <p>Say: <em>“I'll go deep on Performance and Security — happy to switch if you prefer observability or testing.”</em></p>\n        <div class=\"deep-tabs\" id=\"deepTabs\">\n          <button type=\"button\" class=\"deep-tab active\" data-panel=\"perf\">Performance</button>\n          <button type=\"button\" class=\"deep-tab\" data-panel=\"sec\">Security</button>\n          <button type=\"button\" class=\"deep-tab\" data-panel=\"obs\">Observability</button>\n          <button type=\"button\" class=\"deep-tab\" data-panel=\"test\">Testing</button>\n          <button type=\"button\" class=\"deep-tab\" data-panel=\"a11y\">A11y + i18n</button>\n        </div>\n\n        <div class=\"deep-panel active\" id=\"panel-perf\">\n          <ul>\n            <li><strong>Virtualization:</strong> react-window/virtuoso; dynamic height cache; pin streaming row outside virtualizer or as last item</li>\n            <li><strong>Streaming render:</strong> rAF batch + incremental markdown blocks; defer Shiki until fence closes</li>\n            <li><strong>Backpressure:</strong> pause ReadableStream read(); coalesce tokens; shed highlight under load</li>\n            <li><strong>TTFT:</strong> optimistic bubble immediately; measure provider TTFB vs client paint separately</li>\n            <li><strong>Sidebar 10k:</strong> metadata-only rows, cursor pagination, FTS index, IDB cache</li>\n          </ul>\n        </div>\n        <div class=\"deep-panel\" id=\"panel-sec\">\n          <ul>\n            <li><strong>Auth:</strong> JWT claims → ctx; Postgres RLS belt; org_id never from client body alone</li>\n            <li><strong>XSS:</strong> Never dangerouslySetInnerHTML on full stream; escape code blocks; sanitize artifact sandbox</li>\n            <li><strong>MCP trust:</strong> Egress allowlist; data minimization; audit log with input/output hashes</li>\n            <li><strong>Uploads:</strong> Quarantine bucket; content firewall; never inject uploads into system role</li>\n            <li><strong>Artifacts:</strong> iframe sandbox allow-scripts only; strict CSP; postMessage origin check</li>\n            <li><strong>Idempotency:</strong> (user_id, key) unique — double confirm in 200ms → one booking</li>\n          </ul>\n        </div>\n        <div class=\"deep-panel\" id=\"panel-obs\">\n          <ul>\n            <li>Client: tokens_received − tokens_rendered, frame p95, parse ms, stream recovery rate</li>\n            <li>Server: TTFT, generation duration, tool latency, 429/529 rates, checkpoint lag</li>\n            <li>Trace: request_id / generation_id across UI → BFF → provider</li>\n            <li>Product analytics: branch edits, tool confirms, stream interrupts (not user abort)</li>\n          </ul>\n        </div>\n        <div class=\"deep-panel\" id=\"panel-test\">\n          <ul>\n            <li>Unit: branch assembler, IR compile, markdown block parser, idempotency key derivation</li>\n            <li>Integration: SSE reducer with fixture event streams; tool confirm dedup</li>\n            <li>E2E: send → stream → stop; edit mid-thread → new branch; offline outbox drain</li>\n            <li>Load: virtualizer with 500 synthetic messages; stream at 100 chunks/sec</li>\n          </ul>\n        </div>\n        <div class=\"deep-panel\" id=\"panel-a11y\">\n          <ul>\n            <li><code>aria-live=\"polite\"</code> on message region; <code>aria-busy</code> until first token</li>\n            <li>Stop button keyboard accessible; focus trap in confirm modal</li>\n            <li>Reduced motion: disable typing dot bounce</li>\n            <li>i18n: RTL composer; locale-aware dates in sidebar; CJK token estimate caveat</li>\n          </ul>\n        </div>\n\n        <h3>Interview close (30 sec)</h3>\n        <div class=\"callout\">Three patterns I'd repeat: <strong>(1)</strong> server graph is source of truth with client optimism, <strong>(2)</strong> idempotency keys + stream cursors for duplicate actions and duplicate bytes, <strong>(3)</strong> bounded failure domains — sandbox kill, stream checkpoint, auth pause — never freeze the whole app.</div>\n\n        <div class=\"section-links\">\n          <a href=\"answers-html/10-killer-questions.html\">§10 Killer Qs</a>\n          <a href=\"answers-html/06-auth-security-multitenancy.html\">§06 Auth</a>\n          <a href=\"answers-html/04-artifacts-sandboxed-rendering.html\">§04 Artifacts</a>\n        </div>\n      </div>\n    </article>\n\n    <footer>\n      <a href=\"answers-html/index.html\">Section answers</a> ·\n      <a href=\"claude-frontend-architecture.html\">Architecture map</a> ·\n      <a href=\"Claude-design-doc.md\">Question bank</a>\n    </footer>\n  </div>\n\n  <script type=\"module\">\n    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';\n    const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n    mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'neutral', securityLevel: 'loose', flowchart: { useMaxWidth: true } });\n\n    document.querySelectorAll('.section-block .section-head').forEach(head => {\n      head.addEventListener('click', () => head.parentElement.classList.toggle('collapsed'));\n    });\n\n    document.querySelectorAll('#deepTabs .deep-tab').forEach(tab => {\n      tab.addEventListener('click', () => {\n        document.querySelectorAll('#deepTabs .deep-tab').forEach(t => t.classList.remove('active'));\n        document.querySelectorAll('.deep-panel').forEach(p => p.classList.remove('active'));\n        tab.classList.add('active');\n        document.getElementById('panel-' + tab.dataset.panel).classList.add('active');\n      });\n    });\n\n    const navLinks = document.querySelectorAll('#topNav a[data-section]');\n    const sections = document.querySelectorAll('[data-section]');\n    const observer = new IntersectionObserver(entries => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          navLinks.forEach(a => a.classList.toggle('active', a.dataset.section === entry.target.dataset.section));\n        }\n      });\n    }, { rootMargin: '-40% 0px -50% 0px' });\n    sections.forEach(s => observer.observe(s));\n\n    document.querySelectorAll('ul.checklist[data-store]').forEach(list => {\n      const key = 'sd-interview-' + list.dataset.store;\n      list.querySelectorAll('input').forEach((cb, i) => {\n        const saved = JSON.parse(localStorage.getItem(key) || '[]');\n        cb.checked = saved.includes(i);\n        cb.addEventListener('change', () => {\n          const checked = [...list.querySelectorAll('input')].map((c, j) => c.checked ? j : null).filter(x => x !== null);\n          localStorage.setItem(key, JSON.stringify(checked));\n        });\n      });\n    });\n\n    await mermaid.run({ querySelector: '.mermaid' });\n  </script>\n</body>\n</html>\n","numLines":747,"startLine":1,"totalLines":747}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01Rreq7Pu8drCe9bUohfHwZG","type":"tool_result","content":"1\t# Payments System Frontend System Design — Interview Questions\n2\t\n3\tA comprehensive reference of deep questions across all segments, organized by theme and difficulty. Covers the full frontend surface of a checkout and payment processing system (think Stripe, Braintree, PayPal, Adyen).\n4\t\n5\t---\n6\t\n7\t## 1. Checkout Flow & Form UX\n8\t\n9\t> Extremely common opening section — interviewers use checkout flow to probe component architecture, form validation strategy, and UX judgment all at once.\n10\t\n11\t### Core\n12\t\n13\t- Walk me through how you would architect a multi-step checkout flow (cart → shipping → payment → confirmation). Where does state live, how do you handle back-navigation, and how do you prevent users from skipping steps?\n14\t- How do you design a credit card input form that provides real-time feedback — card type detection, formatted input masking (e.g., `4242 4242 4242 4242`), expiry validation, and CVV length rules — without blocking the user while they type?\n15\t- What is the correct strategy for inline vs. summary error display in a payment form? When should you validate on `blur` vs. `change` vs. `submit`, and how do you avoid frustrating users with premature errors on partially-typed card numbers?\n16\t- How do you handle address autocomplete (Google Places API, Smarty Streets) in a checkout form — including debouncing, fallback to manual entry when the API is unavailable, and ensuring the autofilled address is still validated server-side?\n17\t- A user fills out the payment form and hits \"Pay Now,\" but the network request takes 3 seconds. Describe your loading state strategy: what is disabled, what is shown, and how do you prevent double-submission?\n18\t- How would you design the order summary panel in a checkout flow so it stays in sync with cart mutations (quantity changes, coupon application, tax recalculation) without full-page reloads?\n19\t- How do you approach progressive disclosure in a checkout form — e.g., showing the billing address form only when it differs from shipping, or revealing the installment options only for purchases above a threshold?\n20\t\n21\t### Deep\n22\t\n23\t- Stripe's \"Link\" feature auto-fills payment details for returning customers across merchants. If you were building a similar saved-payment-method flow, how would you design the UX handoff between \"guest checkout\" and \"recognized user\" without causing a jarring re-render mid-form, and how do you handle the case where the saved method has expired?\n24\t- A/B tests on checkout forms consistently show that reducing the number of visible fields increases conversion — but fewer fields can also increase fraud and failed deliveries. How do you architect a checkout form component system that allows product and risk teams to toggle field visibility, validation rules, and required/optional status from a feature-flag config without frontend deploys?\n25\t- Describe how you would implement a \"smart retry\" UX after a card decline. Specifically: how do you preserve the user's previously entered data (without re-storing raw card numbers), which fields do you clear vs. keep, and what messaging hierarchy do you use to distinguish a soft decline (insufficient funds) from a hard decline (stolen card) given that your frontend may only receive a generic error code?\n26\t\n27\t---\n28\t\n29\t## 2. Payment Security & PCI Compliance\n30\t\n31\t> Always asked for senior/staff roles. Interviewers expect you to know why iframes exist and what PCI DSS scope means for frontend architecture choices.\n32\t\n33\t### Core\n34\t\n35\t- What is PCI DSS scope, and how does using a hosted payment field solution like Stripe Elements or Braintree's Hosted Fields reduce the scope of your application's PCI compliance obligations?\n36\t- How does Stripe Elements prevent your page from ever touching raw card data? Walk through the technical mechanism — what is rendered in your DOM, what lives in the Stripe iframe's origin, and what is exchanged between the two contexts via `postMessage`.\n37\t- Why can't you simply style a cross-origin iframe with CSS from the parent page, and how do payment providers like Stripe solve this problem while keeping card data isolated? What are the trade-offs of their \"appearance\" configuration APIs?\n38\t- Explain how a Content Security Policy (CSP) should be configured for a checkout page that loads Stripe.js. Which directives are required, which are commonly misconfigured (and why), and what does Stripe itself require you to allow that might feel uncomfortable from a security standpoint?\n39\t- What is tokenization in the context of card payments? Walk through the lifecycle: the user enters a card number, Stripe creates a `PaymentMethod` object — what is sent to your server, what is never sent, and how does your server use that token to charge the card?\n40\t- What is the risk of storing a Stripe `PaymentIntent` client secret in `localStorage` vs. a session cookie vs. an in-memory variable, and what happens if a malicious script on your page reads the client secret?\n41\t- How do you prevent clickjacking on a checkout page, and why is `X-Frame-Options: DENY` insufficient on its own for a page that also embeds legitimate third-party iframes (like Stripe Elements)?\n42\t\n43\t### Deep\n44\t\n45\t- Stripe Elements renders card input fields inside cross-origin iframes. Your designer wants pixel-perfect custom fonts loaded from your CDN inside those fields. Walk through exactly what the browser's cross-origin isolation rules allow, what Stripe's `fonts` configuration option does under the hood, and what you cannot achieve regardless of configuration — then propose a design compromise that satisfies both security and branding requirements.\n46\t- A penetration tester flags that your checkout page makes a `fetch` to `api.yoursite.com/payment-intent` from the browser, and the response contains the PaymentIntent `client_secret`. They argue this is a security vulnerability. How do you evaluate that claim? Under what conditions is it acceptable to expose a client secret to the browser, and what server-side and frontend controls must be in place to make this safe?\n47\t- You are migrating from a legacy checkout form that directly POSTed raw card data to your own server (PCI SAQ D scope) to a Stripe Elements integration (PCI SAQ A scope). Describe the full migration strategy: how do you run both implementations in parallel for a staged rollout, how do you ensure no raw card data ever hits your new infrastructure, and how do you validate the cutover is complete from a compliance standpoint?\n48\t\n49\t---\n50\t\n51\t## 3. State Management & Transaction Lifecycle\n52\t\n53\t> Tests whether candidates understand the payment intent as a state machine and can reason about eventual consistency, idempotency, and race conditions on the frontend.\n54\t\n55\t### Core\n56\t\n57\t- A Stripe `PaymentIntent` moves through states: `requires_payment_method` → `requires_confirmation` → `requires_action` → `processing` → `succeeded` (or `requires_capture`, `canceled`). How does your frontend model this state machine, and how do you decide which UI to render at each transition?\n58\t- What is idempotency in the context of payment requests, and how do you implement it on the frontend? Specifically, if a user clicks \"Pay\" and the request times out before you receive a response, how do you safely retry without charging the user twice?\n59\t- How do you handle optimistic UI in a payment flow? Unlike a social media \"like,\" a payment has real monetary consequence if the optimistic update is wrong. Where do you draw the line between responsiveness and correctness?\n60\t- Describe how you would manage the state of a multi-step checkout form across a full page refresh. What should be persisted (to `sessionStorage`, a URL param, or a server-side cart session), and what should be intentionally discarded to avoid security issues?\n61\t- What happens to an in-flight payment confirmation if the user's browser tab is closed or the device loses power during the `processing` state? How does your frontend handle re-entry — e.g., the user re-opens the tab or returns to the site 10 minutes later?\n62\t- How do you handle concurrent modifications to a shared cart — e.g., the same user opens checkout in two browser tabs simultaneously? How do you detect the conflict on the frontend and recover gracefully?\n63\t- A user completes payment but the success redirect is intercepted by an ad blocker or a browser extension that strips query params. How do you design the confirmation flow so the user reaches a correct success state even if your `?payment_intent=pi_xxx&redirect_status=succeeded` URL param never arrives?\n64\t\n65\t### Deep\n66\t\n67\t- Walk me through implementing a robust payment retry loop on the frontend. The user's card was declined (soft decline). You want to: (1) allow the user to update their card details, (2) re-confirm the same `PaymentIntent` rather than creating a new one, and (3) cap retries at a safe limit to avoid locking the card. How do you manage the state transitions, and what data do you pass back to the `confirmCardPayment` call on a retry?\n68\t- Describe how you would architect a frontend payment state machine using XState (or a comparable library). Define the states, events, guards, and side effects for the full lifecycle including 3DS authentication, network errors, and soft declines. What are the advantages of this approach over ad-hoc `if/else` logic in React component state?\n69\t- Your checkout frontend runs inside a mobile WebView embedded in a native iOS/Android app. The native app and the WebView both need to know the payment outcome. Walk through the communication architecture: how does a payment confirmation event travel from the Stripe SDK (inside the WebView) through the `postMessage` bridge to the native layer, what are the failure modes, and how do you ensure exactly-once delivery of the success event to the native app?\n70\t\n71\t---\n72\t\n73\t## 4. Real-Time Updates & Webhooks\n74\t\n75\t> Tests understanding of the async gap between \"payment submitted\" and \"payment confirmed\" — a uniquely tricky problem in payment UX.\n76\t\n77\t### Core\n78\t\n79\t- After calling `stripe.confirmCardPayment()`, Stripe returns immediately with a `PaymentIntent` object. But the actual charge confirmation comes asynchronously via webhook. How do you reconcile the frontend's view of payment status with the authoritative server-side status, and when is it safe to show the user a success screen?\n80\t- Compare polling, WebSockets, and Server-Sent Events (SSE) as mechanisms for delivering payment status updates to the frontend. Which would you choose for a payment confirmation flow, and why?\n81\t- How would you implement a polling strategy for payment status that is resilient to transient network failures, doesn't hammer your server, and gives up gracefully after a timeout? Describe the backoff algorithm and the UX at each stage.\n82\t- What is the risk of relying solely on the browser-side `stripe.confirmCardPayment()` return value to determine payment success, rather than verifying server-side via webhook? Give a specific attack scenario where this leads to revenue loss or fraud.\n83\t- Describe the \"pending payment\" screen UX for a payment that enters `processing` state (common with bank transfers, SEPA debit, or certain card networks). What do you show the user, how long do you keep them on this screen, and what happens when they close the browser?\n84\t- How do you handle a scenario where a webhook arrives at your server but the frontend user has already navigated away? How do you re-surface the payment outcome the next time the user visits?\n85\t- Your server receives a `payment_intent.succeeded` webhook but the frontend is currently showing the user a \"payment failed\" error screen (because the initial API call timed out). How do you reconcile this and correct the UI?\n86\t\n87\t### Deep\n88\t\n89\t- Design a real-time payment status notification system that must work across: (a) an active checkout tab using SSE, (b) a user who has closed the tab but re-opens the site within 10 minutes, and (c) a mobile user who has backgrounded the app. Describe the full data flow from Stripe webhook → your backend → frontend for each case, including how you handle reconnection, missed events, and event deduplication.\n90\t- Stripe sends webhooks with a `Stripe-Signature` header for verification. Your frontend needs to display a real-time status update the moment this webhook is processed. Walk through the full architecture: webhook receiver → verification → event storage → push to frontend. How do you ensure the frontend update is consistent with the database state and doesn't display a stale intermediate state?\n91\t- You are building a payment dashboard that shows live transaction status for multiple concurrent payments (think a restaurant POS processing 20 orders simultaneously). Describe how you would design the WebSocket message schema, client-side store normalization, and render optimization to ensure the UI stays responsive and correct as events arrive out of order.\n92\t\n93\t---\n94\t\n95\t## 5. Performance & Core Web Vitals\n96\t\n97\t> A checkout page's performance directly impacts conversion rate — every 100ms of latency costs measurable revenue. Interviewers expect specific metrics and techniques.\n98\t\n99\t### Core\n100\t\n101\t- Stripe.js is a ~300KB third-party script. When and how should you load it, and why does Stripe's own documentation recommend loading it on every page of your site rather than only on the checkout page? What are the performance trade-offs of each approach?\n102\t- How does injecting a Stripe Elements iframe into the DOM affect Cumulative Layout Shift (CLS), and what CSS techniques do you use to prevent the card input from causing layout shifts when it mounts?\n103\t- Describe your bundle-splitting strategy for a checkout page. Which chunks are critical path, which are deferred, and how do you decide what to inline in the HTML vs. load asynchronously?\n104\t- What is the impact of third-party payment SDKs (Stripe, PayPal button, Apple Pay, Google Pay) on your checkout page's Total Blocking Time (TBT) and Interaction to Next Paint (INP)? How do you load these without blocking the main thread?\n105\t- How would you optimize the Time to Interactive (TTI) for a checkout page that requires: authentication state check, cart data fetch, Stripe.js load, and address form render — all before the user can type a card number?\n106\t- Describe how you would use resource hints (`preconnect`, `prefetch`, `preload`) specifically for a checkout page that loads Stripe.js, Google Fonts for the branded card input, and a product image CDN.\n107\t- What are the trade-offs between server-side rendering (SSR), static generation, and client-side rendering for a checkout page? Which approach do you use, and how does it affect Time to First Byte (TTFB) and the \"page is interactive\" moment?\n108\t\n109\t### Deep\n110\t\n111\t- A/B test results show that your checkout page has a 15% higher bounce rate on 3G mobile connections compared to competitors. Your LCP is 4.2s. Walk through a systematic performance audit: which tools do you use, what hypotheses do you form, and which specific optimizations do you implement for the Stripe SDK loading, hero image, and above-the-fold form render?\n112\t- Stripe Elements renders inside an iframe, which means the browser must establish a separate network connection to `js.stripe.com`. Model the exact sequence of DNS lookup, TCP handshake, TLS negotiation, and iframe load for a user on a 50ms-latency mobile connection. Where are the optimization opportunities, and what is the irreducible minimum latency floor you cannot engineer around?\n113\t- You are asked to implement a \"one-click checkout\" experience (similar to Shop Pay or Amazon 1-Click) where returning users can complete a purchase in under 2 seconds. Describe the full performance architecture: what is pre-fetched on the product page, what is pre-loaded on hover/tap, how is the PaymentIntent pre-created, and what is the critical rendering path once the user clicks \"Buy Now\"?\n114\t\n115\t---\n116\t\n117\t## 6. Error Handling & Resilience\n118\t\n119\t> Payment errors are high-stakes and high-frequency. Interviewers probe whether you can distinguish error types and build UX that recovers without losing the user.\n120\t\n121\t### Core\n122\t\n123\t- Enumerate the categories of errors that can occur in a frontend payment flow (network errors, card declines, validation errors, authentication failures, fraud blocks, rate limits) and describe how the error handling strategy differs for each category.\n124\t- A user's card is declined with Stripe error code `card_declined` and decline code `insufficient_funds`. What do you show the user? What do you show the user if the decline code is `stolen_card`? How does your error message component know which codes warrant specific messaging vs. a generic \"payment failed\" message?\n125\t- What is 3D Secure (3DS) authentication, when is it triggered, and how does `stripe.confirmCardPayment()` handle the 3DS challenge flow? What does the user experience look like, and what are the failure modes (user cancels, 3DS times out, bank's 3DS page is down)?\n126\t- How do you distinguish between a network timeout (where the payment may or may not have processed) and a definitive payment failure (where you know the charge was rejected)? How does each case change your frontend error recovery strategy?\n127\t- Describe your strategy for handling the case where Stripe.js itself fails to load (CDN outage, network error, ad blocker). Do you have a fallback, or do you fail gracefully? What does the user see, and what do you log?\n128\t- How do you implement a circuit breaker pattern on the frontend for payment requests? If your payment API endpoint is returning 503s, how do you detect this condition and prevent the user from hammering a degraded backend?\n129\t- What is the UX strategy for a payment that fails at the very last step — after the user has entered all their details and clicked \"Pay\" — but due to a server-side error rather than a card decline? How do you preserve their form state and communicate the error without inducing panic?\n130\t\n131\t### Deep\n132\t\n133\t- Walk me through the full 3DS2 authentication flow from a frontend architecture standpoint. Specifically: how does Stripe.js detect that 3DS is required after `confirmCardPayment`, how is the challenge rendered (in an iframe? a redirect? a modal?), how do you handle the case where the device fingerprinting step triggers a full redirect rather than a seamless iframe challenge, and what happens to your React component state across that redirect boundary?\n134\t- You are building a checkout that must work in environments with extremely poor connectivity (rural mobile, flaky WiFi). Design a resilience strategy that includes: detecting offline state before submission, queuing the payment attempt for retry when connectivity returns, preventing duplicate charges, and communicating uncertainty to the user without causing them to abandon. What APIs do you use, and what are the limits of what you can guarantee on the frontend?\n135\t- Your monitoring alerts that 8% of users who click \"Pay\" are seeing an unhandled JavaScript exception in the Stripe Elements payment confirmation step. You have Sentry traces showing the error originates inside the cross-origin Stripe iframe. What do you know, and what don't you know, from that error report? How do you diagnose the root cause given that you cannot inspect Stripe's iframe code, and what mitigations do you ship while the investigation is ongoing?\n136\t\n137\t---\n138\t\n139\t## 7. Internationalization & Localization\n140\t\n141\t> Often underweighted by candidates. A globally deployed payments frontend has uniquely complex i18n requirements around currency, local payment methods, and regulatory display rules.\n142\t\n143\t### Core\n144\t\n145\t- Describe how you format currency amounts in a payments UI across different locales. What does `Intl.NumberFormat` give you, where does it fall short (e.g., currencies with non-standard subunit counts like JPY or KWD), and how do you handle amounts that arrive from your API in minor units (cents)?\n146\t- How do you display prices that include tax in markets where tax must be shown separately (US) vs. markets where prices must be shown tax-inclusive by law (EU, Australia)? How does this affect your pricing component's data contract and render logic?\n147\t- What are the specific challenges of supporting RTL languages (Arabic, Hebrew) in a checkout form — beyond just `dir=\"rtl\"` on the container? Think about icon placement (card type icon, CVV help icon), number formatting, and error message positioning.\n148\t- Stripe supports \"local payment methods\" (iDEAL in the Netherlands, BLIK in Poland, Pix in Brazil, UPI in India). How do you architect a payment method selector that is data-driven (configured per-country) rather than hardcoded, and how do each of these methods change the checkout UX flow?\n149\t- How do you handle locale-specific date formatting in a payments context — specifically card expiry dates, invoice dates, and estimated delivery windows — given that `12/03` means March 12 in Europe and December 3 in the US?\n150\t- What is your strategy for translating dynamic server error messages (card decline reasons, fraud messages) that arrive in English from your payment processor but need to be displayed in the user's language?\n151\t- How do you support multiple currencies in a single checkout — e.g., a platform where the buyer is in Germany paying in EUR but the seller is in Canada receiving CAD? What does the UI need to display, and what data must come from the server vs. what can the frontend derive?\n152\t\n153\t### Deep\n154\t\n155\t- You are expanding checkout to Japan, which has several unique requirements: prices are always displayed as whole numbers (no decimal yen), the most popular payment method is convenience store payment (konbini) which is asynchronous and cash-based, and the address form field order is reversed (postal code → prefecture → city → street, then name in family-name-first order). Walk through the specific component and data model changes required, and how you architect the address form to be locale-driven rather than requiring a separate Japanese checkout page.\n156\t- Stripe's `amount` field is always an integer in the currency's smallest unit. For most currencies this is cents, but for currencies like the Jordanian Dinar (3 decimal places, 1 JOD = 1000 fils) and currencies like the Japanese Yen (0 decimal places), the math changes. Build a robust currency utility module: given a `{amount: number, currency: string}` object, how do you correctly format the display value, and how do you validate user-entered amounts to prevent off-by-100x errors?\n157\t- Design a payment method ranking and display system for a global checkout. The backend provides a list of available payment methods for the user's country and cart value. Your frontend must: rank them by local preference (e.g., iDEAL first in NL, not Visa), display their logos with appropriate localized labels, hide methods that don't support the cart currency, and gracefully degrade if the ranking config is unavailable. Describe the data schema, component hierarchy, and fallback behavior.\n158\t\n159\t---\n160\t\n161\t## 8. Observability & Analytics\n162\t\n163\t> Tells interviewers whether you think about the full product lifecycle, not just shipping code. For a payments frontend, data quality is revenue-critical.\n164\t\n165\t### Core\n166\t\n167\t- What events would you instrument in a checkout funnel to enable a product team to measure conversion at each step and identify where users are dropping off? Give specific event names, properties, and the conditions under which each fires.\n168\t- How do you track \"payment abandonment\" — specifically distinguishing between: (a) a user who leaves the page before entering any payment details, (b) a user who starts entering card info but exits, and (c) a user who clicks \"Pay\" but the request fails? Why does this distinction matter for product decisions?\n169\t- What is your strategy for tracking errors in a payment flow without accidentally logging sensitive card data (PANs, CVVs) to your analytics or error monitoring service? What specific fields or patterns do you sanitize before sending to Sentry or Datadog?\n170\t- How do you measure the performance of the Stripe.js initialization and Elements mount time in your Real User Monitoring (RUM) data? What custom performance marks would you use, and how do you correlate slow load times with conversion drop-off?\n171\t- Describe how you would build a real-time payment success rate dashboard. What metrics do you track (success rate, decline rate broken down by decline code, 3DS completion rate), and what is your alerting threshold that should page an on-call engineer?\n172\t- How do you instrument the retry behavior after a card decline to understand whether your retry UX is effective? What metrics tell you the retry flow is working vs. that it is causing additional user frustration?\n173\t- What is the risk of sending `payment_intent_id` or `charge_id` in analytics events (e.g., to Google Analytics or Amplitude), and how do you evaluate whether to include these identifiers?\n174\t\n175\t### Deep\n176\t\n177\t- You notice in your funnel data that 23% of users who reach the payment step never click \"Pay\" — they simply leave. Your checkout form has a 4-second load time for Stripe Elements on mobile. Walk through how you would design and execute an experiment to determine whether the Elements load time is causally responsible for the abandonment rate, versus other hypotheses (price shock, trust signals, required account creation). What instrumentation do you add, and how do you isolate the variable?\n178\t- Design an observability system for a payments frontend that gives you the following within 60 seconds of a production incident: (1) the percentage of checkout attempts that are failing vs. succeeding in real time, (2) whether the failure is in the Stripe client SDK, your own API, or the network between them, and (3) which user segments (by country, payment method, device type) are most affected. Describe the events, aggregation pipeline, and dashboard panels you would build.\n179\t- Your payment success rate drops from 94% to 87% after a deploy. You need to determine whether this is a frontend regression or a backend/Stripe issue. Describe your diagnostic playbook: which logs and metrics do you look at first, how do you correlate the deploy timestamp with the metric drop, how do you check whether Stripe has an ongoing incident, and what is your rollback decision criteria? Assume you have Datadog RUM, Sentry, and Stripe's Dashboard available.\n180\t\n181\t---\n182\t\n183\t## 9. Architecture & Provider Abstraction\n184\t\n185\t> Staff/principal level territory. Tests whether you can design a payment frontend that doesn't tightly couple to a single PSP, enabling multi-provider routing and future migration.\n186\t\n187\t### Core\n188\t\n189\t- How do you architect a frontend payment abstraction layer that can route to Stripe for some transactions, Adyen for others, and PayPal for a third segment — all without the checkout UI component knowing which PSP is being used?\n190\t- Different PSPs have different client-side SDKs (Stripe.js, Adyen's Web Components, Braintree's client SDK). These all have different APIs for mounting card fields, confirming payments, and handling 3DS. How do you normalize these into a single interface that your checkout component talks to?\n191\t- What is a \"payment method types\" configuration, and how do you design a frontend data model that is PSP-agnostic — capable of expressing \"card,\" \"bank transfer,\" \"wallet,\" and \"buy now pay later\" without encoding PSP-specific field names or token formats?\n192\t- How do you handle the case where your provider abstraction layer must support PSPs that have fundamentally different authentication flows — e.g., Stripe's embedded iframe model vs. Adyen's full-page redirect for certain payment methods?\n193\t- What are the risks of building a \"thin shim\" abstraction vs. a \"rich unified API\" abstraction over multiple PSPs? Where does each approach break down in practice?\n194\t- How do you design the error model for a PSP abstraction layer? Stripe error codes differ from Adyen result codes, which differ from Braintree transaction statuses. How do you normalize these into a set of frontend-actionable error categories without losing the PSP-specific detail your support team needs?\n195\t- How would you approach lazy-loading PSP SDKs so that Stripe.js is only loaded when Stripe is the selected provider, and Adyen's SDK is only loaded when Adyen is selected — while keeping the time-to-interactive acceptable?\n196\t\n197\t### Deep\n198\t\n199\t- You are building a multi-PSP checkout where Stripe handles cards, PayPal handles its own wallet flow, and Klarna handles BNPL — all on the same checkout page. Each SDK wants to mount its own UI components into your DOM. Describe the component mounting strategy, the event communication model between each third-party component and your React state, and how you ensure that only one payment method's UI is \"active\" at a time without leaking event listeners or iframe references.\n200\t- Design the frontend architecture for a payment platform that must support provider failover: if Stripe returns a 5xx during `confirmCardPayment`, you want to retry the same charge attempt through Adyen within 2 seconds, without the user knowing a provider switch occurred. What constraints does this place on how you construct the PaymentIntent server-side, how you pass the client token to the frontend, and what the abstraction layer's retry logic looks like? Where does this approach fundamentally break down and require server-side coordination instead?\n201\t- You are tasked with migrating a checkout from Braintree to Stripe over 6 months, with a gradual rollout. Both SDKs must be active simultaneously during the migration. Walk through: how you load both SDKs without doubling blocking script weight, how you route specific user cohorts to each provider (feature flag, A/B test, or deterministic hash), how you ensure your analytics can compare success rates across both providers, and how you define \"migration complete\" from a frontend perspective.\n202\t\n203\t---\n204\t\n205\t*Generated June 2026 — covers Stripe, Adyen, Braintree, PayPal, and general PSP patterns.*\n206\t"}]},"parent_tool_use_id":null,"session_id":"f24c5cdf-0369-4a81-99d5-ba16ab3babb1","uuid":"553905ef-03db-4999-86b5-cdb3ca7c6f8f","timestamp":"2026-06-20T19:52:14.020Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sarthakagarwal/Desktop/projects/prep/system-design/payments-system/payments-system-design-doc.md","content":"# Payments System Frontend System Design — Interview Questions\n\nA comprehensive reference of deep questions across all segments, organized by theme and difficulty. Covers the full frontend surface of a checkout and payment processing system (think Stripe, Braintree, PayPal, Adyen).\n\n---\n\n## 1. Checkout Flow & Form UX\n\n> Extremely common opening section — interviewers use checkout flow to probe component architecture, form validation strategy, and UX judgment all at once.\n\n### Core\n\n- Walk me through how you would architect a multi-step checkout flow (cart → shipping → payment → confirmation). Where does state live, how do you handle back-navigation, and how do you prevent users from skipping steps?\n- How do you design a credit card input form that provides real-time feedback — card type detection, formatted input masking (e.g., `4242 4242 4242 4242`), expiry validation, and CVV length rules — without blocking the user while they type?\n- What is the correct strategy for inline vs. summary error display in a payment form? When should you validate on `blur` vs. `change` vs. `submit`, and how do you avoid frustrating users with premature errors on partially-typed card numbers?\n- How do you handle address autocomplete (Google Places API, Smarty Streets) in a checkout form — including debouncing, fallback to manual entry when the API is unavailable, and ensuring the autofilled address is still validated server-side?\n- A user fills out the payment form and hits \"Pay Now,\" but the network request takes 3 seconds. Describe your loading state strategy: what is disabled, what is shown, and how do you prevent double-submission?\n- How would you design the order summary panel in a checkout flow so it stays in sync with cart mutations (quantity changes, coupon application, tax recalculation) without full-page reloads?\n- How do you approach progressive disclosure in a checkout form — e.g., showing the billing address form only when it differs from shipping, or revealing the installment options only for purchases above a threshold?\n\n### Deep\n\n- Stripe's \"Link\" feature auto-fills payment details for returning customers across merchants. If you were building a similar saved-payment-method flow, how would you design the UX handoff between \"guest checkout\" and \"recognized user\" without causing a jarring re-render mid-form, and how do you handle the case where the saved method has expired?\n- A/B tests on checkout forms consistently show that reducing the number of visible fields increases conversion — but fewer fields can also increase fraud and failed deliveries. How do you architect a checkout form component system that allows product and risk teams to toggle field visibility, validation rules, and required/optional status from a feature-flag config without frontend deploys?\n- Describe how you would implement a \"smart retry\" UX after a card decline. Specifically: how do you preserve the user's previously entered data (without re-storing raw card numbers), which fields do you clear vs. keep, and what messaging hierarchy do you use to distinguish a soft decline (insufficient funds) from a hard decline (stolen card) given that your frontend may only receive a generic error code?\n\n---\n\n## 2. Payment Security & PCI Compliance\n\n> Always asked for senior/staff roles. Interviewers expect you to know why iframes exist and what PCI DSS scope means for frontend architecture choices.\n\n### Core\n\n- What is PCI DSS scope, and how does using a hosted payment field solution like Stripe Elements or Braintree's Hosted Fields reduce the scope of your application's PCI compliance obligations?\n- How does Stripe Elements prevent your page from ever touching raw card data? Walk through the technical mechanism — what is rendered in your DOM, what lives in the Stripe iframe's origin, and what is exchanged between the two contexts via `postMessage`.\n- Why can't you simply style a cross-origin iframe with CSS from the parent page, and how do payment providers like Stripe solve this problem while keeping card data isolated? What are the trade-offs of their \"appearance\" configuration APIs?\n- Explain how a Content Security Policy (CSP) should be configured for a checkout page that loads Stripe.js. Which directives are required, which are commonly misconfigured (and why), and what does Stripe itself require you to allow that might feel uncomfortable from a security standpoint?\n- What is tokenization in the context of card payments? Walk through the lifecycle: the user enters a card number, Stripe creates a `PaymentMethod` object — what is sent to your server, what is never sent, and how does your server use that token to charge the card?\n- What is the risk of storing a Stripe `PaymentIntent` client secret in `localStorage` vs. a session cookie vs. an in-memory variable, and what happens if a malicious script on your page reads the client secret?\n- How do you prevent clickjacking on a checkout page, and why is `X-Frame-Options: DENY` insufficient on its own for a page that also embeds legitimate third-party iframes (like Stripe Elements)?\n\n### Deep\n\n- Stripe Elements renders card input fields inside cross-origin iframes. Your designer wants pixel-perfect custom fonts loaded from your CDN inside those fields. Walk through exactly what the browser's cross-origin isolation rules allow, what Stripe's `fonts` configuration option does under the hood, and what you cannot achieve regardless of configuration — then propose a design compromise that satisfies both security and branding requirements.\n- A penetration tester flags that your checkout page makes a `fetch` to `api.yoursite.com/payment-intent` from the browser, and the response contains the PaymentIntent `client_secret`. They argue this is a security vulnerability. How do you evaluate that claim? Under what conditions is it acceptable to expose a client secret to the browser, and what server-side and frontend controls must be in place to make this safe?\n- You are migrating from a legacy checkout form that directly POSTed raw card data to your own server (PCI SAQ D scope) to a Stripe Elements integration (PCI SAQ A scope). Describe the full migration strategy: how do you run both implementations in parallel for a staged rollout, how do you ensure no raw card data ever hits your new infrastructure, and how do you validate the cutover is complete from a compliance standpoint?\n\n---\n\n## 3. State Management & Transaction Lifecycle\n\n> Tests whether candidates understand the payment intent as a state machine and can reason about eventual consistency, idempotency, and race conditions on the frontend.\n\n### Core\n\n- A Stripe `PaymentIntent` moves through states: `requires_payment_method` → `requires_confirmation` → `requires_action` → `processing` → `succeeded` (or `requires_capture`, `canceled`). How does your frontend model this state machine, and how do you decide which UI to render at each transition?\n- What is idempotency in the context of payment requests, and how do you implement it on the frontend? Specifically, if a user clicks \"Pay\" and the request times out before you receive a response, how do you safely retry without charging the user twice?\n- How do you handle optimistic UI in a payment flow? Unlike a social media \"like,\" a payment has real monetary consequence if the optimistic update is wrong. Where do you draw the line between responsiveness and correctness?\n- Describe how you would manage the state of a multi-step checkout form across a full page refresh. What should be persisted (to `sessionStorage`, a URL param, or a server-side cart session), and what should be intentionally discarded to avoid security issues?\n- What happens to an in-flight payment confirmation if the user's browser tab is closed or the device loses power during the `processing` state? How does your frontend handle re-entry — e.g., the user re-opens the tab or returns to the site 10 minutes later?\n- How do you handle concurrent modifications to a shared cart — e.g., the same user opens checkout in two browser tabs simultaneously? How do you detect the conflict on the frontend and recover gracefully?\n- A user completes payment but the success redirect is intercepted by an ad blocker or a browser extension that strips query params. How do you design the confirmation flow so the user reaches a correct success state even if your `?payment_intent=pi_xxx&redirect_status=succeeded` URL param never arrives?\n\n### Deep\n\n- Walk me through implementing a robust payment retry loop on the frontend. The user's card was declined (soft decline). You want to: (1) allow the user to update their card details, (2) re-confirm the same `PaymentIntent` rather than creating a new one, and (3) cap retries at a safe limit to avoid locking the card. How do you manage the state transitions, and what data do you pass back to the `confirmCardPayment` call on a retry?\n- Describe how you would architect a frontend payment state machine using XState (or a comparable library). Define the states, events, guards, and side effects for the full lifecycle including 3DS authentication, network errors, and soft declines. What are the advantages of this approach over ad-hoc `if/else` logic in React component state?\n- Your checkout frontend runs inside a mobile WebView embedded in a native iOS/Android app. The native app and the WebView both need to know the payment outcome. Walk through the communication architecture: how does a payment confirmation event travel from the Stripe SDK (inside the WebView) through the `postMessage` bridge to the native layer, what are the failure modes, and how do you ensure exactly-once delivery of the success event to the native app?\n\n---\n\n## 4. Real-Time Updates & Webhooks\n\n> Tests understanding of the async gap between \"payment submitted\" and \"payment confirmed\" — a uniquely tricky problem in payment UX.\n\n### Core\n\n- After calling `stripe.confirmCardPayment()`, Stripe returns immediately with a `PaymentIntent` object. But the actual charge confirmation comes asynchronously via webhook. How do you reconcile the frontend's view of payment status with the authoritative server-side status, and when is it safe to show the user a success screen?\n- Compare polling, WebSockets, and Server-Sent Events (SSE) as mechanisms for delivering payment status updates to the frontend. Which would you choose for a payment confirmation flow, and why?\n- How would you implement a polling strategy for payment status that is resilient to transient network failures, doesn't hammer your server, and gives up gracefully after a timeout? Describe the backoff algorithm and the UX at each stage.\n- What is the risk of relying solely on the browser-side `stripe.confirmCardPayment()` return value to determine payment success, rather than verifying server-side via webhook? Give a specific attack scenario where this leads to revenue loss or fraud.\n- Describe the \"pending payment\" screen UX for a payment that enters `processing` state (common with bank transfers, SEPA debit, or certain card networks). What do you show the user, how long do you keep them on this screen, and what happens when they close the browser?\n- How do you handle a scenario where a webhook arrives at your server but the frontend user has already navigated away? How do you re-surface the payment outcome the next time the user visits?\n- Your server receives a `payment_intent.succeeded` webhook but the frontend is currently showing the user a \"payment failed\" error screen (because the initial API call timed out). How do you reconcile this and correct the UI?\n\n### Deep\n\n- Design a real-time payment status notification system that must work across: (a) an active checkout tab using SSE, (b) a user who has closed the tab but re-opens the site within 10 minutes, and (c) a mobile user who has backgrounded the app. Describe the full data flow from Stripe webhook → your backend → frontend for each case, including how you handle reconnection, missed events, and event deduplication.\n- Stripe sends webhooks with a `Stripe-Signature` header for verification. Your frontend needs to display a real-time status update the moment this webhook is processed. Walk through the full architecture: webhook receiver → verification → event storage → push to frontend. How do you ensure the frontend update is consistent with the database state and doesn't display a stale intermediate state?\n- You are building a payment dashboard that shows live transaction status for multiple concurrent payments (think a restaurant POS processing 20 orders simultaneously). Describe how you would design the WebSocket message schema, client-side store normalization, and render optimization to ensure the UI stays responsive and correct as events arrive out of order.\n\n---\n\n## 5. Performance & Core Web Vitals\n\n> A checkout page's performance directly impacts conversion rate — every 100ms of latency costs measurable revenue. Interviewers expect specific metrics and techniques.\n\n### Core\n\n- Stripe.js is a ~300KB third-party script. When and how should you load it, and why does Stripe's own documentation recommend loading it on every page of your site rather than only on the checkout page? What are the performance trade-offs of each approach?\n- How does injecting a Stripe Elements iframe into the DOM affect Cumulative Layout Shift (CLS), and what CSS techniques do you use to prevent the card input from causing layout shifts when it mounts?\n- Describe your bundle-splitting strategy for a checkout page. Which chunks are critical path, which are deferred, and how do you decide what to inline in the HTML vs. load asynchronously?\n- What is the impact of third-party payment SDKs (Stripe, PayPal button, Apple Pay, Google Pay) on your checkout page's Total Blocking Time (TBT) and Interaction to Next Paint (INP)? How do you load these without blocking the main thread?\n- How would you optimize the Time to Interactive (TTI) for a checkout page that requires: authentication state check, cart data fetch, Stripe.js load, and address form render — all before the user can type a card number?\n- Describe how you would use resource hints (`preconnect`, `prefetch`, `preload`) specifically for a checkout page that loads Stripe.js, Google Fonts for the branded card input, and a product image CDN.\n- What are the trade-offs between server-side rendering (SSR), static generation, and client-side rendering for a checkout page? Which approach do you use, and how does it affect Time to First Byte (TTFB) and the \"page is interactive\" moment?\n\n### Deep\n\n- A/B test results show that your checkout page has a 15% higher bounce rate on 3G mobile connections compared to competitors. Your LCP is 4.2s. Walk through a systematic performance audit: which tools do you use, what hypotheses do you form, and which specific optimizations do you implement for the Stripe SDK loading, hero image, and above-the-fold form render?\n- Stripe Elements renders inside an iframe, which means the browser must establish a separate network connection to `js.stripe.com`. Model the exact sequence of DNS lookup, TCP handshake, TLS negotiation, and iframe load for a user on a 50ms-latency mobile connection. Where are the optimization opportunities, and what is the irreducible minimum latency floor you cannot engineer around?\n- You are asked to implement a \"one-click checkout\" experience (similar to Shop Pay or Amazon 1-Click) where returning users can complete a purchase in under 2 seconds. Describe the full performance architecture: what is pre-fetched on the product page, what is pre-loaded on hover/tap, how is the PaymentIntent pre-created, and what is the critical rendering path once the user clicks \"Buy Now\"?\n\n---\n\n## 6. Error Handling & Resilience\n\n> Payment errors are high-stakes and high-frequency. Interviewers probe whether you can distinguish error types and build UX that recovers without losing the user.\n\n### Core\n\n- Enumerate the categories of errors that can occur in a frontend payment flow (network errors, card declines, validation errors, authentication failures, fraud blocks, rate limits) and describe how the error handling strategy differs for each category.\n- A user's card is declined with Stripe error code `card_declined` and decline code `insufficient_funds`. What do you show the user? What do you show the user if the decline code is `stolen_card`? How does your error message component know which codes warrant specific messaging vs. a generic \"payment failed\" message?\n- What is 3D Secure (3DS) authentication, when is it triggered, and how does `stripe.confirmCardPayment()` handle the 3DS challenge flow? What does the user experience look like, and what are the failure modes (user cancels, 3DS times out, bank's 3DS page is down)?\n- How do you distinguish between a network timeout (where the payment may or may not have processed) and a definitive payment failure (where you know the charge was rejected)? How does each case change your frontend error recovery strategy?\n- Describe your strategy for handling the case where Stripe.js itself fails to load (CDN outage, network error, ad blocker). Do you have a fallback, or do you fail gracefully? What does the user see, and what do you log?\n- How do you implement a circuit breaker pattern on the frontend for payment requests? If your payment API endpoint is returning 503s, how do you detect this condition and prevent the user from hammering a degraded backend?\n- What is the UX strategy for a payment that fails at the very last step — after the user has entered all their details and clicked \"Pay\" — but due to a server-side error rather than a card decline? How do you preserve their form state and communicate the error without inducing panic?\n\n### Deep\n\n- Walk me through the full 3DS2 authentication flow from a frontend architecture standpoint. Specifically: how does Stripe.js detect that 3DS is required after `confirmCardPayment`, how is the challenge rendered (in an iframe? a redirect? a modal?), how do you handle the case where the device fingerprinting step triggers a full redirect rather than a seamless iframe challenge, and what happens to your React component state across that redirect boundary?\n- You are building a checkout that must work in environments with extremely poor connectivity (rural mobile, flaky WiFi). Design a resilience strategy that includes: detecting offline state before submission, queuing the payment attempt for retry when connectivity returns, preventing duplicate charges, and communicating uncertainty to the user without causing them to abandon. What APIs do you use, and what are the limits of what you can guarantee on the frontend?\n- Your monitoring alerts that 8% of users who click \"Pay\" are seeing an unhandled JavaScript exception in the Stripe Elements payment confirmation step. You have Sentry traces showing the error originates inside the cross-origin Stripe iframe. What do you know, and what don't you know, from that error report? How do you diagnose the root cause given that you cannot inspect Stripe's iframe code, and what mitigations do you ship while the investigation is ongoing?\n\n---\n\n## 7. Internationalization & Localization\n\n> Often underweighted by candidates. A globally deployed payments frontend has uniquely complex i18n requirements around currency, local payment methods, and regulatory display rules.\n\n### Core\n\n- Describe how you format currency amounts in a payments UI across different locales. What does `Intl.NumberFormat` give you, where does it fall short (e.g., currencies with non-standard subunit counts like JPY or KWD), and how do you handle amounts that arrive from your API in minor units (cents)?\n- How do you display prices that include tax in markets where tax must be shown separately (US) vs. markets where prices must be shown tax-inclusive by law (EU, Australia)? How does this affect your pricing component's data contract and render logic?\n- What are the specific challenges of supporting RTL languages (Arabic, Hebrew) in a checkout form — beyond just `dir=\"rtl\"` on the container? Think about icon placement (card type icon, CVV help icon), number formatting, and error message positioning.\n- Stripe supports \"local payment methods\" (iDEAL in the Netherlands, BLIK in Poland, Pix in Brazil, UPI in India). How do you architect a payment method selector that is data-driven (configured per-country) rather than hardcoded, and how do each of these methods change the checkout UX flow?\n- How do you handle locale-specific date formatting in a payments context — specifically card expiry dates, invoice dates, and estimated delivery windows — given that `12/03` means March 12 in Europe and December 3 in the US?\n- What is your strategy for translating dynamic server error messages (card decline reasons, fraud messages) that arrive in English from your payment processor but need to be displayed in the user's language?\n- How do you support multiple currencies in a single checkout — e.g., a platform where the buyer is in Germany paying in EUR but the seller is in Canada receiving CAD? What does the UI need to display, and what data must come from the server vs. what can the frontend derive?\n\n### Deep\n\n- You are expanding checkout to Japan, which has several unique requirements: prices are always displayed as whole numbers (no decimal yen), the most popular payment method is convenience store payment (konbini) which is asynchronous and cash-based, and the address form field order is reversed (postal code → prefecture → city → street, then name in family-name-first order). Walk through the specific component and data model changes required, and how you architect the address form to be locale-driven rather than requiring a separate Japanese checkout page.\n- Stripe's `amount` field is always an integer in the currency's smallest unit. For most currencies this is cents, but for currencies like the Jordanian Dinar (3 decimal places, 1 JOD = 1000 fils) and currencies like the Japanese Yen (0 decimal places), the math changes. Build a robust currency utility module: given a `{amount: number, currency: string}` object, how do you correctly format the display value, and how do you validate user-entered amounts to prevent off-by-100x errors?\n- Design a payment method ranking and display system for a global checkout. The backend provides a list of available payment methods for the user's country and cart value. Your frontend must: rank them by local preference (e.g., iDEAL first in NL, not Visa), display their logos with appropriate localized labels, hide methods that don't support the cart currency, and gracefully degrade if the ranking config is unavailable. Describe the data schema, component hierarchy, and fallback behavior.\n\n---\n\n## 8. Observability & Analytics\n\n> Tells interviewers whether you think about the full product lifecycle, not just shipping code. For a payments frontend, data quality is revenue-critical.\n\n### Core\n\n- What events would you instrument in a checkout funnel to enable a product team to measure conversion at each step and identify where users are dropping off? Give specific event names, properties, and the conditions under which each fires.\n- How do you track \"payment abandonment\" — specifically distinguishing between: (a) a user who leaves the page before entering any payment details, (b) a user who starts entering card info but exits, and (c) a user who clicks \"Pay\" but the request fails? Why does this distinction matter for product decisions?\n- What is your strategy for tracking errors in a payment flow without accidentally logging sensitive card data (PANs, CVVs) to your analytics or error monitoring service? What specific fields or patterns do you sanitize before sending to Sentry or Datadog?\n- How do you measure the performance of the Stripe.js initialization and Elements mount time in your Real User Monitoring (RUM) data? What custom performance marks would you use, and how do you correlate slow load times with conversion drop-off?\n- Describe how you would build a real-time payment success rate dashboard. What metrics do you track (success rate, decline rate broken down by decline code, 3DS completion rate), and what is your alerting threshold that should page an on-call engineer?\n- How do you instrument the retry behavior after a card decline to understand whether your retry UX is effective? What metrics tell you the retry flow is working vs. that it is causing additional user frustration?\n- What is the risk of sending `payment_intent_id` or `charge_id` in analytics events (e.g., to Google Analytics or Amplitude), and how do you evaluate whether to include these identifiers?\n\n### Deep\n\n- You notice in your funnel data that 23% of users who reach the payment step never click \"Pay\" — they simply leave. Your checkout form has a 4-second load time for Stripe Elements on mobile. Walk through how you would design and execute an experiment to determine whether the Elements load time is causally responsible for the abandonment rate, versus other hypotheses (price shock, trust signals, required account creation). What instrumentation do you add, and how do you isolate the variable?\n- Design an observability system for a payments frontend that gives you the following within 60 seconds of a production incident: (1) the percentage of checkout attempts that are failing vs. succeeding in real time, (2) whether the failure is in the Stripe client SDK, your own API, or the network between them, and (3) which user segments (by country, payment method, device type) are most affected. Describe the events, aggregation pipeline, and dashboard panels you would build.\n- Your payment success rate drops from 94% to 87% after a deploy. You need to determine whether this is a frontend regression or a backend/Stripe issue. Describe your diagnostic playbook: which logs and metrics do you look at first, how do you correlate the deploy timestamp with the metric drop, how do you check whether Stripe has an ongoing incident, and what is your rollback decision criteria? Assume you have Datadog RUM, Sentry, and Stripe's Dashboard available.\n\n---\n\n## 9. Architecture & Provider Abstraction\n\n> Staff/principal level territory. Tests whether you can design a payment frontend that doesn't tightly couple to a single PSP, enabling multi-provider routing and future migration.\n\n### Core\n\n- How do you architect a frontend payment abstraction layer that can route to Stripe for some transactions, Adyen for others, and PayPal for a third segment — all without the checkout UI component knowing which PSP is being used?\n- Different PSPs have different client-side SDKs (Stripe.js, Adyen's Web Components, Braintree's client SDK). These all have different APIs for mounting card fields, confirming payments, and handling 3DS. How do you normalize these into a single interface that your checkout component talks to?\n- What is a \"payment method types\" configuration, and how do you design a frontend data model that is PSP-agnostic — capable of expressing \"card,\" \"bank transfer,\" \"wallet,\" and \"buy now pay later\" without encoding PSP-specific field names or token formats?\n- How do you handle the case where your provider abstraction layer must support PSPs that have fundamentally different authentication flows — e.g., Stripe's embedded iframe model vs. Adyen's full-page redirect for certain payment methods?\n- What are the risks of building a \"thin shim\" abstraction vs. a \"rich unified API\" abstraction over multiple PSPs? Where does each approach break down in practice?\n- How do you design the error model for a PSP abstraction layer? Stripe error codes differ from Adyen result codes, which differ from Braintree transaction statuses. How do you normalize these into a set of frontend-actionable error categories without losing the PSP-specific detail your support team needs?\n- How would you approach lazy-loading PSP SDKs so that Stripe.js is only loaded when Stripe is the selected provider, and Adyen's SDK is only loaded when Adyen is selected — while keeping the time-to-interactive acceptable?\n\n### Deep\n\n- You are building a multi-PSP checkout where Stripe handles cards, PayPal handles its own wallet flow, and Klarna handles BNPL — all on the same checkout page. Each SDK wants to mount its own UI components into your DOM. Describe the component mounting strategy, the event communication model between each third-party component and your React state, and how you ensure that only one payment method's UI is \"active\" at a time without leaking event listeners or iframe references.\n- Design the frontend architecture for a payment platform that must support provider failover: if Stripe returns a 5xx during `confirmCardPayment`, you want to retry the same charge attempt through Adyen within 2 seconds, without the user knowing a provider switch occurred. What constraints does this place on how you construct the PaymentIntent server-side, how you pass the client token to the frontend, and what the abstraction layer's retry logic looks like? Where does this approach fundamentally break down and require server-side coordination instead?\n- You are tasked with migrating a checkout from Braintree to Stripe over 6 months, with a gradual rollout. Both SDKs must be active simultaneously during the migration. Walk through: how you load both SDKs without doubling blocking script weight, how you route specific user cohorts to each provider (feature flag, A/B test, or deterministic hash), how you ensure your analytics can compare success rates across both providers, and how you define \"migration complete\" from a frontend perspective.\n\n---\n\n*Generated June 2026 — covers Stripe, Adyen, Braintree, PayPal, and general PSP patterns.*\n","numLines":206,"startLine":1,"totalLines":206}}}
