{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_019ntGt24mEcgNk1gLgzwWZc","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"en\">\n3\t<head>\n4\t  <meta charset=\"UTF-8\">\n5\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n6\t  <title>Claude Frontend System — Interactive Architecture</title>\n7\t  <meta name=\"description\" content=\"Interactive architecture map covering all 10 Claude-style AI chat frontend system design prep sections.\">\n8\t  <style>\n9\t    :root {\n10\t      --bg: #0f1219;\n11\t      --surface: #171c28;\n12\t      --surface2: #1e2536;\n13\t      --text: #e8ecf4;\n14\t      --muted: #8b95a8;\n15\t      --border: #2d3548;\n16\t      --accent: #c97840;\n17\t      --accent-soft: rgba(201, 120, 64, 0.15);\n18\t      --ui: #5b9bd5;\n19\t      --client: #70ad47;\n20\t      --transport: #ffc000;\n21\t      --api: #9966cc;\n22\t      --provider: #ed7d31;\n23\t      --data: #4472c4;\n24\t      --security: #e74c3c;\n25\t      --shadow: 0 8px 32px rgba(0,0,0,.35);\n26\t    }\n27\t    @media (prefers-color-scheme: light) {\n28\t      :root {\n29\t        --bg: #f4f2ef;\n30\t        --surface: #fff;\n31\t        --surface2: #faf8f5;\n32\t        --text: #1a1d26;\n33\t        --muted: #5c6370;\n34\t        --border: #e2e6ed;\n35\t        --accent: #b85c28;\n36\t        --accent-soft: rgba(184, 92, 40, 0.1);\n37\t        --shadow: 0 4px 20px rgba(0,0,0,.08);\n38\t      }\n39\t    }\n40\t    *, *::before, *::after { box-sizing: border-box; }\n41\t    html, body { height: 100%; margin: 0; }\n42\t    body {\n43\t      font-family: \"Segoe UI\", system-ui, -apple-system, sans-serif;\n44\t      background: var(--bg);\n45\t      color: var(--text);\n46\t      overflow: hidden;\n47\t    }\n48\t    .app {\n49\t      display: grid;\n50\t      grid-template-columns: 280px 1fr 340px;\n51\t      grid-template-rows: auto 1fr;\n52\t      height: 100vh;\n53\t    }\n54\t    header {\n55\t      grid-column: 1 / -1;\n56\t      display: flex;\n57\t      align-items: center;\n58\t      gap: 1rem;\n59\t      padding: 0.75rem 1.25rem;\n60\t      border-bottom: 1px solid var(--border);\n61\t      background: var(--surface);\n62\t    }\n63\t    header h1 {\n64\t      font-size: 1rem;\n65\t      font-weight: 700;\n66\t      margin: 0;\n67\t      letter-spacing: -0.02em;\n68\t    }\n69\t    header p { margin: 0; font-size: 0.8125rem; color: var(--muted); }\n70\t    .header-links { margin-left: auto; display: flex; gap: 0.75rem; font-size: 0.8125rem; }\n71\t    .header-links a { color: var(--accent); text-decoration: none; }\n72\t    .header-links a:hover { text-decoration: underline; }\n73\t\n74\t    .sidebar {\n75\t      border-right: 1px solid var(--border);\n76\t      background: var(--surface);\n77\t      overflow-y: auto;\n78\t      padding: 1rem;\n79\t    }\n80\t    .sidebar h2 {\n81\t      font-size: 0.6875rem;\n82\t      text-transform: uppercase;\n83\t      letter-spacing: 0.06em;\n84\t      color: var(--muted);\n85\t      margin: 0 0 0.5rem;\n86\t    }\n87\t    .sidebar section { margin-bottom: 1.25rem; }\n88\t    .filter-group { display: flex; flex-wrap: wrap; gap: 0.35rem; }\n89\t    .chip {\n90\t      font-size: 0.75rem;\n91\t      padding: 0.25rem 0.55rem;\n92\t      border-radius: 999px;\n93\t      border: 1px solid var(--border);\n94\t      background: var(--surface2);\n95\t      color: var(--muted);\n96\t      cursor: pointer;\n97\t      user-select: none;\n98\t      transition: all 0.15s;\n99\t    }\n100\t    .chip:hover { border-color: var(--accent); color: var(--text); }\n101\t    .chip.active { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }\n102\t    .chip.layer-ui.active { border-color: var(--ui); color: var(--ui); background: rgba(91,155,213,.12); }\n103\t    .chip.layer-client.active { border-color: var(--client); color: var(--client); background: rgba(112,173,71,.12); }\n104\t    .chip.layer-transport.active { border-color: var(--transport); color: #b8860b; background: rgba(255,192,0,.12); }\n105\t    .chip.layer-api.active { border-color: var(--api); color: var(--api); background: rgba(153,102,204,.12); }\n106\t    .chip.layer-provider.active { border-color: var(--provider); color: var(--provider); background: rgba(237,125,49,.12); }\n107\t    .chip.layer-data.active { border-color: var(--data); color: var(--data); background: rgba(68,114,196,.12); }\n108\t    .chip.layer-security.active { border-color: var(--security); color: var(--security); background: rgba(231,76,60,.12); }\n109\t\n110\t    select, input[type=\"search\"] {\n111\t      width: 100%;\n112\t      font: inherit;\n113\t      font-size: 0.8125rem;\n114\t      padding: 0.45rem 0.65rem;\n115\t      border: 1px solid var(--border);\n116\t      border-radius: 6px;\n117\t      background: var(--surface2);\n118\t      color: var(--text);\n119\t    }\n120\t    .flow-btn {\n121\t      display: block;\n122\t      width: 100%;\n123\t      text-align: left;\n124\t      font: inherit;\n125\t      font-size: 0.8125rem;\n126\t      padding: 0.5rem 0.65rem;\n127\t      margin-bottom: 0.35rem;\n128\t      border: 1px solid var(--border);\n129\t      border-radius: 6px;\n130\t      background: var(--surface2);\n131\t      color: var(--text);\n132\t      cursor: pointer;\n133\t    }\n134\t    .flow-btn:hover, .flow-btn.active { border-color: var(--accent); background: var(--accent-soft); }\n135\t    .legend { font-size: 0.75rem; color: var(--muted); line-height: 1.5; }\n136\t    .legend span { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; vertical-align: middle; }\n137\t\n138\t    .canvas-wrap {\n139\t      position: relative;\n140\t      overflow: hidden;\n141\t      background:\n142\t        radial-gradient(circle at 50% 0%, rgba(201,120,64,.06), transparent 50%),\n143\t        var(--bg);\n144\t    }\n145\t    .canvas-toolbar {\n146\t      position: absolute;\n147\t      top: 0.75rem;\n148\t      left: 0.75rem;\n149\t      z-index: 5;\n150\t      display: flex;\n151\t      gap: 0.35rem;\n152\t    }\n153\t    .canvas-toolbar button {\n154\t      font: inherit;\n155\t      font-size: 0.75rem;\n156\t      padding: 0.35rem 0.6rem;\n157\t      border: 1px solid var(--border);\n158\t      border-radius: 6px;\n159\t      background: var(--surface);\n160\t      color: var(--text);\n161\t      cursor: pointer;\n162\t    }\n163\t    .canvas {\n164\t      width: 100%;\n165\t      height: 100%;\n166\t      cursor: grab;\n167\t      touch-action: none;\n168\t    }\n169\t    .canvas.dragging { cursor: grabbing; }\n170\t    .diagram-inner {\n171\t      position: absolute;\n172\t      width: 1200px;\n173\t      height: 920px;\n174\t      transform-origin: 0 0;\n175\t    }\n176\t    svg.connections {\n177\t      position: absolute;\n178\t      inset: 0;\n179\t      width: 100%;\n180\t      height: 100%;\n181\t      pointer-events: none;\n182\t    }\n183\t    svg.connections line, svg.connections path {\n184\t      stroke: var(--border);\n185\t      stroke-width: 1.5;\n186\t      fill: none;\n187\t      transition: stroke 0.2s, stroke-width 0.2s;\n188\t    }\n189\t    svg.connections .flow-active {\n190\t      stroke: var(--accent);\n191\t      stroke-width: 2.5;\n192\t      stroke-dasharray: 8 4;\n193\t      animation: flowDash 0.6s linear infinite;\n194\t    }\n195\t    @keyframes flowDash { to { stroke-dashoffset: -12; } }\n196\t\n197\t    .lane {\n198\t      position: absolute;\n199\t      left: 12px;\n200\t      right: 12px;\n201\t      border: 1px dashed var(--border);\n202\t      border-radius: 10px;\n203\t      background: rgba(255,255,255,.02);\n204\t    }\n205\t    .lane-label {\n206\t      position: absolute;\n207\t      left: 12px;\n208\t      top: 6px;\n209\t      font-size: 0.6875rem;\n210\t      font-weight: 700;\n211\t      text-transform: uppercase;\n212\t      letter-spacing: 0.05em;\n213\t      color: var(--muted);\n214\t    }\n215\t    .node {\n216\t      position: absolute;\n217\t      width: 148px;\n218\t      padding: 0.55rem 0.65rem;\n219\t      border-radius: 8px;\n220\t      border: 2px solid var(--border);\n221\t      background: var(--surface);\n222\t      font-size: 0.75rem;\n223\t      line-height: 1.35;\n224\t      cursor: pointer;\n225\t      transition: transform 0.15s, box-shadow 0.15s, opacity 0.2s, border-color 0.15s;\n226\t      box-shadow: var(--shadow);\n227\t    }\n228\t    .node:hover { transform: translateY(-2px); z-index: 10; }\n229\t    .node.selected { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); z-index: 11; }\n230\t    .node.dimmed { opacity: 0.2; pointer-events: none; }\n231\t    .node.highlight { border-color: var(--accent); animation: pulse 1s ease infinite; }\n232\t    @keyframes pulse { 50% { box-shadow: 0 0 0 6px var(--accent-soft); } }\n233\t    .node-title { font-weight: 700; margin-bottom: 0.15rem; }\n234\t    .node-sub { font-size: 0.6875rem; color: var(--muted); }\n235\t    .node-tags { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 0.35rem; }\n236\t    .node-tag {\n237\t      font-size: 0.5625rem;\n238\t      padding: 1px 4px;\n239\t      border-radius: 3px;\n240\t      background: var(--surface2);\n241\t      color: var(--muted);\n242\t    }\n243\t    .node[data-layer=\"ui\"] { border-left: 4px solid var(--ui); }\n244\t    .node[data-layer=\"client\"] { border-left: 4px solid var(--client); }\n245\t    .node[data-layer=\"transport\"] { border-left: 4px solid var(--transport); }\n246\t    .node[data-layer=\"api\"] { border-left: 4px solid var(--api); }\n247\t    .node[data-layer=\"provider\"] { border-left: 4px solid var(--provider); }\n248\t    .node[data-layer=\"data\"] { border-left: 4px solid var(--data); }\n249\t    .node[data-layer=\"security\"] { border-left: 4px solid var(--security); }\n250\t\n251\t    .detail {\n252\t      border-left: 1px solid var(--border);\n253\t      background: var(--surface);\n254\t      overflow-y: auto;\n255\t      padding: 1.25rem;\n256\t    }\n257\t    .detail-empty { color: var(--muted); font-size: 0.9375rem; margin-top: 2rem; text-align: center; }\n258\t    .detail h2 { font-size: 1.125rem; margin: 0 0 0.35rem; }\n259\t    .detail .layer-badge {\n260\t      display: inline-block;\n261\t      font-size: 0.6875rem;\n262\t      font-weight: 700;\n263\t      text-transform: uppercase;\n264\t      padding: 0.2rem 0.5rem;\n265\t      border-radius: 4px;\n266\t      margin-bottom: 0.75rem;\n267\t    }\n268\t    .detail p { font-size: 0.875rem; line-height: 1.6; color: var(--muted); margin: 0 0 0.75rem; }\n269\t    .detail h3 { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent); margin: 1rem 0 0.4rem; }\n270\t    .detail ul { margin: 0; padding-left: 1.1rem; font-size: 0.8125rem; line-height: 1.55; }\n271\t    .detail li { margin-bottom: 0.3rem; }\n272\t    .section-links { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; }\n273\t    .section-links a {\n274\t      font-size: 0.75rem;\n275\t      padding: 0.25rem 0.5rem;\n276\t      border-radius: 4px;\n277\t      background: var(--accent-soft);\n278\t      color: var(--accent);\n279\t      text-decoration: none;\n280\t    }\n281\t    .section-links a:hover { text-decoration: underline; }\n282\t    .flow-step {\n283\t      font-size: 0.8125rem;\n284\t      padding: 0.5rem 0.65rem;\n285\t      margin-bottom: 0.35rem;\n286\t      border-left: 3px solid var(--border);\n287\t      background: var(--surface2);\n288\t      border-radius: 0 6px 6px 0;\n289\t    }\n290\t    .flow-step.active { border-left-color: var(--accent); background: var(--accent-soft); }\n291\t\n292\t    @media (max-width: 1100px) {\n293\t      .app { grid-template-columns: 1fr; grid-template-rows: auto auto 1fr auto; overflow-y: auto; height: auto; min-height: 100vh; }\n294\t      body { overflow: auto; }\n295\t      .sidebar { border-right: none; border-bottom: 1px solid var(--border); max-height: none; }\n296\t      .canvas-wrap { min-height: 520px; }\n297\t      .detail { border-left: none; border-top: 1px solid var(--border); max-height: none; }\n298\t    }\n299\t  </style>\n300\t</head>\n301\t<body>\n302\t  <div class=\"app\">\n303\t    <header>\n304\t      <div>\n305\t        <h1>Claude Frontend System Architecture</h1>\n306\t        <p>Interactive map · all 10 prep sections</p>\n307\t      </div>\n308\t      <div class=\"header-links\">\n309\t        <a href=\"answers-html/index.html\">Answer pages</a>\n310\t        <a href=\"Claude-design-doc.md\">Question bank</a>\n311\t      </div>\n312\t    </header>\n313\t\n314\t    <aside class=\"sidebar\">\n315\t      <section>\n316\t        <h2>Search</h2>\n317\t        <input type=\"search\" id=\"search\" placeholder=\"Filter nodes…\" autocomplete=\"off\">\n318\t      </section>\n319\t      <section>\n320\t        <h2>Layer filter</h2>\n321\t        <div class=\"filter-group\" id=\"layerFilters\"></div>\n322\t      </section>\n323\t      <section>\n324\t        <h2>Section filter</h2>\n325\t        <div class=\"filter-group\" id=\"sectionFilters\"></div>\n326\t      </section>\n327\t      <section>\n328\t        <h2>Walk a flow</h2>\n329\t        <div id=\"flowButtons\"></div>\n330\t      </section>\n331\t      <section>\n332\t        <h2>Legend</h2>\n333\t        <div class=\"legend\" id=\"legend\"></div>\n334\t      </section>\n335\t    </aside>\n336\t\n337\t    <main class=\"canvas-wrap\">\n338\t      <div class=\"canvas-toolbar\">\n339\t        <button type=\"button\" id=\"zoomIn\">+</button>\n340\t        <button type=\"button\" id=\"zoomOut\">−</button>\n341\t        <button type=\"button\" id=\"resetView\">Reset view</button>\n342\t      </div>\n343\t      <div class=\"canvas\" id=\"canvas\">\n344\t        <div class=\"diagram-inner\" id=\"diagram\">\n345\t          <svg class=\"connections\" id=\"connections\"></svg>\n346\t        </div>\n347\t      </div>\n348\t    </main>\n349\t\n350\t    <aside class=\"detail\" id=\"detailPanel\">\n351\t      <div class=\"detail-empty\" id=\"detailEmpty\">\n352\t        Click a node or run a flow walkthrough to see details, interview angles, and links to answer sections.\n353\t      </div>\n354\t      <div id=\"detailContent\" hidden></div>\n355\t    </aside>\n356\t  </div>\n357\t\n358\t  <script>\n359\t    const LAYERS = {\n360\t      ui: { label: 'UI Surfaces', color: 'var(--ui)' },\n361\t      client: { label: 'Client State', color: 'var(--client)' },\n362\t      transport: { label: 'Transport', color: 'var(--transport)' },\n363\t      api: { label: 'API / BFF', color: 'var(--api)' },\n364\t      provider: { label: 'Providers', color: 'var(--provider)' },\n365\t      data: { label: 'Data', color: 'var(--data)' },\n366\t      security: { label: 'Security', color: 'var(--security)' }\n367\t    };\n368\t\n369\t    const SECTIONS = [\n370\t      { id: '01', name: 'Streaming', file: 'answers-html/01-streaming-real-time-rendering.html' },\n371\t      { id: '02', name: 'State', file: 'answers-html/02-conversation-state-management.html' },\n372\t      { id: '03', name: 'MCP Tools', file: 'answers-html/03-mcp-tool-use-ui.html' },\n373\t      { id: '04', name: 'Artifacts', file: 'answers-html/04-artifacts-sandboxed-rendering.html' },\n374\t      { id: '05', name: 'Performance', file: 'answers-html/05-performance-scalability.html' },\n375\t      { id: '06', name: 'Auth', file: 'answers-html/06-auth-security-multitenancy.html' },\n376\t      { id: '07', name: 'Resilience', file: 'answers-html/07-offline-resilience-error-handling.html' },\n377\t      { id: '08', name: 'Input', file: 'answers-html/08-input-multimodal-ux.html' },\n378\t      { id: '09', name: 'Providers', file: 'answers-html/09-api-design-provider-abstraction.html' },\n379\t      { id: '10', name: 'Killer Qs', file: 'answers-html/10-killer-questions.html' }\n380\t    ];\n381\t\n382\t    const NODES = [\n383\t      { id: 'composer', layer: 'ui', x: 40, y: 48, title: 'Composer', sub: 'Input · attach · send/stop', sections: ['02','08','01'],\n384\t        desc: 'Captures drafts, multimodal attachments, slash commands, token estimate, and stop-generation. Never part of the committed message graph until send.',\n385\t        bullets: ['Auto-grow textarea with max height cap', 'AttachmentController: drag/drop/paste', 'AbortController wired to active SSE stream', 'Draft in localStorage/IDB, separate from graph'],\n386\t        questions: ['Draft persistence', 'Mixed multimodal send', 'Stop generation chain'] },\n387\t      { id: 'sidebar', layer: 'ui', x: 220, y: 48, title: 'Sidebar', sub: '10k convos · search', sections: ['05','10','02'],\n388\t        desc: 'Virtualized conversation list with metadata-only rows, cursor pagination, FTS search, optimistic rename/delete.',\n389\t        bullets: ['Prefetch on hover/focus', 'IndexedDB cache ~1000 rows', 'No message bodies in list rows'],\n390\t        questions: ['Sidebar at 10k scale', 'Preload next conversation'] },\n391\t      { id: 'msgList', layer: 'ui', x: 400, y: 48, title: 'Message List', sub: 'Virtualized thread', sections: ['01','05','02'],\n392\t        desc: 'Windowed view of active branch path. Pinned streaming row, scroll anchoring, dynamic height cache.',\n393\t        bullets: ['Only visible rows in DOM', 'isPinnedToBottom + \"New messages ↓\"', 'Stable keys per markdown block'],\n394\t        questions: ['Virtualize 500 messages', 'Scroll anchoring', 'Avoid full-list re-render'] },\n395\t      { id: 'streamBubble', layer: 'ui', x: 580, y: 48, title: 'Streaming Bubble', sub: 'Typing → tokens → done', sections: ['01'],\n396\t        desc: 'Single assistant slot: pending indicator crossfades into incremental markdown render.',\n397\t        bullets: ['rAF batching decouples network from paint', 'Incomplete fence/table state machines', 'Backpressure: pause read(), shed highlight'],\n398\t        questions: ['Layout thrash', 'Token throttle', 'Open code fence', 'Backpressure'] },\n399\t      { id: 'toolPills', layer: 'ui', x: 760, y: 48, title: 'Tool Pills', sub: 'HITL · chains · audit', sections: ['03','06','10'],\n400\t        desc: 'Per tool_use_id UI: loading → success/error, confirm card for destructive actions, trust/egress disclosure.',\n401\t        bullets: ['UI lock + idempotency key on confirm', 'Multi-step stepper in one turn', 'Activity drawer for audit trail'],\n402\t        questions: ['Double confirm in 200ms', 'tool_result as user role', 'MCP OAuth expiry'] },\n403\t      { id: 'artifactPanel', layer: 'ui', x: 940, y: 48, title: 'Artifact Panel', sub: 'Editor + preview', sections: ['04','10'],\n404\t        desc: 'Code editor + sandboxed live preview with version timeline, diff, revert.',\n405\t        bullets: ['Heartbeat detects infinite render loops', 'postMessage bridge host ↔ iframe', 'Debounced compile in worker'],\n406\t        questions: ['iframe sandbox + CSP', 'Infinite loop detection', 'Version/revert'] },\n407\t\n408\t      { id: 'convStore', layer: 'client', x: 120, y: 200, title: 'Conversation Store', sub: 'Graph view + active leaf', sections: ['02','10'],\n409\t        desc: 'Client mirror of server message tree. Derives linear visible path via active_leaf_id. Optimistic nodes with clientRequestId.',\n410\t        bullets: ['Edit = sibling fork, not overwrite', 'Branch switcher swaps active leaf', 'BroadcastChannel for multi-tab'],\n411\t        questions: ['Edit message N', 'Branching model', 'Multi-tab sync'] },\n412\t      { id: 'streamPipeline', layer: 'client', x: 320, y: 200, title: 'Streaming Pipeline', sub: 'Buffer · parse · patch', sections: ['01','05'],\n413\t        desc: 'Token ring buffer → rAF flush → incremental markdown blocks → stable DOM patch.',\n414\t        bullets: ['Refs hold hot string; state commits per frame', 'startTransition for responsiveness', 'Canonical string never dropped on shed work'],\n415\t        questions: ['Buffer interval', 'Debounced markdown parse', 'Render lag metrics'] },\n416\t      { id: 'branchAsm', layer: 'client', x: 520, y: 200, title: 'Branch Assembler', sub: 'pathToLeaf · token budget', sections: ['02','09','10'],\n417\t        desc: 'Walk active leaf to root, reverse to chronological order, apply context window truncate/summarize policy.',\n418\t        bullets: ['Preview on client; server authoritative', 'IR blocks compiled at adapter boundary', 'Summary nodes on long threads'],\n419\t        questions: ['Context window strategy', 'Reassemble after edit', 'Provider normalization'] },\n420\t      { id: 'outbox', layer: 'client', x: 720, y: 200, title: 'Outbox Queue', sub: 'Offline · IDB', sections: ['07','02'],\n421\t        desc: 'IndexedDB queue for offline sends and upload resume. FIFO drain on reconnect with Idempotency-Key.',\n422\t        bullets: ['Optimistic user bubble while queued', 'Leader election across tabs', 'Conflict on conversation_revision mismatch'],\n423\t        questions: ['Offline message queue', 'Stream drop recovery'] },\n424\t      { id: 'clientCache', layer: 'client', x: 920, y: 200, title: 'Client Cache', sub: 'Memory · IDB · RQ', sections: ['05','02'],\n425\t        desc: 'Three-tier: in-memory hot set, IndexedDB pages, React Query server sync. Org-scoped namespaces.',\n426\t        bullets: ['LRU ~20 threads in memory', 'Paginated history prepend on scroll-up', 'Height cache for virtualizer'],\n427\t        questions: ['Caching strategy', 'Lazy-load history'] },\n428\t\n429\t      { id: 'rest', layer: 'transport', x: 200, y: 352, title: 'REST', sub: 'CRUD · control · upload', sections: ['01','07','08','03'],\n430\t        desc: 'Send message, cancel, tool execute, paginated history, presigned uploads, search, share links.',\n431\t        bullets: ['Idempotency-Key on destructive ops', 'PATCH events + revision vector', 'parseApiError taxonomy'],\n432\t        questions: ['Cancel/retry control plane', 'Error taxonomy', 'Chunked uploads'] },\n433\t      { id: 'sse', layer: 'transport', x: 480, y: 352, title: 'SSE Stream', sub: 'Token · tool · status', sections: ['01','07','09'],\n434\t        desc: 'Default LLM output transport. fetch + ReadableStream or EventSource with Last-Event-ID reconnect.',\n435\t        bullets: ['AbortController closes HTTP → stops billing', 'Resume via generation_id + cursor', 'Exponential backoff on drop'],\n436\t        questions: ['SSE vs WebSocket', 'Stream drop at token 400', 'Resume stream'] },\n437\t      { id: 'ws', layer: 'transport', x: 760, y: 352, title: 'WebSocket', sub: 'Optional sync', sections: ['01','02'],\n438\t        desc: 'Bidirectional session sync, presence, async job updates. Hybrid: SSE tokens + WS patches.',\n439\t        bullets: ['Manual heartbeat + resume protocol', 'Use when client→server churn is high', 'Not default for pure completion streams'],\n440\t        questions: ['When to pick WS', 'Multi-tab fan-out'] },\n441\t\n442\t      { id: 'gateway', layer: 'api', x: 80, y: 504, title: 'API Gateway', sub: 'Auth · rate limit', sections: ['06','07'],\n443\t        desc: 'JWT validation, org context, rate limiting, request shedding, stream lease issuance.',\n444\t        bullets: ['ctx from claims never body user_id', 'session_version invalidates access tokens', 'Stream lease for in-flight generation'],\n445\t        questions: ['JWT + RLS scoping', 'Session invalidate mid-stream', 'Rate limit UX'] },\n446\t      { id: 'convSvc', layer: 'api', x: 280, y: 504, title: 'Conversation Svc', sub: 'Graph CRUD · share', sections: ['02','06','10'],\n447\t        desc: 'Message nodes tree, branching edits, public share tokens, conversation search metadata.',\n448\t        bullets: ['message_nodes: parent_id, status, branch_label', 'active_leaf_id on conversation row', '409 on concurrent generation'],\n449\t        questions: ['Edit creates sibling node', 'Public share permissions', 'Org isolation'] },\n450\t      { id: 'streamGw', layer: 'api', x: 480, y: 504, title: 'Stream Gateway', sub: 'Checkpoints · replay', sections: ['01','07','10'],\n451\t        desc: 'Inference proxy: streams normalized events, writes partial checkpoints, supports resume cursor.',\n452\t        bullets: ['Debounced DB checkpoint every N tokens', 'Redis event buffer for Last-Event-ID', 'generation_id correlates client/server'],\n453\t        questions: ['Partial persist mid-stream', 'Continue from prefix fallback'] },\n454\t      { id: 'orchestrator', layer: 'api', x: 680, y: 504, title: 'Agent Orchestrator', sub: 'Tool loop · tasks', sections: ['03','09','10'],\n455\t        desc: 'Runs LLM ↔ tool cycles, agent task state machine, pause/resume on auth_required.',\n456\t        bullets: ['pending_tool_executions table', 'paused_auth + SSE auth_required event', 'Resume with same idempotency key'],\n457\t        questions: ['Multi-step tool chains', 'MCP OAuth mid-task', '529 fallback routing'] },\n458\t      { id: 'mcpClient', layer: 'api', x: 880, y: 504, title: 'MCP Client', sub: 'Policy · egress · audit', sections: ['03','06'],\n459\t        desc: 'Sandboxed tool execution with allowlisted egress, data minimization, immutable audit log.',\n460\t        bullets: ['Never pass full history to hostile MCP', 'Policy engine before network', 'Hashes in compliance log'],\n461\t        questions: ['Trust boundary UI', 'Malicious MCP exfiltration', 'Audit logging'] },\n462\t\n463\t      { id: 'irAdapter', layer: 'provider', x: 320, y: 656, title: 'IR + Adapters', sub: 'Anthropic · OpenAI · Gemini', sections: ['09','03'],\n464\t        desc: 'Internal representation compiled at boundary: system field vs message, tool_use vs tool role, thinking blocks.',\n465\t        bullets: ['CapabilityResolver not if(provider) in UI', 'NormalizedStreamEvent reducer', 'Model alias → pinned model_id per message'],\n466\t        questions: ['Normalize history', 'Streaming adapter', 'Extended thinking flag'] },\n467\t      { id: 'llm', layer: 'provider', x: 560, y: 656, title: 'LLM APIs', sub: 'Primary + fallback', sections: ['09','01','07'],\n468\t        desc: 'Provider SDK streams with 529 backoff, capability-matched fallback, cost estimation pre-send.',\n469\t        bullets: ['No silent stitch of two models in one bubble', 'Mid-stream: surface interrupted', 'Token counter per provider shape'],\n470\t        questions: ['Model fallback', 'Cost estimate', 'Model deprecation'] },\n471\t      { id: 'mcpServers', layer: 'provider', x: 800, y: 656, title: 'MCP Servers', sub: 'Slack · Calendar · …', sections: ['03','06'],\n472\t        desc: 'Third-party integrations via OAuth token vault (server-only refresh with serialized lock).',\n473\t        bullets: ['OAuth refresh mid-conversation', 'Scoped args only', 'Timeout → pill failed + user retry/skip'],\n474\t        questions: ['OAuth token refresh', 'Tool timeout 30s'] },\n475\t\n476\t      { id: 'pgGraph', layer: 'data', x: 160, y: 808, title: 'Postgres Graph', sub: 'Nodes · branches · ACL', sections: ['02','06','10'],\n477\t        desc: 'Source of truth: message tree, memberships, shares, agent_tasks, artifact version chain.',\n478\t        bullets: ['RLS: org_id + owner_user_id', 'status: streaming → interrupted → final', 'Unique generation_id constraint'],\n479\t        questions: ['Tree vs linear array', 'Partial message in DB'] },\n480\t      { id: 'redis', layer: 'data', x: 400, y: 808, title: 'Redis', sub: 'Locks · replay · dedup', sections: ['07','03','02'],\n481\t        desc: 'Active branch pointer, SSE replay buffer, idempotency TTL, session denylist, stream checkpoints.',\n482\t        bullets: ['(user_id, idempotency_key) dedup', 'Short TTL event buffer', 'Refresh lock for OAuth'],\n483\t        questions: ['Double booking dedup', 'SSE reconnect replay'] },\n484\t      { id: 'objectStore', layer: 'data', x: 640, y: 808, title: 'Object Storage', sub: 'Uploads · artifacts', sections: ['08','04','06'],\n485\t        desc: 'Quarantine bucket, presigned multipart uploads, attachment CDN URLs, WORM audit exports.',\n486\t        bullets: ['Magic-byte sniff at ingest', 'Stable fileId refs not base64 in state', 'Per-org S3 prefix'],\n487\t        questions: ['Large file uploads', 'PDF extract pipeline', 'Upload quarantine'] },\n488\t      { id: 'indexedDb', layer: 'data', x: 880, y: 808, title: 'IndexedDB', sub: 'Client pages · outbox', sections: ['05','07','02'],\n489\t        desc: 'Browser persistence: message pages, sidebar cache, offline outbox, upload session resume.',\n490\t        bullets: ['Key: userId:orgId:conversationId', 'BroadcastChannel invalidation', 'Partial stream on disconnect'],\n491\t        questions: ['Client cache tiers', 'Offline replay'] },\n492\t\n493\t      { id: 'authBoundary', layer: 'security', x: 40, y: 656, title: 'Auth Boundary', sub: 'JWT · org · RLS', sections: ['06'],\n494\t        desc: 'Every request derives tenant from token/key record. Defense in depth: API filter + Postgres RLS.',\n495\t        bullets: ['Multi-org context switch aborts streams', 'API key org bound, scopes enforced', 'Share token capability URL'],\n496\t        questions: ['Org switching', 'API key scope', 'Public link permissions'] },\n497\t      { id: 'sandbox', layer: 'security', x: 1040, y: 200, title: 'Sandbox iframe', sub: 'CSP · postMessage', sections: ['04','10'],\n498\t        desc: 'Origin-isolated artifact preview. allow-scripts only, no allow-same-origin. Heartbeat + render budget.',\n499\t        bullets: ['CDN imports via vendor proxy or block', 'Kill iframe on RENDER_LOOP', 'Replace iframe as recovery unit'],\n500\t        questions: ['Sandbox attacks prevented', 'Infinite loop in React artifact'] },\n501\t      { id: 'contentFw', layer: 'security', x: 1040, y: 504, title: 'Content Firewall', sub: 'Upload · inject', sections: ['06','08'],\n502\t        desc: 'Extracted upload text wrapped as untrusted document; never in system role. Instruction pattern stripping.',\n503\t        bullets: ['Client extract vs server OCR for PDF', 'Prompt injection via hidden PDF text', 'Page/token caps'],\n504\t        questions: ['Prompt injection uploads', 'PDF handling'] }\n505\t    ];\n506\t\n507\t    const EDGES = [\n508\t      ['composer', 'rest', 'POST send'],\n509\t      ['composer', 'sse', 'Abort stop'],\n510\t      ['composer', 'convStore', 'optimistic user node'],\n511\t      ['sidebar', 'clientCache', 'prefetch metadata'],\n512\t      ['msgList', 'streamPipeline', 'render commits'],\n513\t      ['streamBubble', 'streamPipeline', 'token buffer'],\n514\t      ['toolPills', 'rest', 'confirm execute'],\n515\t      ['artifactPanel', 'sandbox', 'postMessage'],\n516\t      ['convStore', 'branchAsm', 'active leaf path'],\n517\t      ['convStore', 'outbox', 'offline queue'],\n518\t      ['streamPipeline', 'convStore', 'finalize assistant'],\n519\t      ['streamPipeline', 'artifactPanel', 'code fence deltas'],\n520\t      ['branchAsm', 'rest', 'compiled context preview'],\n521\t      ['clientCache', 'msgList', 'history pages'],\n522\t      ['rest', 'gateway', 'HTTP'],\n523\t      ['sse', 'streamGw', 'token stream'],\n524\t      ['ws', 'convSvc', 'patch events'],\n525\t      ['gateway', 'convSvc', 'authorized'],\n526\t      ['convSvc', 'pgGraph', 'persist graph'],\n527\t      ['streamGw', 'orchestrator', 'generation job'],\n528\t      ['streamGw', 'sse', 'normalized events'],\n529\t      ['orchestrator', 'irAdapter', 'IR compile'],\n530\t      ['orchestrator', 'mcpClient', 'tool_use'],\n531\t      ['mcpClient', 'mcpServers', 'scoped call'],\n532\t      ['mcpClient', 'convStore', 'tool_result blocks'],\n533\t      ['irAdapter', 'llm', 'provider SDK'],\n534\t      ['streamGw', 'redis', 'checkpoints'],\n535\t      ['mcpClient', 'redis', 'idempotency'],\n536\t      ['rest', 'objectStore', 'presign upload'],\n537\t      ['clientCache', 'indexedDb', 'hydrate'],\n538\t      ['authBoundary', 'gateway', 'ctx claims'],\n539\t      ['contentFw', 'orchestrator', 'sanitized blocks'],\n540\t      ['objectStore', 'contentFw', 'extract pipeline']\n541\t    ];\n542\t\n543\t    const FLOWS = {\n544\t      send: {\n545\t        title: 'Send message → stream response',\n546\t        steps: [\n547\t          { nodes: ['composer'], text: 'User sends; optimistic user node appended to store' },\n548\t          { nodes: ['rest', 'gateway', 'convSvc'], text: 'POST validated; graph node persisted; generation leased' },\n549\t          { nodes: ['streamGw', 'orchestrator', 'irAdapter', 'llm'], text: 'IR compiled; provider streams tokens' },\n550\t          { nodes: ['sse', 'streamPipeline', 'streamBubble'], text: 'SSE chunks batched via rAF into markdown blocks' },\n551\t          { nodes: ['convStore', 'pgGraph'], text: 'Stream end finalizes assistant node in graph + DB' }\n552\t        ],\n553\t        sections: ['01','02','09']\n554\t      },\n555\t      tool: {\n556\t        title: 'Tool call → HITL confirm → resume',\n557\t        steps: [\n558\t          { nodes: ['llm', 'orchestrator'], text: 'Model emits tool_use block in stream' },\n559\t          { nodes: ['toolPills', 'streamBubble'], text: 'Pill shows loading; sensitive tools show confirm + egress disclosure' },\n560\t          { nodes: ['rest', 'mcpClient', 'redis'], text: 'Confirm POST with idempotency key; dedup if double-clicked' },\n561\t          { nodes: ['mcpServers'], text: 'MCP executes with minimized args; audit log written' },\n562\t          { nodes: ['convStore', 'orchestrator', 'llm'], text: 'tool_result as user blocks; model turn resumes' }\n563\t        ],\n564\t        sections: ['03','10']\n565\t      },\n566\t      drop: {\n567\t        title: 'Stream drops at token 400/1000',\n568\t        steps: [\n569\t          { nodes: ['sse', 'streamPipeline'], text: 'TCP close; partial text retained in bubble (never blank)' },\n570\t          { nodes: ['streamGw', 'redis', 'pgGraph'], text: 'Checkpoint row status=interrupted; cursor persisted' },\n571\t          { nodes: ['streamBubble', 'rest'], text: 'UI: Continue (resume cursor) | Retry (idempotent regen)' },\n572\t          { nodes: ['outbox', 'indexedDb'], text: 'Client mirrors partial in IDB for refresh survival' }\n573\t        ],\n574\t        sections: ['07','10','01']\n575\t      },\n576\t      edit: {\n577\t        title: 'Edit message N → branch regen',\n578\t        steps: [\n579\t          { nodes: ['composer', 'convStore'], text: 'Edit creates sibling node under same parent (fork, not overwrite)' },\n580\t          { nodes: ['branchAsm'], text: 'New active_leaf; path reassembled with token budget' },\n581\t          { nodes: ['convSvc', 'pgGraph'], text: 'Server persists branch; returns branch_generation/version' },\n582\t          { nodes: ['msgList'], text: 'UI swaps visible path; optional branch switcher keeps both subtrees' }\n583\t        ],\n584\t        sections: ['02','10']\n585\t      },\n586\t      artifact: {\n587\t        title: 'Artifact stream → sandbox preview',\n588\t        steps: [\n589\t          { nodes: ['streamPipeline', 'artifactPanel'], text: 'Code fence deltas debounced in worker' },\n590\t          { nodes: ['sandbox'], text: 'postMessage ARTIFACT_UPDATE; CSP-isolated render' },\n591\t          { nodes: ['sandbox'], text: 'Heartbeat detects infinite loop → kill iframe → error UI' },\n592\t          { nodes: ['pgGraph', 'objectStore'], text: 'Version chain persisted; revert-to-N available' }\n593\t        ],\n594\t        sections: ['04','10']\n595\t      },\n596\t      auth: {\n597\t        title: 'MCP OAuth expires mid-agent-task',\n598\t        steps: [\n599\t          { nodes: ['mcpClient', 'mcpServers'], text: '401 on tool call; orchestrator → paused_auth' },\n600\t          { nodes: ['sse', 'toolPills'], text: 'SSE auth_required event; UI modal Reconnect Slack' },\n601\t          { nodes: ['orchestrator', 'redis'], text: 'Task checkpoint: completed_steps[], pending_tool_call' },\n602\t          { nodes: ['rest', 'mcpClient'], text: 'After OAuth: POST /tasks/:id/resume same idempotency key' }\n603\t        ],\n604\t        sections: ['03','06','10']\n605\t      }\n606\t    };\n607\t\n608\t    const LANES = [\n609\t      { y: 28, h: 130, label: 'UI Surfaces', layer: 'ui' },\n610\t      { y: 178, h: 130, label: 'Client State & Pipelines', layer: 'client' },\n611\t      { y: 330, h: 110, label: 'Transport', layer: 'transport' },\n612\t      { y: 482, h: 130, label: 'API / BFF', layer: 'api' },\n613\t      { y: 634, h: 110, label: 'Providers', layer: 'provider' },\n614\t      { y: 786, h: 110, label: 'Data', layer: 'data' }\n615\t    ];\n616\t\n617\t    let scale = 0.82;\n618\t    let panX = 20;\n619\t    let panY = 10;\n620\t    let activeLayers = new Set(Object.keys(LAYERS));\n621\t    let activeSections = new Set(SECTIONS.map(s => s.id));\n622\t    let selectedNode = null;\n623\t    let activeFlow = null;\n624\t    let flowStepIndex = -1;\n625\t    let searchQuery = '';\n626\t\n627\t    const diagram = document.getElementById('diagram');\n628\t    const connections = document.getElementById('connections');\n629\t    const canvas = document.getElementById('canvas');\n630\t\n631\t    function nodeCenter(id) {\n632\t      const n = NODES.find(x => x.id === id);\n633\t      return { x: n.x + 74, y: n.y + 28 };\n634\t    }\n635\t\n636\t    function renderLanes() {\n637\t      diagram.querySelectorAll('.lane').forEach(el => el.remove());\n638\t      LANES.forEach(lane => {\n639\t        if (!activeLayers.has(lane.layer) && lane.layer !== 'security') return;\n640\t        const el = document.createElement('div');\n641\t        el.className = 'lane';\n642\t        el.style.top = lane.y + 'px';\n643\t        el.style.height = lane.h + 'px';\n644\t        el.innerHTML = `<span class=\"lane-label\">${lane.label}</span>`;\n645\t        diagram.insertBefore(el, connections);\n646\t      });\n647\t    }\n648\t\n649\t    function nodeMatchesFilters(n) {\n650\t      const q = searchQuery.toLowerCase();\n651\t      const matchSearch = !q || n.title.toLowerCase().includes(q) || n.sub.toLowerCase().includes(q) || n.desc.toLowerCase().includes(q);\n652\t      const matchLayer = activeLayers.has(n.layer);\n653\t      const matchSection = n.sections.some(s => activeSections.has(s));\n654\t      return matchSearch && matchLayer && matchSection;\n655\t    }\n656\t\n657\t    function getActiveFlowStep() {\n658\t      if (!activeFlow || flowStepIndex < 0) return null;\n659\t      return FLOWS[activeFlow]?.steps[flowStepIndex] || null;\n660\t    }\n661\t\n662\t    function getFlowHighlightEdges(stepNodes) {\n663\t      const inStep = new Set(stepNodes);\n664\t      return EDGES.filter(([from, to]) => inStep.has(from) && inStep.has(to));\n665\t    }\n666\t\n667\t    function renderNodes() {\n668\t      diagram.querySelectorAll('.node').forEach(el => el.remove());\n669\t      const flowStep = getActiveFlowStep();\n670\t      const flowNodeIds = flowStep ? new Set(flowStep.nodes) : null;\n671\t\n672\t      NODES.forEach(n => {\n673\t        const el = document.createElement('div');\n674\t        el.className = 'node';\n675\t        el.dataset.id = n.id;\n676\t        el.dataset.layer = n.layer;\n677\t        el.style.left = n.x + 'px';\n678\t        el.style.top = n.y + 'px';\n679\t\n680\t        const visible = nodeMatchesFilters(n);\n681\t        if (!visible) {\n682\t          el.classList.add('dimmed');\n683\t        } else if (flowNodeIds && !flowNodeIds.has(n.id)) {\n684\t          el.classList.add('dimmed');\n685\t        }\n686\t\n687\t        if (flowNodeIds && flowNodeIds.has(n.id) && visible) {\n688\t          el.classList.add('highlight');\n689\t        }\n690\t        if (selectedNode === n.id) el.classList.add('selected');\n691\t\n692\t        el.innerHTML = `\n693\t          <div class=\"node-title\">${n.title}</div>\n694\t          <div class=\"node-sub\">${n.sub}</div>\n695\t          <div class=\"node-tags\">${n.sections.map(s => `<span class=\"node-tag\">${s}</span>`).join('')}</div>\n696\t        `;\n697\t        el.addEventListener('click', () => selectNode(n.id));\n698\t        diagram.appendChild(el);\n699\t      });\n700\t    }\n701\t\n702\t    function renderEdges(highlightPairs) {\n703\t      const hl = new Set((highlightPairs || []).map(p => p.join('|')));\n704\t      connections.innerHTML = '';\n705\t      EDGES.forEach(([from, to, label]) => {\n706\t        const a = nodeCenter(from);\n707\t        const b = nodeCenter(to);\n708\t        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n709\t        line.setAttribute('x1', a.x);\n710\t        line.setAttribute('y1', a.y);\n711\t        line.setAttribute('x2', b.x);\n712\t        line.setAttribute('y2', b.y);\n713\t        if (hl.has(from + '|' + to) || hl.has(to + '|' + from)) line.classList.add('flow-active');\n714\t        const nf = NODES.find(n => n.id === from);\n715\t        const nt = NODES.find(n => n.id === to);\n716\t        const visible = nf && nt &&\n717\t          activeLayers.has(nf.layer) && activeLayers.has(nt.layer) &&\n718\t          nf.sections.some(s => activeSections.has(s)) &&\n719\t          nt.sections.some(s => activeSections.has(s));\n720\t        if (!visible) line.style.opacity = '0.15';\n721\t        connections.appendChild(line);\n722\t      });\n723\t    }\n724\t\n725\t    function applyTransform() {\n726\t      diagram.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;\n727\t    }\n728\t\n729\t    function selectNode(id) {\n730\t      selectedNode = id;\n731\t      activeFlow = null;\n732\t      flowStepIndex = -1;\n733\t      document.querySelectorAll('.flow-btn').forEach(b => b.classList.remove('active'));\n734\t      renderNodes();\n735\t      renderEdges();\n736\t      showNodeDetail(id);\n737\t    }\n738\t\n739\t    function showNodeDetail(id) {\n740\t      const n = NODES.find(x => x.id === id);\n741\t      if (!n) return;\n742\t      document.getElementById('detailEmpty').hidden = true;\n743\t      const content = document.getElementById('detailContent');\n744\t      content.hidden = false;\n745\t      const layer = LAYERS[n.layer];\n746\t      content.innerHTML = `\n747\t        <span class=\"layer-badge\" style=\"background:${layer.color}22;color:${layer.color}\">${layer.label}</span>\n748\t        <h2>${n.title}</h2>\n749\t        <p>${n.desc}</p>\n750\t        <h3>Key mechanisms</h3>\n751\t        <ul>${n.bullets.map(b => `<li>${b}</li>`).join('')}</ul>\n752\t        <h3>Interview questions</h3>\n753\t        <ul>${n.questions.map(q => `<li>${q}</li>`).join('')}</ul>\n754\t        <h3>Prep sections</h3>\n755\t        <div class=\"section-links\">${n.sections.map(s => {\n756\t          const sec = SECTIONS.find(x => x.id === s);\n757\t          return sec ? `<a href=\"${sec.file}\">§${s} ${sec.name}</a>` : '';\n758\t        }).join('')}</div>\n759\t      `;\n760\t    }\n761\t\n762\t    function showFlowDetail(flowKey) {\n763\t      const flow = FLOWS[flowKey];\n764\t      document.getElementById('detailEmpty').hidden = true;\n765\t      const content = document.getElementById('detailContent');\n766\t      content.hidden = false;\n767\t      content.innerHTML = `\n768\t        <h2>${flow.title}</h2>\n769\t        <p>Click steps to highlight nodes on the diagram.</p>\n770\t        <h3>Steps</h3>\n771\t        ${flow.steps.map((step, i) => `\n772\t          <div class=\"flow-step${i === flowStepIndex ? ' active' : ''}\" data-step=\"${i}\">\n773\t            <strong>${i + 1}.</strong> ${step.text}\n774\t          </div>\n775\t        `).join('')}\n776\t        <h3>Related sections</h3>\n777\t        <div class=\"section-links\">${flow.sections.map(s => {\n778\t          const sec = SECTIONS.find(x => x.id === s);\n779\t          return sec ? `<a href=\"${sec.file}\">§${s} ${sec.name}</a>` : '';\n780\t        }).join('')}</div>\n781\t      `;\n782\t      content.querySelectorAll('.flow-step').forEach(el => {\n783\t        el.addEventListener('click', () => {\n784\t          const idx = Number(el.dataset.step);\n785\t          highlightFlowStep(flowKey, idx);\n786\t          showFlowDetail(flowKey);\n787\t        });\n788\t      });\n789\t    }\n790\t\n791\t    function highlightFlowStep(flowKey, stepIndex) {\n792\t      const flow = FLOWS[flowKey];\n793\t      const step = flow?.steps[stepIndex];\n794\t      if (!step) return;\n795\t      activeFlow = flowKey;\n796\t      flowStepIndex = stepIndex;\n797\t      renderNodes();\n798\t      renderEdges(getFlowHighlightEdges(step.nodes));\n799\t    }\n800\t\n801\t    function startFlow(flowKey) {\n802\t      activeFlow = flowKey;\n803\t      flowStepIndex = 0;\n804\t      selectedNode = null;\n805\t      document.querySelectorAll('.flow-btn').forEach(b => b.classList.toggle('active', b.dataset.flow === flowKey));\n806\t      renderNodes();\n807\t      highlightFlowStep(flowKey, 0);\n808\t      showFlowDetail(flowKey);\n809\t    }\n810\t\n811\t    function buildFilters() {\n812\t      const lf = document.getElementById('layerFilters');\n813\t      Object.entries(LAYERS).forEach(([key, val]) => {\n814\t        const chip = document.createElement('button');\n815\t        chip.type = 'button';\n816\t        chip.className = `chip layer-${key} active`;\n817\t        chip.textContent = val.label;\n818\t        chip.addEventListener('click', () => {\n819\t          if (activeLayers.has(key)) { activeLayers.delete(key); chip.classList.remove('active'); }\n820\t          else { activeLayers.add(key); chip.classList.add('active'); }\n821\t          refresh();\n822\t        });\n823\t        lf.appendChild(chip);\n824\t      });\n825\t\n826\t      const sf = document.getElementById('sectionFilters');\n827\t      SECTIONS.forEach(sec => {\n828\t        const chip = document.createElement('button');\n829\t        chip.type = 'button';\n830\t        chip.className = 'chip active';\n831\t        chip.textContent = sec.id + ' ' + sec.name;\n832\t        chip.addEventListener('click', () => {\n833\t          if (activeSections.has(sec.id)) { activeSections.delete(sec.id); chip.classList.remove('active'); }\n834\t          else { activeSections.add(sec.id); chip.classList.add('active'); }\n835\t          refresh();\n836\t        });\n837\t        sf.appendChild(chip);\n838\t      });\n839\t\n840\t      const fb = document.getElementById('flowButtons');\n841\t      Object.entries(FLOWS).forEach(([key, flow]) => {\n842\t        const btn = document.createElement('button');\n843\t        btn.type = 'button';\n844\t        btn.className = 'flow-btn';\n845\t        btn.dataset.flow = key;\n846\t        btn.textContent = flow.title;\n847\t        btn.addEventListener('click', () => startFlow(key));\n848\t        fb.appendChild(btn);\n849\t      });\n850\t\n851\t      const legend = document.getElementById('legend');\n852\t      Object.entries(LAYERS).forEach(([key, val]) => {\n853\t        legend.innerHTML += `<div><span style=\"background:${val.color}\"></span>${val.label}</div>`;\n854\t      });\n855\t    }\n856\t\n857\t    function refresh() {\n858\t      renderLanes();\n859\t      renderNodes();\n860\t      if (activeFlow && flowStepIndex >= 0) {\n861\t        const step = FLOWS[activeFlow]?.steps[flowStepIndex];\n862\t        renderEdges(step ? getFlowHighlightEdges(step.nodes) : []);\n863\t      } else {\n864\t        renderEdges();\n865\t      }\n866\t    }\n867\t\n868\t    document.getElementById('search').addEventListener('input', e => {\n869\t      searchQuery = e.target.value;\n870\t      refresh();\n871\t    });\n872\t\n873\t    document.getElementById('zoomIn').addEventListener('click', () => { scale = Math.min(1.4, scale + 0.1); applyTransform(); });\n874\t    document.getElementById('zoomOut').addEventListener('click', () => { scale = Math.max(0.45, scale - 0.1); applyTransform(); });\n875\t    document.getElementById('resetView').addEventListener('click', () => { scale = 0.82; panX = 20; panY = 10; applyTransform(); });\n876\t\n877\t    let dragging = false;\n878\t    let lastX = 0, lastY = 0;\n879\t    canvas.addEventListener('pointerdown', e => {\n880\t      if (e.target.closest('.node')) return;\n881\t      dragging = true;\n882\t      lastX = e.clientX;\n883\t      lastY = e.clientY;\n884\t      canvas.classList.add('dragging');\n885\t      canvas.setPointerCapture(e.pointerId);\n886\t    });\n887\t    canvas.addEventListener('pointermove', e => {\n888\t      if (!dragging) return;\n889\t      panX += e.clientX - lastX;\n890\t      panY += e.clientY - lastY;\n891\t      lastX = e.clientX;\n892\t      lastY = e.clientY;\n893\t      applyTransform();\n894\t    });\n895\t    canvas.addEventListener('pointerup', () => { dragging = false; canvas.classList.remove('dragging'); });\n896\t\n897\t    buildFilters();\n898\t    renderLanes();\n899\t    renderNodes();\n900\t    renderEdges();\n901\t    applyTransform();\n902\t  </script>\n903\t</body>\n904\t</html>\n905\t"}]},"parent_tool_use_id":"toolu_vrtx_01QWuQsjTa7gpjn1M7GDVLBQ","session_id":"7ab96e0e-8f96-4d88-841c-51b1b26eaeef","uuid":"952ad8b5-9915-46d5-a45e-8497d2ae37bb","timestamp":"2026-06-20T19:46:50.208Z","subagent_type":"general-purpose","task_description":"Build payments-system frontend architecture HTML"}
{"type":"system","subtype":"task_progress","task_id":"a277c11aa399dd126","tool_use_id":"toolu_vrtx_01QWuQsjTa7gpjn1M7GDVLBQ","description":"Writing system-design/payments-system/payments-system-frontend-architecture.html","subagent_type":"general-purpose","usage":{"total_tokens":45406,"tool_uses":3,"duration_ms":252179},"last_tool_name":"Write","uuid":"b9df55aa-b5e2-4669-ac17-58157cb23e5f","session_id":"7ab96e0e-8f96-4d88-841c-51b1b26eaeef"}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_vrtx_01KHDWHMV4CTnVfiy2kxaH6m","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_vrtx_0178vJCEGwbse583DiqCP1Vy","name":"Write","input":{"file_path":"/Users/sarthakagarwal/Desktop/projects/prep/system-design/payments-system/payments-system-frontend-architecture.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Payments System Frontend Architecture</title>\n  <meta name=\"description\" content=\"Interactive architecture map covering all 9 payments system frontend design prep sections (Stripe/Adyen/Braintree style).\">\n  <style>\n    :root {\n      --bg: #0f1219;\n      --surface: #171c28;\n      --surface2: #1e2536;\n      --text: #e8ecf4;\n      --muted: #8b95a8;\n      --border: #2d3548;\n      --accent: #c97840;\n      --accent-soft: rgba(201, 120, 64, 0.15);\n      --ui: #5b9bd5;\n      --client: #70ad47;\n      --transport: #ffc000;\n      --api: #9966cc;\n      --provider: #ed7d31;\n      --data: #4472c4;\n      --security: #e74c3c;\n      --shadow: 0 8px 32px rgba(0,0,0,.35);\n    }\n    @media (prefers-color-scheme: light) {\n      :root {\n        --bg: #f4f2ef;\n        --surface: #fff;\n        --surface2: #faf8f5;\n        --text: #1a1d26;\n        --muted: #5c6370;\n        --border: #e2e6ed;\n        --accent: #b85c28;\n        --accent-soft: rgba(184, 92, 40, 0.1);\n        --shadow: 0 4px 20px rgba(0,0,0,.08);\n      }\n    }\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body {\n      font-family: \"Segoe UI\", system-ui, -apple-system, sans-serif;\n      background: var(--bg);\n      color: var(--text);\n      overflow: hidden;\n    }\n    .app {\n      display: grid;\n      grid-template-columns: 280px 1fr 340px;\n      grid-template-rows: auto 1fr;\n      height: 100vh;\n    }\n    header {\n      grid-column: 1 / -1;\n      display: flex;\n      align-items: center;\n      gap: 1rem;\n      padding: 0.75rem 1.25rem;\n      border-bottom: 1px solid var(--border);\n      background: var(--surface);\n    }\n    header h1 {\n      font-size: 1rem;\n      font-weight: 700;\n      margin: 0;\n      letter-spacing: -0.02em;\n    }\n    header p { margin: 0; font-size: 0.8125rem; color: var(--muted); }\n    .header-links { margin-left: auto; display: flex; gap: 0.75rem; font-size: 0.8125rem; }\n    .header-links a { color: var(--accent); text-decoration: none; }\n    .header-links a:hover { text-decoration: underline; }\n\n    .sidebar {\n      border-right: 1px solid var(--border);\n      background: var(--surface);\n      overflow-y: auto;\n      padding: 1rem;\n    }\n    .sidebar h2 {\n      font-size: 0.6875rem;\n      text-transform: uppercase;\n      letter-spacing: 0.06em;\n      color: var(--muted);\n      margin: 0 0 0.5rem;\n    }\n    .sidebar section { margin-bottom: 1.25rem; }\n    .filter-group { display: flex; flex-wrap: wrap; gap: 0.35rem; }\n    .chip {\n      font-size: 0.75rem;\n      padding: 0.25rem 0.55rem;\n      border-radius: 999px;\n      border: 1px solid var(--border);\n      background: var(--surface2);\n      color: var(--muted);\n      cursor: pointer;\n      user-select: none;\n      transition: all 0.15s;\n    }\n    .chip:hover { border-color: var(--accent); color: var(--text); }\n    .chip.active { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }\n    .chip.layer-ui.active { border-color: var(--ui); color: var(--ui); background: rgba(91,155,213,.12); }\n    .chip.layer-client.active { border-color: var(--client); color: var(--client); background: rgba(112,173,71,.12); }\n    .chip.layer-transport.active { border-color: var(--transport); color: #b8860b; background: rgba(255,192,0,.12); }\n    .chip.layer-api.active { border-color: var(--api); color: var(--api); background: rgba(153,102,204,.12); }\n    .chip.layer-provider.active { border-color: var(--provider); color: var(--provider); background: rgba(237,125,49,.12); }\n    .chip.layer-data.active { border-color: var(--data); color: var(--data); background: rgba(68,114,196,.12); }\n    .chip.layer-security.active { border-color: var(--security); color: var(--security); background: rgba(231,76,60,.12); }\n\n    select, input[type=\"search\"] {\n      width: 100%;\n      font: inherit;\n      font-size: 0.8125rem;\n      padding: 0.45rem 0.65rem;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      background: var(--surface2);\n      color: var(--text);\n    }\n    .flow-btn {\n      display: block;\n      width: 100%;\n      text-align: left;\n      font: inherit;\n      font-size: 0.8125rem;\n      padding: 0.5rem 0.65rem;\n      margin-bottom: 0.35rem;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      background: var(--surface2);\n      color: var(--text);\n      cursor: pointer;\n    }\n    .flow-btn:hover, .flow-btn.active { border-color: var(--accent); background: var(--accent-soft); }\n    .legend { font-size: 0.75rem; color: var(--muted); line-height: 1.5; }\n    .legend span { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; vertical-align: middle; }\n\n    .canvas-wrap {\n      position: relative;\n      overflow: hidden;\n      background:\n        radial-gradient(circle at 50% 0%, rgba(201,120,64,.06), transparent 50%),\n        var(--bg);\n    }\n    .canvas-toolbar {\n      position: absolute;\n      top: 0.75rem;\n      left: 0.75rem;\n      z-index: 5;\n      display: flex;\n      gap: 0.35rem;\n    }\n    .canvas-toolbar button {\n      font: inherit;\n      font-size: 0.75rem;\n      padding: 0.35rem 0.6rem;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      background: var(--surface);\n      color: var(--text);\n      cursor: pointer;\n    }\n    .canvas {\n      width: 100%;\n      height: 100%;\n      cursor: grab;\n      touch-action: none;\n    }\n    .canvas.dragging { cursor: grabbing; }\n    .diagram-inner {\n      position: absolute;\n      width: 1200px;\n      height: 920px;\n      transform-origin: 0 0;\n    }\n    svg.connections {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      pointer-events: none;\n    }\n    svg.connections line, svg.connections path {\n      stroke: var(--border);\n      stroke-width: 1.5;\n      fill: none;\n      transition: stroke 0.2s, stroke-width 0.2s;\n    }\n    svg.connections .flow-active {\n      stroke: var(--accent);\n      stroke-width: 2.5;\n      stroke-dasharray: 8 4;\n      animation: flowDash 0.6s linear infinite;\n    }\n    @keyframes flowDash { to { stroke-dashoffset: -12; } }\n\n    .lane {\n      position: absolute;\n      left: 12px;\n      right: 12px;\n      border: 1px dashed var(--border);\n      border-radius: 10px;\n      background: rgba(255,255,255,.02);\n    }\n    .lane-label {\n      position: absolute;\n      left: 12px;\n      top: 6px;\n      font-size: 0.6875rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      color: var(--muted);\n    }\n    .node {\n      position: absolute;\n      width: 148px;\n      padding: 0.55rem 0.65rem;\n      border-radius: 8px;\n      border: 2px solid var(--border);\n      background: var(--surface);\n      font-size: 0.75rem;\n      line-height: 1.35;\n      cursor: pointer;\n      transition: transform 0.15s, box-shadow 0.15s, opacity 0.2s, border-color 0.15s;\n      box-shadow: var(--shadow);\n    }\n    .node:hover { transform: translateY(-2px); z-index: 10; }\n    .node.selected { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); z-index: 11; }\n    .node.dimmed { opacity: 0.2; pointer-events: none; }\n    .node.highlight { border-color: var(--accent); animation: pulse 1s ease infinite; }\n    @keyframes pulse { 50% { box-shadow: 0 0 0 6px var(--accent-soft); } }\n    .node-title { font-weight: 700; margin-bottom: 0.15rem; }\n    .node-sub { font-size: 0.6875rem; color: var(--muted); }\n    .node-tags { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 0.35rem; }\n    .node-tag {\n      font-size: 0.5625rem;\n      padding: 1px 4px;\n      border-radius: 3px;\n      background: var(--surface2);\n      color: var(--muted);\n    }\n    .node[data-layer=\"ui\"] { border-left: 4px solid var(--ui); }\n    .node[data-layer=\"client\"] { border-left: 4px solid var(--client); }\n    .node[data-layer=\"transport\"] { border-left: 4px solid var(--transport); }\n    .node[data-layer=\"api\"] { border-left: 4px solid var(--api); }\n    .node[data-layer=\"provider\"] { border-left: 4px solid var(--provider); }\n    .node[data-layer=\"data\"] { border-left: 4px solid var(--data); }\n    .node[data-layer=\"security\"] { border-left: 4px solid var(--security); }\n\n    .detail {\n      border-left: 1px solid var(--border);\n      background: var(--surface);\n      overflow-y: auto;\n      padding: 1.25rem;\n    }\n    .detail-empty { color: var(--muted); font-size: 0.9375rem; margin-top: 2rem; text-align: center; }\n    .detail h2 { font-size: 1.125rem; margin: 0 0 0.35rem; }\n    .detail .layer-badge {\n      display: inline-block;\n      font-size: 0.6875rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      padding: 0.2rem 0.5rem;\n      border-radius: 4px;\n      margin-bottom: 0.75rem;\n    }\n    .detail p { font-size: 0.875rem; line-height: 1.6; color: var(--muted); margin: 0 0 0.75rem; }\n    .detail h3 { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent); margin: 1rem 0 0.4rem; }\n    .detail ul { margin: 0; padding-left: 1.1rem; font-size: 0.8125rem; line-height: 1.55; }\n    .detail li { margin-bottom: 0.3rem; }\n    .section-links { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; }\n    .section-links a {\n      font-size: 0.75rem;\n      padding: 0.25rem 0.5rem;\n      border-radius: 4px;\n      background: var(--accent-soft);\n      color: var(--accent);\n      text-decoration: none;\n    }\n    .section-links a:hover { text-decoration: underline; }\n    .flow-step {\n      font-size: 0.8125rem;\n      padding: 0.5rem 0.65rem;\n      margin-bottom: 0.35rem;\n      border-left: 3px solid var(--border);\n      background: var(--surface2);\n      border-radius: 0 6px 6px 0;\n    }\n    .flow-step.active { border-left-color: var(--accent); background: var(--accent-soft); }\n\n    @media (max-width: 1100px) {\n      .app { grid-template-columns: 1fr; grid-template-rows: auto auto 1fr auto; overflow-y: auto; height: auto; min-height: 100vh; }\n      body { overflow: auto; }\n      .sidebar { border-right: none; border-bottom: 1px solid var(--border); max-height: none; }\n      .canvas-wrap { min-height: 520px; }\n      .detail { border-left: none; border-top: 1px solid var(--border); max-height: none; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <header>\n      <div>\n        <h1>Payments System Frontend Architecture</h1>\n        <p>Interactive map · all 9 prep sections</p>\n      </div>\n      <div class=\"header-links\">\n        <a href=\"answers-html/index.html\">Answer pages</a>\n        <a href=\"payments-system-design-doc.md\">Design doc</a>\n      </div>\n    </header>\n\n    <aside class=\"sidebar\">\n      <section>\n        <h2>Search</h2>\n        <input type=\"search\" id=\"search\" placeholder=\"Filter nodes…\" autocomplete=\"off\">\n      </section>\n      <section>\n        <h2>Layer filter</h2>\n        <div class=\"filter-group\" id=\"layerFilters\"></div>\n      </section>\n      <section>\n        <h2>Section filter</h2>\n        <div class=\"filter-group\" id=\"sectionFilters\"></div>\n      </section>\n      <section>\n        <h2>Walk a flow</h2>\n        <div id=\"flowButtons\"></div>\n      </section>\n      <section>\n        <h2>Legend</h2>\n        <div class=\"legend\" id=\"legend\"></div>\n      </section>\n    </aside>\n\n    <main class=\"canvas-wrap\">\n      <div class=\"canvas-toolbar\">\n        <button type=\"button\" id=\"zoomIn\">+</button>\n        <button type=\"button\" id=\"zoomOut\">−</button>\n        <button type=\"button\" id=\"resetView\">Reset view</button>\n      </div>\n      <div class=\"canvas\" id=\"canvas\">\n        <div class=\"diagram-inner\" id=\"diagram\">\n          <svg class=\"connections\" id=\"connections\"></svg>\n        </div>\n      </div>\n    </main>\n\n    <aside class=\"detail\" id=\"detailPanel\">\n      <div class=\"detail-empty\" id=\"detailEmpty\">\n        Click a node or run a flow walkthrough to see details, interview angles, and links to answer sections.\n      </div>\n      <div id=\"detailContent\" hidden></div>\n    </aside>\n  </div>\n\n  <script>\n    const LAYERS = {\n      ui:        { label: 'UI Surfaces',           color: 'var(--ui)' },\n      client:    { label: 'Client State',          color: 'var(--client)' },\n      transport: { label: 'Transport',             color: 'var(--transport)' },\n      api:       { label: 'API / BFF',             color: 'var(--api)' },\n      provider:  { label: 'PSP Providers',         color: 'var(--provider)' },\n      data:      { label: 'Data',                  color: 'var(--data)' },\n      security:  { label: 'Security / PCI',        color: 'var(--security)' }\n    };\n\n    const SECTIONS = [\n      { id: '01', name: 'Checkout UX',    file: 'answers-html/01-checkout-flow-form-ux.html' },\n      { id: '02', name: 'PCI/Security',   file: 'answers-html/02-payment-security-pci-compliance.html' },\n      { id: '03', name: 'State/Lifecycle',file: 'answers-html/03-state-management-transaction-lifecycle.html' },\n      { id: '04', name: 'Real-Time',      file: 'answers-html/04-real-time-updates-webhooks.html' },\n      { id: '05', name: 'Performance',    file: 'answers-html/05-performance-core-web-vitals.html' },\n      { id: '06', name: 'Error Handling', file: 'answers-html/06-error-handling-resilience.html' },\n      { id: '07', name: 'i18n/l10n',      file: 'answers-html/07-internationalization-localization.html' },\n      { id: '08', name: 'Observability',  file: 'answers-html/08-observability-analytics.html' },\n      { id: '09', name: 'PSP Abstraction',file: 'answers-html/09-architecture-provider-abstraction.html' },\n    ];\n\n    const NODES = [\n      // ── UI Layer ──────────────────────────────────────────────────────────\n      {\n        id: 'checkoutForm', layer: 'ui', x: 40, y: 48,\n        title: 'Checkout Form', sub: 'Multi-step · card input · CTA',\n        sections: ['01','03','06'],\n        desc: 'Multi-step shell: cart → shipping → payment → confirmation. State machine drives step visibility and back-nav guards. Never allows step-skipping.',\n        bullets: [\n          'Step machine: pending|shipping|payment|processing|done',\n          'Hosted Fields or Elements injected in payment step',\n          'Back nav flushes sensitive field refs, not values',\n          'Disabled CTA + spinner on submission to prevent double-submit'\n        ],\n        questions: ['Multi-step state machine', 'Prevent step skipping', 'Back navigation + data preservation']\n      },\n      {\n        id: 'cardFields', layer: 'ui', x: 220, y: 48,\n        title: 'Card Input Fields', sub: 'Stripe Elements · iframe',\n        sections: ['01','02','05'],\n        desc: 'Cross-origin iframe from PSP. Parent page never touches raw PAN/CVV. BIN detection for card type icon. Appearance API for styling. CLS prevention via fixed-height placeholder.',\n        bullets: [\n          'postMessage bridge: parent ↔ iframe',\n          'CardNumberElement + ExpiryElement + CVCElement',\n          'Stripe appearance API — no direct CSS cross-origin',\n          'Fixed 48px container prevents layout shift (CLS)'\n        ],\n        questions: ['Cross-origin card field isolation', 'CLS prevention on iframe mount', 'BIN detection for card type']\n      },\n      {\n        id: 'orderSummary', layer: 'ui', x: 400, y: 48,\n        title: 'Order Summary', sub: 'Cart · tax · coupon sync',\n        sections: ['01','07'],\n        desc: 'Live-synced panel showing item totals, tax (inclusive/exclusive by locale), coupon discounts, and final charge amount. Never shows stale data during cart mutations.',\n        bullets: [\n          'Derived from server cart state — no client-side tax calculation',\n          'Tax-inclusive display for EU/AU locales',\n          'Coupon applied → revalidates server-side → re-renders',\n          'Currency formatted via Intl.NumberFormat with minor-unit conversion'\n        ],\n        questions: ['Tax-inclusive vs exclusive display', 'Cart sync without full-page reload', 'Currency formatting minor units']\n      },\n      {\n        id: 'paymentMethodSelector', layer: 'ui', x: 580, y: 48,\n        title: 'Payment Method Selector', sub: 'Card · wallet · BNPL · local',\n        sections: ['01','07','09'],\n        desc: 'Data-driven list of available payment methods filtered by country, currency, and cart value. Ranked by local preference (iDEAL first in NL). Each method mounts its own SDK component.',\n        bullets: [\n          'Config from server: [{type, psp, rank, logoUrl}]',\n          'Lazy-loads PSP SDK only when method selected',\n          'Hides methods incompatible with cart currency',\n          'Fallback to card-only if config unavailable'\n        ],\n        questions: ['Data-driven payment method ranking', 'Lazy PSP SDK loading', 'Hide incompatible methods']\n      },\n      {\n        id: 'confirmationScreen', layer: 'ui', x: 760, y: 48,\n        title: 'Confirmation Screen', sub: 'Success · pending · failed',\n        sections: ['03','04','06'],\n        desc: 'Terminal checkout UI. Three states: succeeded (immediate), processing (async — bank transfer/konbini), failed (retry or abandon). Must handle re-entry after navigation.',\n        bullets: [\n          'Reads payment_intent status on mount — not only redirect param',\n          'Processing state: polling or SSE until terminal',\n          'Re-entry: server re-fetches PaymentIntent and re-derives UI state',\n          'Beacon API logs abandonment if tab closes in processing'\n        ],\n        questions: ['Processing vs succeeded vs failed UI', 'Re-entry after browser close', 'Async payment method pending screen']\n      },\n      {\n        id: 'errorDisplay', layer: 'ui', x: 940, y: 48,\n        title: 'Error Display', sub: 'Decline · 3DS · network',\n        sections: ['06','03'],\n        desc: 'Hierarchical error surface: field-level inline errors, form-level decline banners, global network error toasts. Decline code allowlist maps to specific messaging; remainder → generic.',\n        bullets: [\n          \"insufficient_funds → 'Check available balance'\",\n          'stolen_card → generic (anti-enumeration)',\n          '3DS cancel → retry prompt, same PaymentIntent',\n          'Network timeout → ambiguous state banner'\n        ],\n        questions: ['Decline code allowlist vs generic messages', 'Anti-enumeration for fraud codes', 'Ambiguous timeout UX']\n      },\n\n      // ── Client Layer ──────────────────────────────────────────────────────\n      {\n        id: 'paymentIntentFSM', layer: 'client', x: 80, y: 200,\n        title: 'PaymentIntent FSM', sub: 'State machine · transitions',\n        sections: ['03','06'],\n        desc: 'Client-side mirror of PaymentIntent status. XState or equivalent drives UI rendering at each state. Guards prevent illegal transitions. Side effects trigger API calls or UI changes.',\n        bullets: [\n          'States: idle|submitting|requires_action|processing|succeeded|failed',\n          'Guards: no re-submit if processing',\n          'Entry actions: disable form, show spinner',\n          'Final states trigger analytics + redirect'\n        ],\n        questions: ['XState payment machine definition', 'Guard illegal transitions', 'Optimistic UI limits for payments']\n      },\n      {\n        id: 'idempotencyLayer', layer: 'client', x: 280, y: 200,\n        title: 'Idempotency Layer', sub: 'Keys · retry-safe',\n        sections: ['03','06'],\n        desc: 'Per-submission UUID keyed to (sessionId, cartId). Stored in sessionStorage. Passed as header on every payment confirm request. Server deduplicates on this key — safe to retry on timeout.',\n        bullets: [\n          'Key generated once per checkout session',\n          'Rotated only on explicit user retry action',\n          'sessionStorage prevents cross-tab key collision',\n          'Server: 409 if same key + different amount'\n        ],\n        questions: ['Idempotency key lifecycle', 'Safe retry on network timeout', 'Double-click prevention']\n      },\n      {\n        id: 'formStateCache', layer: 'client', x: 480, y: 200,\n        title: 'Form State Cache', sub: 'sessionStorage · no card data',\n        sections: ['01','03','07'],\n        desc: 'Non-sensitive form fields persisted to sessionStorage for refresh recovery: email, shipping address, selected payment method type. Raw card numbers NEVER persisted.',\n        bullets: [\n          'Stores: email, address, method type, step index',\n          'Never stores: PAN, expiry, CVV, client_secret',\n          'Restored on mount if cart session still valid',\n          'Cleared on successful payment or explicit abandon'\n        ],\n        questions: ['What to persist across refresh', 'Security boundary for sessionStorage', 'Multi-step re-entry recovery']\n      },\n      {\n        id: 'pspAdapterClient', layer: 'client', x: 680, y: 200,\n        title: 'PSP Adapter (Client)', sub: 'IPaymentProvider interface',\n        sections: ['09','02'],\n        desc: 'Client-side adapter pattern normalizing Stripe.js, Adyen Web Components, and Braintree Drop-in into a single IPaymentProvider interface. Checkout component never calls Stripe APIs directly.',\n        bullets: [\n          'mount(container) → returns cleanup fn',\n          'confirm(params) → Promise<{status, error}>',\n          'on(event, handler) → normalized events',\n          'CapabilityResolver: does provider support BNPL?'\n        ],\n        questions: ['IPaymentProvider adapter pattern', 'Normalize cross-PSP APIs', 'Capability resolution without UI conditionals']\n      },\n      {\n        id: 'analyticsLayer', layer: 'client', x: 880, y: 200,\n        title: 'Analytics Layer', sub: 'Funnel events · RUM',\n        sections: ['08','05'],\n        desc: 'Typed event bus for funnel instrumentation. PII/PAN sanitizer runs before every dispatch. Custom performance.mark for Stripe.js init and Elements mount. Beacon API for abandonment events.',\n        bullets: [\n          'checkout_step_viewed, payment_submitted, payment_succeeded',\n          'beforeSend hook strips card-shaped strings',\n          \"performance.mark('stripe-elements-mounted')\",\n          'Beacon API: checkout_abandoned on beforeunload'\n        ],\n        questions: ['Funnel event taxonomy', 'PAN sanitization before Sentry/GA', 'RUM marks for Elements load']\n      },\n\n      // ── Transport Layer ───────────────────────────────────────────────────\n      {\n        id: 'httpClient', layer: 'transport', x: 200, y: 352,\n        title: 'HTTP / REST', sub: 'PaymentIntent · cart · session',\n        sections: ['03','05','09'],\n        desc: 'Core API transport: create/confirm PaymentIntent, cart mutations, session management. Idempotency-Key header on all payment mutations. AbortController for in-flight request cancellation.',\n        bullets: [\n          'POST /payment-intents with idempotency key',\n          'Idempotency-Key: <uuid> on confirm requests',\n          'AbortController on tab close / step back',\n          'parseApiError → typed FrontendPaymentError'\n        ],\n        questions: ['AbortController for payment cancellation', 'Error taxonomy from API responses', 'Retry-safe HTTP methods']\n      },\n      {\n        id: 'sseTransport', layer: 'transport', x: 450, y: 352,\n        title: 'SSE / Polling', sub: 'Payment status push',\n        sections: ['04','06'],\n        desc: 'Server-Sent Events for real-time payment status delivery. Fallback to exponential-backoff polling when SSE is blocked (corporate proxies). Last-Event-ID for reconnection without missed events.',\n        bullets: [\n          'EventSource with Last-Event-ID on reconnect',\n          'Fallback: poll /payment-intents/:id every 2→4→8→16s',\n          \"Max 90s polling window then show 'check email' UI\",\n          'Dedup events by payment_intent_id + status'\n        ],\n        questions: ['SSE vs polling vs WebSocket for payment status', 'Reconnection with Last-Event-ID', 'Fallback polling backoff']\n      },\n      {\n        id: 'webhookBridge', layer: 'transport', x: 720, y: 352,\n        title: 'Webhook→Push Bridge', sub: 'Stripe → server → client',\n        sections: ['04','08'],\n        desc: 'Server-side bridge: Stripe webhook → verified → stored → pushed to frontend via SSE/WS. Ensures frontend update is consistent with DB state. Deduplicates on Stripe event ID.',\n        bullets: [\n          'Stripe-Signature verification before processing',\n          'payment_intent.succeeded → DB update → SSE push',\n          'Dedup on stripe_event_id (idempotent handler)',\n          'Stale UI correction: server always wins on conflict'\n        ],\n        questions: ['Webhook-to-frontend push architecture', 'Stripe-Signature verification', 'Frontend-server status conflict resolution']\n      },\n\n      // ── API / BFF Layer ───────────────────────────────────────────────────\n      {\n        id: 'checkoutBFF', layer: 'api', x: 80, y: 504,\n        title: 'Checkout BFF', sub: 'Cart · session · intent',\n        sections: ['03','05','09'],\n        desc: 'Backend-for-frontend: creates PaymentIntents, validates cart totals server-side, issues client_secret, and manages checkout sessions. Never exposed to raw card data.',\n        bullets: [\n          'POST /checkout/session → {clientSecret, cartSnapshot}',\n          'Cart total re-validated server-side before intent creation',\n          'client_secret scoped to session — never in DB unencrypted',\n          'Session cookie stores cart_id + user_id, not card data'\n        ],\n        questions: ['Client secret lifecycle and scoping', 'Server-side cart total validation', 'BFF vs direct Stripe API from frontend']\n      },\n      {\n        id: 'paymentIntentAPI', layer: 'api', x: 280, y: 504,\n        title: 'PaymentIntent API', sub: 'Create · confirm · capture',\n        sections: ['03','04','06'],\n        desc: 'Stripe PaymentIntent lifecycle management. Server creates with idempotency_key. Frontend confirms via Stripe.js (never sends raw card to your server). Webhook updates DB state on async events.',\n        bullets: [\n          'Idempotency key = (user_id, cart_id, attempt_number)',\n          'capture_method: manual for auth-only flows',\n          'status transitions: requires_payment_method → succeeded',\n          'Webhook handler: payment_intent.succeeded, .payment_failed'\n        ],\n        questions: ['PaymentIntent vs Charge API', 'Manual capture flow', 'Idempotency on server-side intent creation']\n      },\n      {\n        id: 'webhookReceiver', layer: 'api', x: 480, y: 504,\n        title: 'Webhook Receiver', sub: 'Stripe events · verify · dispatch',\n        sections: ['04','08'],\n        desc: 'Receives Stripe webhook events. Verifies Stripe-Signature with webhook signing secret. Idempotent handler keyed on event ID. Dispatches to domain handlers and triggers SSE push.',\n        bullets: [\n          'stripe.webhooks.constructEvent() verification',\n          'Idempotent: processed_events table with stripe_event_id',\n          'Dispatches: payment_intent.succeeded → order fulfillment',\n          'SSE push to connected frontend sessions after DB commit'\n        ],\n        questions: ['Stripe-Signature verification', 'Idempotent webhook processing', 'Order of operations: DB commit before SSE push']\n      },\n      {\n        id: 'pspRouter', layer: 'api', x: 680, y: 504,\n        title: 'PSP Router', sub: 'Stripe · Adyen · Braintree',\n        sections: ['09','06'],\n        desc: 'Server-side routing logic: selects PSP based on user country, payment method, cart value, and provider health. Returns provider-specific client token to frontend adapter. Handles provider failover.',\n        bullets: [\n          'Rules: EU cards → Adyen, US cards → Stripe, BNPL → Klarna',\n          'Health check: 5xx rate circuit breaker per provider',\n          'Failover: server creates new token on backup provider',\n          'Frontend never knows which PSP was switched to'\n        ],\n        questions: ['PSP routing rules', 'Provider failover architecture', 'Client token abstraction per PSP']\n      },\n      {\n        id: 'fraudRiskAPI', layer: 'api', x: 880, y: 504,\n        title: 'Fraud / Risk API', sub: 'Device signals · velocity',\n        sections: ['02','08'],\n        desc: 'Collects device fingerprint signals from frontend (Stripe Radar, own signals). Server-side velocity checks. Risk score influences 3DS trigger threshold and decline handling.',\n        bullets: [\n          'Stripe Radar rules: block if risk_score > threshold',\n          'Device signals: IP, user-agent, interaction timing',\n          'Velocity: 3+ failed attempts → require 3DS',\n          'Never expose raw risk score to frontend'\n        ],\n        questions: ['Device fingerprinting for fraud', '3DS trigger threshold', 'Risk signal collection without PCI scope expansion']\n      },\n\n      // ── Provider Layer ────────────────────────────────────────────────────\n      {\n        id: 'pciScope', layer: 'security', x: 40, y: 656,\n        title: 'PCI Scope Boundary', sub: 'SAQ A · hosted fields',\n        sections: ['02'],\n        desc: \"Hosted field iframe isolates raw card data in PSP's origin. Your page never handles PAN/CVV. Reduces compliance to PCI SAQ A (self-assessment). Any direct card handling = SAQ D.\",\n        bullets: [\n          'SAQ A: only if PSP hosts all card input fields',\n          'SAQ D: if any card data transits your server',\n          'CSP: script-src must allow js.stripe.com',\n          'No card data in network requests to your server'\n        ],\n        questions: ['PCI DSS scope reduction via hosted fields', 'SAQ A vs SAQ D', 'What CSP directives Stripe requires']\n      },\n      {\n        id: 'stripeSDK', layer: 'provider', x: 160, y: 656,\n        title: 'Stripe.js / Elements', sub: 'Card fields · confirmPayment',\n        sections: ['02','05','09'],\n        desc: 'Primary PSP SDK. Loads from js.stripe.com on every page (Stripe recommends this for fraud signals). Mounts card fields in cross-origin iframes. confirmCardPayment handles 3DS automatically.',\n        bullets: [\n          'Load on every page for Radar fraud signals',\n          'stripe.confirmCardPayment() → handles 3DS inline',\n          'Appearance API for cross-origin field styling',\n          'PaymentElement: unified UI for all Stripe methods'\n        ],\n        questions: ['Why load Stripe.js on every page', 'confirmCardPayment 3DS handling', 'Stripe vs manual card collection PCI scope']\n      },\n      {\n        id: 'adyenSDK', layer: 'provider', x: 380, y: 656,\n        title: 'Adyen Web Components', sub: 'Drop-in · redirect flows',\n        sections: ['09','06'],\n        desc: 'Alternative PSP SDK. Drop-in component or individual components. Some payment methods (SOFORT, some bank redirects) require full-page redirect rather than iframe. Requires server-side session token.',\n        bullets: [\n          'AdyenCheckout({session: serverToken})',\n          'Drop-in vs individual components',\n          '3DS handled via redirect or iframe per card issuer',\n          'resultCode normalization: Authorised/Refused/Error'\n        ],\n        questions: ['Adyen resultCode normalization', 'Full-page redirect vs iframe 3DS', 'Session token vs client key']\n      },\n      {\n        id: 'localPSPs', layer: 'provider', x: 600, y: 656,\n        title: 'Local Payment Methods', sub: 'iDEAL · Pix · BNPL · konbini',\n        sections: ['07','09','04'],\n        desc: 'Async local payment methods. iDEAL: bank redirect returns to success URL. Pix: QR code display with polling. Konbini: voucher code + async confirmation. BNPL: separate SDK flow.',\n        bullets: [\n          'iDEAL: redirect → webhook → SSE → confirmation',\n          'Pix: QR code + 30-min TTL polling',\n          'Konbini: voucher issued → async bank confirmation',\n          'Klarna/Afterpay: hosted page redirect'\n        ],\n        questions: ['Async payment method UX (processing state)', 'QR code polling lifecycle', 'Konbini voucher flow architecture']\n      },\n      {\n        id: 'walletAPIs', layer: 'provider', x: 820, y: 656,\n        title: 'Wallet APIs', sub: 'Apple Pay · Google Pay · Link',\n        sections: ['01','05','09'],\n        desc: 'Browser-native wallet APIs. PaymentRequest API unifies Apple Pay and Google Pay. Stripe Link for saved cross-merchant credentials. One-click checkout optimization.',\n        bullets: [\n          'canMakePayment() capability check before showing button',\n          'PaymentRequestButton mounts Stripe-hosted button',\n          'Apple Pay: merchant validation via server endpoint',\n          'Link: auto-fill returning users, expired method handling'\n        ],\n        questions: ['PaymentRequest API capability detection', 'Apple Pay merchant validation', 'Saved payment method UX handoff']\n      },\n\n      // ── Data Layer ────────────────────────────────────────────────────────\n      {\n        id: 'cartSessionDB', layer: 'data', x: 100, y: 808,\n        title: 'Cart / Session DB', sub: 'PostgreSQL · server-side cart',\n        sections: ['03','01'],\n        desc: 'Authoritative cart and checkout session state. Cart totals always re-validated here before PaymentIntent creation. Session stores non-sensitive checkout progress. RLS enforces user isolation.',\n        bullets: [\n          'cart_items: {product_id, quantity, price_snapshot}',\n          'checkout_sessions: {cart_id, user_id, step, expires_at}',\n          'Price snapshot at session creation — immutable',\n          'RLS: user can only read own cart and session'\n        ],\n        questions: ['Server-side cart total validation', 'Session expiry handling', 'Price snapshot immutability']\n      },\n      {\n        id: 'paymentRecordsDB', layer: 'data', x: 320, y: 808,\n        title: 'Payment Records DB', sub: 'PaymentIntents · orders · audit',\n        sections: ['03','04','08'],\n        desc: 'Stores PaymentIntent IDs, statuses, idempotency keys, and fulfilled orders. Source of truth for payment status. Processed_events table for webhook idempotency.',\n        bullets: [\n          'payment_intents: {id, stripe_pi_id, status, idempotency_key}',\n          'processed_events: {stripe_event_id} for dedup',\n          'orders: created only after succeeded status',\n          'Audit log: all status transitions timestamped'\n        ],\n        questions: ['Payment status source of truth', 'Idempotent webhook storage', 'Order creation timing (webhook vs confirmPayment return)']\n      },\n      {\n        id: 'sseEventBus', layer: 'data', x: 540, y: 808,\n        title: 'SSE Event Bus', sub: 'Redis pub/sub · replay',\n        sections: ['04','06'],\n        desc: 'Redis pub/sub for broadcasting payment events to connected SSE clients. Short-TTL event buffer for Last-Event-ID replay on reconnect. Keyed by user_id + payment_intent_id.',\n        bullets: [\n          'Publish after DB commit — not before',\n          'event_id: stripe_event_id for client dedup',\n          'Replay buffer: last 20 events per user, 5min TTL',\n          'SSE connections subscribe to user-scoped channel'\n        ],\n        questions: ['SSE event replay on reconnect', 'Ordering: DB commit before SSE push', 'Multi-tab SSE fan-out']\n      },\n      {\n        id: 'clientStorage', layer: 'data', x: 760, y: 808,\n        title: 'Client Storage', sub: 'sessionStorage · no card data',\n        sections: ['03','05'],\n        desc: 'Browser-side: sessionStorage for non-sensitive form state (step, email, address type). No localStorage for payment data (tab-persistent is risky). client_secret in memory variable only.',\n        bullets: [\n          'sessionStorage: step_index, email, shipping_address',\n          'In-memory only: client_secret, card element refs',\n          'Never persist: PAN, CVV, expiry in any browser storage',\n          'Clear all on payment success or session expiry'\n        ],\n        questions: ['client_secret storage security', 'sessionStorage vs localStorage for checkout', 'Clearing sensitive state after payment']\n      },\n\n      // ── Security (overlaid) ───────────────────────────────────────────────\n      {\n        id: 'cspLayer', layer: 'security', x: 1040, y: 504,\n        title: 'CSP / Clickjacking', sub: 'Content-Security-Policy',\n        sections: ['02','08'],\n        desc: \"CSP configured to allow Stripe domains. X-Frame-Options + frame-ancestors CSP prevents clickjacking of checkout page while allowing legitimate Stripe iframes to function.\",\n        bullets: [\n          \"script-src: 'self' https://js.stripe.com\",\n          'frame-src: https://js.stripe.com (for Elements iframes)',\n          \"frame-ancestors 'none': prevents your page being framed\",\n          'report-uri for CSP violation monitoring'\n        ],\n        questions: ['CSP for Stripe.js checkout page', 'X-Frame-Options vs frame-ancestors', 'CSP violation reporting']\n      }\n    ];\n\n    const EDGES = [\n      ['checkoutForm',          'cardFields',            'mounts iframe'],\n      ['checkoutForm',          'orderSummary',          'cart sync'],\n      ['checkoutForm',          'paymentMethodSelector', 'method selection'],\n      ['checkoutForm',          'confirmationScreen',    'on success'],\n      ['checkoutForm',          'errorDisplay',          'decline/error'],\n      ['cardFields',            'stripeSDK',             'Stripe Elements'],\n      ['paymentMethodSelector', 'pspAdapterClient',      'selected provider'],\n      ['paymentMethodSelector', 'localPSPs',             'iDEAL/Pix/konbini'],\n      ['paymentMethodSelector', 'walletAPIs',            'Apple/Google Pay'],\n      ['paymentIntentFSM',      'checkoutForm',          'drive UI state'],\n      ['paymentIntentFSM',      'idempotencyLayer',      'key on submit'],\n      ['formStateCache',        'checkoutForm',          'restore on mount'],\n      ['pspAdapterClient',      'stripeSDK',             'Stripe adapter'],\n      ['pspAdapterClient',      'adyenSDK',              'Adyen adapter'],\n      ['analyticsLayer',        'checkoutForm',          'funnel events'],\n      ['analyticsLayer',        'paymentIntentFSM',      'state transitions'],\n      ['httpClient',            'checkoutBFF',           'REST'],\n      ['httpClient',            'paymentIntentAPI',      'confirm intent'],\n      ['sseTransport',          'webhookBridge',         'status push'],\n      ['sseTransport',          'confirmationScreen',    'status update'],\n      ['webhookBridge',         'webhookReceiver',       'verified event'],\n      ['checkoutBFF',           'paymentIntentAPI',      'create intent'],\n      ['checkoutBFF',           'cartSessionDB',         'validate totals'],\n      ['paymentIntentAPI',      'pspRouter',             'route to PSP'],\n      ['pspRouter',             'stripeSDK',             'Stripe token'],\n      ['pspRouter',             'adyenSDK',              'Adyen session'],\n      ['webhookReceiver',       'paymentRecordsDB',      'update status'],\n      ['webhookReceiver',       'sseEventBus',           'publish event'],\n      ['fraudRiskAPI',          'paymentIntentAPI',      'risk score'],\n      ['stripeSDK',             'cardFields',            'iframe mount'],\n      ['sseEventBus',           'sseTransport',          'SSE push'],\n      ['paymentRecordsDB',      'paymentIntentAPI',      'status read'],\n      ['cartSessionDB',         'clientStorage',         'session ref'],\n      ['pciScope',              'cardFields',            'PCI boundary'],\n      ['cspLayer',              'checkoutBFF',           'header policy'],\n      ['idempotencyLayer',      'httpClient',            'header'],\n      ['formStateCache',        'clientStorage',         'sessionStorage'],\n      ['analyticsLayer',        'cspLayer',              'CSP report-uri'],\n    ];\n\n    const FLOWS = {\n      checkout: {\n        title: 'User submits payment → success',\n        steps: [\n          { nodes: ['checkoutForm', 'cardFields', 'paymentMethodSelector'], text: 'User fills card fields in Stripe iframe, selects method' },\n          { nodes: ['paymentIntentFSM', 'idempotencyLayer', 'httpClient'],  text: 'FSM transitions to submitting; idempotency key set; POST to BFF' },\n          { nodes: ['checkoutBFF', 'cartSessionDB', 'paymentIntentAPI'],    text: 'BFF re-validates cart; creates/retrieves PaymentIntent; returns client_secret' },\n          { nodes: ['pspAdapterClient', 'stripeSDK'],                       text: 'Adapter calls stripe.confirmCardPayment(clientSecret); Stripe handles 3DS if needed' },\n          { nodes: ['webhookReceiver', 'paymentRecordsDB', 'sseEventBus'],  text: 'Stripe webhook arrives; verified; DB updated; SSE event published' },\n          { nodes: ['sseTransport', 'confirmationScreen'],                   text: 'SSE push received; PaymentIntent FSM → succeeded; confirmation rendered' }\n        ],\n        sections: ['01','03','04']\n      },\n      decline: {\n        title: 'Card decline → smart retry UX',\n        steps: [\n          { nodes: ['stripeSDK', 'pspAdapterClient'],              text: 'confirmCardPayment returns error: card_declined, insufficient_funds' },\n          { nodes: ['paymentIntentFSM', 'idempotencyLayer'],        text: 'FSM transitions to failed; idempotency key rotated for retry' },\n          { nodes: ['errorDisplay', 'checkoutForm'],                text: 'Specific decline message shown; card fields cleared (not raw data — just focus reset)' },\n          { nodes: ['httpClient', 'paymentIntentAPI'],              text: 'Same PaymentIntent reused (not new one); PATCH to update payment method' },\n          { nodes: ['analyticsLayer'],                              text: 'payment_failed event with decline_code and attempt_number tracked' }\n        ],\n        sections: ['06','03','08']\n      },\n      threeds: {\n        title: '3DS authentication challenge',\n        steps: [\n          { nodes: ['stripeSDK', 'checkoutBFF'],                         text: 'Card requires 3DS; confirmCardPayment detects requires_action status' },\n          { nodes: ['cardFields', 'checkoutForm'],                        text: '3DS modal or redirect opens automatically via Stripe.js' },\n          { nodes: ['paymentIntentFSM'],                                  text: 'FSM in requires_action state; submit button remains disabled' },\n          { nodes: ['webhookReceiver', 'sseEventBus', 'sseTransport'],    text: 'Bank authenticates; Stripe fires webhook; SSE push to frontend' },\n          { nodes: ['confirmationScreen', 'paymentRecordsDB'],            text: 'FSM → succeeded; server DB source of truth; confirmation rendered' }\n        ],\n        sections: ['06','03','04']\n      },\n      asyncPayment: {\n        title: 'Async payment (iDEAL / Pix / konbini)',\n        steps: [\n          { nodes: ['paymentMethodSelector', 'localPSPs'],           text: 'User selects local payment method; SDK loads for that method' },\n          { nodes: ['checkoutBFF', 'paymentIntentAPI'],               text: 'PaymentIntent created with payment_method_types including local method' },\n          { nodes: ['localPSPs', 'checkoutForm'],                     text: 'Redirect to bank (iDEAL) or QR code displayed (Pix) or voucher issued (konbini)' },\n          { nodes: ['paymentIntentFSM', 'confirmationScreen'],        text: 'Frontend shows \"processing\" screen; polling or SSE waits for webhook' },\n          { nodes: ['webhookReceiver', 'sseTransport', 'confirmationScreen'], text: 'Webhook fires on bank confirmation (minutes to days); SSE updates UI' }\n        ],\n        sections: ['07','04','03']\n      },\n      pspFailover: {\n        title: 'PSP failover (Stripe 5xx → Adyen)',\n        steps: [\n          { nodes: ['stripeSDK', 'pspAdapterClient'],              text: 'stripe.confirmCardPayment() returns 5xx; adapter detects provider error' },\n          { nodes: ['pspRouter', 'checkoutBFF'],                   text: 'Server-side: create new Adyen session token for same cart' },\n          { nodes: ['adyenSDK', 'pspAdapterClient'],               text: 'Adapter switches to Adyen provider; loads Adyen SDK; re-mounts card fields' },\n          { nodes: ['paymentIntentFSM', 'idempotencyLayer'],       text: 'New idempotency key issued; FSM resets to submitting' },\n          { nodes: ['analyticsLayer'],                             text: 'psp_failover event tracked; user sees no provider change' }\n        ],\n        sections: ['09','06']\n      }\n    };\n\n    const LANES = [\n      { y: 28,  h: 130, label: 'UI Surfaces',             layer: 'ui' },\n      { y: 178, h: 130, label: 'Client State & Adapters', layer: 'client' },\n      { y: 330, h: 110, label: 'Transport',               layer: 'transport' },\n      { y: 482, h: 130, label: 'API / BFF',               layer: 'api' },\n      { y: 634, h: 110, label: 'PSP Providers',           layer: 'provider' },\n      { y: 786, h: 110, label: 'Data',                    layer: 'data' },\n    ];\n\n    // ── State ────────────────────────────────────────────────────────────────\n    let scale = 0.82;\n    let panX = 20;\n    let panY = 10;\n    let activeLayers   = new Set(Object.keys(LAYERS));\n    let activeSections = new Set(SECTIONS.map(s => s.id));\n    let selectedNode   = null;\n    let activeFlow     = null;\n    let flowStepIndex  = -1;\n    let searchQuery    = '';\n\n    const diagram     = document.getElementById('diagram');\n    const connections = document.getElementById('connections');\n    const canvas      = document.getElementById('canvas');\n\n    // ── Helpers ──────────────────────────────────────────────────────────────\n    function nodeCenter(id) {\n      const n = NODES.find(x => x.id === id);\n      return { x: n.x + 74, y: n.y + 28 };\n    }\n\n    function nodeMatchesFilters(n) {\n      const q = searchQuery.toLowerCase();\n      const matchSearch  = !q || n.title.toLowerCase().includes(q) || n.sub.toLowerCase().includes(q) || n.desc.toLowerCase().includes(q);\n      const matchLayer   = activeLayers.has(n.layer);\n      const matchSection = n.sections.some(s => activeSections.has(s));\n      return matchSearch && matchLayer && matchSection;\n    }\n\n    function getActiveFlowStep() {\n      if (!activeFlow || flowStepIndex < 0) return null;\n      return FLOWS[activeFlow]?.steps[flowStepIndex] || null;\n    }\n\n    function getFlowHighlightEdges(stepNodes) {\n      const inStep = new Set(stepNodes);\n      return EDGES.filter(([from, to]) => inStep.has(from) && inStep.has(to));\n    }\n\n    // ── Render: Lanes ────────────────────────────────────────────────────────\n    function renderLanes() {\n      diagram.querySelectorAll('.lane').forEach(el => el.remove());\n      LANES.forEach(lane => {\n        if (!activeLayers.has(lane.layer) && lane.layer !== 'security') return;\n        const el = document.createElement('div');\n        el.className = 'lane';\n        el.style.top    = lane.y + 'px';\n        el.style.height = lane.h + 'px';\n        el.innerHTML = `<span class=\"lane-label\">${lane.label}</span>`;\n        diagram.insertBefore(el, connections);\n      });\n    }\n\n    // ── Render: Nodes ────────────────────────────────────────────────────────\n    function renderNodes() {\n      diagram.querySelectorAll('.node').forEach(el => el.remove());\n      const flowStep    = getActiveFlowStep();\n      const flowNodeIds = flowStep ? new Set(flowStep.nodes) : null;\n\n      NODES.forEach(n => {\n        const el = document.createElement('div');\n        el.className    = 'node';\n        el.dataset.id   = n.id;\n        el.dataset.layer = n.layer;\n        el.style.left   = n.x + 'px';\n        el.style.top    = n.y + 'px';\n\n        const visible = nodeMatchesFilters(n);\n        if (!visible) {\n          el.classList.add('dimmed');\n        } else if (flowNodeIds && !flowNodeIds.has(n.id)) {\n          el.classList.add('dimmed');\n        }\n\n        if (flowNodeIds && flowNodeIds.has(n.id) && visible) el.classList.add('highlight');\n        if (selectedNode === n.id) el.classList.add('selected');\n\n        el.innerHTML = `\n          <div class=\"node-title\">${n.title}</div>\n          <div class=\"node-sub\">${n.sub}</div>\n          <div class=\"node-tags\">${n.sections.map(s => `<span class=\"node-tag\">${s}</span>`).join('')}</div>\n        `;\n        el.addEventListener('click', () => selectNode(n.id));\n        diagram.appendChild(el);\n      });\n    }\n\n    // ── Render: Edges ────────────────────────────────────────────────────────\n    function renderEdges(highlightPairs) {\n      const hl = new Set((highlightPairs || []).map(p => p.join('|')));\n      connections.innerHTML = '';\n      EDGES.forEach(([from, to, label]) => {\n        const a    = nodeCenter(from);\n        const b    = nodeCenter(to);\n        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n        line.setAttribute('x1', a.x);\n        line.setAttribute('y1', a.y);\n        line.setAttribute('x2', b.x);\n        line.setAttribute('y2', b.y);\n        if (hl.has(from + '|' + to) || hl.has(to + '|' + from)) line.classList.add('flow-active');\n        const nf = NODES.find(n => n.id === from);\n        const nt = NODES.find(n => n.id === to);\n        const visible = nf && nt &&\n          activeLayers.has(nf.layer) && activeLayers.has(nt.layer) &&\n          nf.sections.some(s => activeSections.has(s)) &&\n          nt.sections.some(s => activeSections.has(s));\n        if (!visible) line.style.opacity = '0.15';\n        connections.appendChild(line);\n      });\n    }\n\n    // ── Pan / Zoom ───────────────────────────────────────────────────────────\n    function applyTransform() {\n      diagram.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;\n    }\n\n    // ── Selection ────────────────────────────────────────────────────────────\n    function selectNode(id) {\n      selectedNode  = id;\n      activeFlow    = null;\n      flowStepIndex = -1;\n      document.querySelectorAll('.flow-btn').forEach(b => b.classList.remove('active'));\n      renderNodes();\n      renderEdges();\n      showNodeDetail(id);\n    }\n\n    function showNodeDetail(id) {\n      const n = NODES.find(x => x.id === id);\n      if (!n) return;\n      document.getElementById('detailEmpty').hidden = true;\n      const content = document.getElementById('detailContent');\n      content.hidden = false;\n      const layer = LAYERS[n.layer];\n      content.innerHTML = `\n        <span class=\"layer-badge\" style=\"background:${layer.color}22;color:${layer.color}\">${layer.label}</span>\n        <h2>${n.title}</h2>\n        <p>${n.desc}</p>\n        <h3>Key mechanisms</h3>\n        <ul>${n.bullets.map(b => `<li>${b}</li>`).join('')}</ul>\n        <h3>Interview questions</h3>\n        <ul>${n.questions.map(q => `<li>${q}</li>`).join('')}</ul>\n        <h3>Prep sections</h3>\n        <div class=\"section-links\">${n.sections.map(s => {\n          const sec = SECTIONS.find(x => x.id === s);\n          return sec ? `<a href=\"${sec.file}\">§${s} ${sec.name}</a>` : '';\n        }).join('')}</div>\n      `;\n    }\n\n    // ── Flow walkthroughs ────────────────────────────────────────────────────\n    function showFlowDetail(flowKey) {\n      const flow = FLOWS[flowKey];\n      document.getElementById('detailEmpty').hidden = true;\n      const content = document.getElementById('detailContent');\n      content.hidden = false;\n      content.innerHTML = `\n        <h2>${flow.title}</h2>\n        <p>Click steps to highlight nodes on the diagram.</p>\n        <h3>Steps</h3>\n        ${flow.steps.map((step, i) => `\n          <div class=\"flow-step${i === flowStepIndex ? ' active' : ''}\" data-step=\"${i}\">\n            <strong>${i + 1}.</strong> ${step.text}\n          </div>\n        `).join('')}\n        <h3>Related sections</h3>\n        <div class=\"section-links\">${flow.sections.map(s => {\n          const sec = SECTIONS.find(x => x.id === s);\n          return sec ? `<a href=\"${sec.file}\">§${s} ${sec.name}</a>` : '';\n        }).join('')}</div>\n      `;\n      content.querySelectorAll('.flow-step').forEach(el => {\n        el.addEventListener('click', () => {\n          const idx = Number(el.dataset.step);\n          highlightFlowStep(flowKey, idx);\n          showFlowDetail(flowKey);\n        });\n      });\n    }\n\n    function highlightFlowStep(flowKey, stepIndex) {\n      const flow = FLOWS[flowKey];\n      const step = flow?.steps[stepIndex];\n      if (!step) return;\n      activeFlow    = flowKey;\n      flowStepIndex = stepIndex;\n      renderNodes();\n      renderEdges(getFlowHighlightEdges(step.nodes));\n    }\n\n    function startFlow(flowKey) {\n      activeFlow    = flowKey;\n      flowStepIndex = 0;\n      selectedNode  = null;\n      document.querySelectorAll('.flow-btn').forEach(b => b.classList.toggle('active', b.dataset.flow === flowKey));\n      renderNodes();\n      highlightFlowStep(flowKey, 0);\n      showFlowDetail(flowKey);\n    }\n\n    // ── Build sidebar controls ───────────────────────────────────────────────\n    function buildFilters() {\n      // Layer chips\n      const lf = document.getElementById('layerFilters');\n      Object.entries(LAYERS).forEach(([key, val]) => {\n        const chip = document.createElement('button');\n        chip.type      = 'button';\n        chip.className = `chip layer-${key} active`;\n        chip.textContent = val.label;\n        chip.addEventListener('click', () => {\n          if (activeLayers.has(key)) { activeLayers.delete(key); chip.classList.remove('active'); }\n          else                       { activeLayers.add(key);    chip.classList.add('active'); }\n          refresh();\n        });\n        lf.appendChild(chip);\n      });\n\n      // Section chips\n      const sf = document.getElementById('sectionFilters');\n      SECTIONS.forEach(sec => {\n        const chip = document.createElement('button');\n        chip.type      = 'button';\n        chip.className = 'chip active';\n        chip.textContent = sec.id + ' ' + sec.name;\n        chip.addEventListener('click', () => {\n          if (activeSections.has(sec.id)) { activeSections.delete(sec.id); chip.classList.remove('active'); }\n          else                            { activeSections.add(sec.id);    chip.classList.add('active'); }\n          refresh();\n        });\n        sf.appendChild(chip);\n      });\n\n      // Flow buttons\n      const fb = document.getElementById('flowButtons');\n      Object.entries(FLOWS).forEach(([key, flow]) => {\n        const btn = document.createElement('button');\n        btn.type         = 'button';\n        btn.className    = 'flow-btn';\n        btn.dataset.flow = key;\n        btn.textContent  = flow.title;\n        btn.addEventListener('click', () => startFlow(key));\n        fb.appendChild(btn);\n      });\n\n      // Legend\n      const legend = document.getElementById('legend');\n      Object.entries(LAYERS).forEach(([key, val]) => {\n        legend.innerHTML += `<div><span style=\"background:${val.color}\"></span>${val.label}</div>`;\n      });\n    }\n\n    // ── Full refresh ─────────────────────────────────────────────────────────\n    function refresh() {\n      renderLanes();\n      renderNodes();\n      if (activeFlow && flowStepIndex >= 0) {\n        const step = FLOWS[activeFlow]?.steps[flowStepIndex];\n        renderEdges(step ? getFlowHighlightEdges(step.nodes) : []);\n      } else {\n        renderEdges();\n      }\n    }\n\n    // ── Search ───────────────────────────────────────────────────────────────\n    document.getElementById('search').addEventListener('input', e => {\n      searchQuery = e.target.value;\n      refresh();\n    });\n\n    // ── Zoom buttons ─────────────────────────────────────────────────────────\n    document.getElementById('zoomIn').addEventListener('click',    () => { scale = Math.min(1.4, scale + 0.1);  applyTransform(); });\n    document.getElementById('zoomOut').addEventListener('click',   () => { scale = Math.max(0.45, scale - 0.1); applyTransform(); });\n    document.getElementById('resetView').addEventListener('click', () => { scale = 0.82; panX = 20; panY = 10;  applyTransform(); });\n\n    // ── Pan (pointer drag) ───────────────────────────────────────────────────\n    let dragging = false;\n    let lastX = 0, lastY = 0;\n    canvas.addEventListener('pointerdown', e => {\n      if (e.target.closest('.node')) return;\n      dragging = true;\n      lastX = e.clientX;\n      lastY = e.clientY;\n      canvas.classList.add('dragging');\n      canvas.setPointerCapture(e.pointerId);\n    });\n    canvas.addEventListener('pointermove', e => {\n      if (!dragging) return;\n      panX += e.clientX - lastX;\n      panY += e.clientY - lastY;\n      lastX = e.clientX;\n      lastY = e.clientY;\n      applyTransform();\n    });\n    canvas.addEventListener('pointerup', () => { dragging = false; canvas.classList.remove('dragging'); });\n\n    // ── Init ─────────────────────────────────────────────────────────────────\n    buildFilters();\n    renderLanes();\n    renderNodes();\n    renderEdges();\n    applyTransform();\n  </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":16082,"cache_read_input_tokens":29271,"cache_creation":{"ephemeral_5m_input_tokens":16082,"ephemeral_1h_input_tokens":0},"output_tokens":3},"context_management":null},"parent_tool_use_id":"toolu_vrtx_01QWuQsjTa7gpjn1M7GDVLBQ","session_id":"7ab96e0e-8f96-4d88-841c-51b1b26eaeef","uuid":"f2514fcb-6011-4223-938a-d79e3c75769b","subagent_type":"general-purpose","task_description":"Build payments-system frontend architecture HTML"}
