<script>
(function(){
var $=function(i){return document.getElementById(i);};
var cv=$('cv'), g=cv.getContext('2d'), MONO="11px 'JetBrains Mono',monospace";
/* Synthetic space. The last D-TAIL axes stand for the band above 3.4 kHz.
   GW is the direction every human voice shares, which is why impostor cosines
   sit above the 1/sqrt(D) chance baseline. SW0 = within-speaker scatter at 3 s. */
var D=128,TAIL=76,NS=6,NCH=3,GW=0.6,SW0=1.15,TW=1.15,QN=0.15;
var NM=['S1','S2','S3','S4','S5','S6'];
var SC=['#00d4ff','#00ff88','#ffd700','#ff4757','#7c3aed','#ff8ab0'];
var CO={tgt:'#00ff88',imp:'#ff4757',thr:'#ffd700',bl:'#7c3aed',dim:'#5a6478',gr:'#1e2233'};
var S={utt:8,dur:3,chan:25,alpha:.5,a:0,b:1,nb:false,mm:true,rnm:true,seed:7};

function mul32(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function mkN(r){var s=null;return function(){if(s!==null){var v=s;s=null;return v;}var u,w,q;do{u=2*r()-1;w=2*r()-1;q=u*u+w*w;}while(q<=0||q>=1);var f=Math.sqrt(-2*Math.log(q)/q);s=w*f;return u*f;};}
function nrm(v){var s=0,i;for(i=0;i<v.length;i++)s+=v[i]*v[i];s=Math.sqrt(s)||1e-9;var o=new Float64Array(v.length);for(i=0;i<v.length;i++)o[i]=v[i]/s;return o;}
function len(v){var s=0;for(var i=0;i<v.length;i++)s+=v[i]*v[i];return Math.sqrt(s);}
function dot(a,b){var s=0;for(var i=0;i<a.length;i++)s+=a[i]*b[i];return s;}
function rdir(n){var v=new Float64Array(D);for(var i=0;i<D;i++)v[i]=n();return nrm(v);}

var means=[],chans=[],em=[],pts=[],ST=null,key='';
function buildSpace(){
  var n=mkN(mul32(S.seed)),Gd=rdir(n),s,j;
  means=[];
  for(s=0;s<NS;s++){var u=rdir(n),v=new Float64Array(D);
    for(j=0;j<D;j++)v[j]=(GW*Gd[j]+u[j])*(j<TAIL?1:TW);
    means.push(nrm(v));}
  chans=[];for(var k=0;k<NCH;k++)chans.push(rdir(n));
}
function band(v){if(!S.nb)return v;var o=new Float64Array(D);for(var j=0;j<TAIL;j++)o[j]=v[j];return o;}
function sample(){
  em=[];for(var s=0;s<NS;s++)em.push(nrm(band(means[s])));
  var n=mkN(mul32(S.seed*7919+11)),sw=SW0*Math.sqrt(3/Math.max(.4,S.dur)),cw=S.chan/100,i,j;
  pts=[];
  for(s=0;s<NS;s++)for(i=0;i<S.utt;i++){
    var k=S.mm?(i%NCH):(s%NCH),nd=rdir(n),qd=rdir(n),v=new Float64Array(D);
    for(j=0;j<D;j++)v[j]=means[s][j]+cw*chans[k][j]+sw*nd[j];
    v=band(v);
    if(S.nb)for(j=0;j<TAIL;j++)v[j]+=QN*qd[j];
    pts.push({s:s,k:k,v:nrm(v)});}
}
function cl(a,t){var lo=0,hi=a.length;while(lo<hi){var m=(lo+hi)>>1;if(a[m]<t)lo=m+1;else hi=m;}return lo;}
function stats(){
  var tg=[],im=[],i,j;
  for(i=0;i<pts.length;i++)for(j=i+1;j<pts.length;j++){
    var c=dot(pts[i].v,pts[j].v);
    if(pts[i].s===pts[j].s)tg.push(c);else im.push(c);}
  var f=function(x,y){return x-y;};tg.sort(f);im.sort(f);
  var best=null;
  function test(t){var frr=cl(tg,t)/tg.length,far=(im.length-cl(im,t))/im.length,d=Math.abs(far-frr);
    if(best===null||d<best.d)best={d:d,t:t,eer:.5*(far+frr)};}
  for(i=0;i<tg.length;i++)test(tg[i]);
  for(i=0;i<im.length;i++)test(im[i]);
  var mt=0,mi=0;for(i=0;i<tg.length;i++)mt+=tg[i];for(i=0;i<im.length;i++)mi+=im[i];
  return {tg:tg,im:im,mt:mt/tg.length,mi:mi/im.length,thr:best.t,eer:best.eer,np:tg.length+im.length};
}
function ensure(){var k=[S.utt,S.dur,S.chan,S.nb,S.mm,S.seed].join('|');
  if(k!==key){key=k;buildSpace();sample();ST=stats();}}
function blend(){
  var A=em[S.a],B=em[S.b],al=S.alpha,w=new Float64Array(D);
  for(var j=0;j<D;j++)w[j]=(1-al)*A[j]+al*B[j];
  var raw=len(w),wh=S.rnm?nrm(w):w;
  return {w:wh,raw:raw,cA:dot(wh,A),cB:dot(wh,B),c:dot(A,B)};
}
function axes(){
  var cen=new Float64Array(D),s,j;
  for(s=0;s<NS;s++)for(j=0;j<D;j++)cen[j]+=em[s][j]/NS;
  var d1=new Float64Array(D);
  for(j=0;j<D;j++)d1[j]=em[S.a][j]-em[S.b][j];
  if(len(d1)<1e-6)for(j=0;j<D;j++)d1[j]=em[S.a][j]-cen[j];
  var u1=nrm(d1),c3=0;while(c3===S.a||c3===S.b)c3++;
  var r=new Float64Array(D);for(j=0;j<D;j++)r[j]=em[c3][j]-cen[j];
  var p=dot(r,u1);for(j=0;j<D;j++)r[j]-=p*u1[j];
  return {c:cen,u1:u1,u2:nrm(r)};
}

var SX=42,SY=28,SW=400,SH=282,HX=520,HY=28,HW=372,HH=282;
function draw(){
  ensure();
  var B=blend(),ax=axes(),i,j,t,q;
  g.clearRect(0,0,cv.width,cv.height);g.font=MONO;g.textBaseline='middle';
  function proj(v){var x=0,y=0;for(var j=0;j<D;j++){var d=v[j]-ax.c[j];x+=d*ax.u1[j];y+=d*ax.u2[j];}return[x,y];}
  var px=[],lo=[1e9,1e9],hi=[-1e9,-1e9];
  function ext(p){lo[0]=Math.min(lo[0],p[0]);hi[0]=Math.max(hi[0],p[0]);lo[1]=Math.min(lo[1],p[1]);hi[1]=Math.max(hi[1],p[1]);}
  for(i=0;i<pts.length;i++){q=proj(pts[i].v);px.push(q);ext(q);}
  var mp=[];for(i=0;i<NS;i++){q=proj(em[i]);mp.push(q);ext(q);}
  var pad=.12*Math.max(hi[0]-lo[0],1e-6);
  function mx(x){return SX+(x-lo[0]+pad)/((hi[0]-lo[0])+2*pad)*SW;}
  function my(y){return SY+SH-(y-lo[1]+pad)/((hi[1]-lo[1])+2*pad)*SH;}
  g.strokeStyle=CO.gr;g.lineWidth=1;g.strokeRect(SX,SY,SW,SH);
  g.fillStyle=CO.dim;g.fillText('2-D projection — plane through the '+NM[S.a]+'/'+NM[S.b]+' means',SX,SY-14);
  for(i=0;i<pts.length;i++){
    g.fillStyle=SC[pts[i].s];g.globalAlpha=(pts[i].s===S.a||pts[i].s===S.b)?.95:.45;
    g.beginPath();g.arc(mx(px[i][0]),my(px[i][1]),3.2,0,6.284);g.fill();}
  g.globalAlpha=1;
  for(i=0;i<NS;i++){
    g.strokeStyle=SC[i];g.lineWidth=(i===S.a||i===S.b)?2:1;
    g.beginPath();g.arc(mx(mp[i][0]),my(mp[i][1]),7,0,6.284);g.stroke();
    g.fillStyle=SC[i];g.fillText(NM[i],mx(mp[i][0])+10,my(mp[i][1]));}
  g.strokeStyle=CO.bl;g.lineWidth=1.6;g.setLineDash([4,3]);g.beginPath();
  for(t=0;t<=1.0001;t+=.02){
    var w=new Float64Array(D);
    for(j=0;j<D;j++)w[j]=(1-t)*em[S.a][j]+t*em[S.b][j];
    if(S.rnm)w=nrm(w);
    q=proj(w);if(t===0)g.moveTo(mx(q[0]),my(q[1]));else g.lineTo(mx(q[0]),my(q[1]));}
  g.stroke();g.setLineDash([]);
  q=proj(B.w);g.fillStyle=CO.bl;g.beginPath();g.arc(mx(q[0]),my(q[1]),6,0,6.284);g.fill();
  g.fillStyle='#e2e8f0';g.fillText('blend α='+S.alpha.toFixed(2),mx(q[0])+9,my(q[1])+12);

  var LC=-.4,HC=1,NB=56,ht=[],hm=[];
  for(i=0;i<NB;i++){ht.push(0);hm.push(0);}
  function bin(c){return Math.max(0,Math.min(NB-1,Math.floor((c-LC)/(HC-LC)*NB)));}
  for(i=0;i<ST.tg.length;i++)ht[bin(ST.tg[i])]++;
  for(i=0;i<ST.im.length;i++)hm[bin(ST.im[i])]++;
  var mt=Math.max.apply(null,ht)||1,mi=Math.max.apply(null,hm)||1,bw=HW/NB;
  function hx(c){return HX+(c-LC)/(HC-LC)*HW;}
  g.strokeStyle=CO.gr;g.strokeRect(HX,HY,HW,HH);
  g.fillStyle=CO.dim;g.fillText('cosine scores — each distribution scaled to its own peak',HX,HY-14);
  for(i=0;i<NB;i++){
    var h1=hm[i]/mi*(HH-24),h2=ht[i]/mt*(HH-24);g.globalAlpha=.55;
    g.fillStyle=CO.imp;g.fillRect(HX+i*bw,HY+HH-h1,bw-.6,h1);
    g.fillStyle=CO.tgt;g.fillRect(HX+i*bw,HY+HH-h2,bw-.6,h2);}
  g.globalAlpha=1;
  for(var c=-.4;c<=1.001;c+=.2){
    g.strokeStyle=CO.gr;g.beginPath();g.moveTo(hx(c),HY);g.lineTo(hx(c),HY+HH);g.stroke();
    g.fillStyle=CO.dim;g.fillText(c.toFixed(1),hx(c)-8,HY+HH+10);}
  function vl(c,col,lab,dy){
    var x=hx(Math.max(LC,Math.min(HC,c)));
    g.strokeStyle=col;g.lineWidth=1.6;g.beginPath();g.moveTo(x,HY+4);g.lineTo(x,HY+HH);g.stroke();
    g.fillStyle=col;g.fillText(lab,Math.min(x+4,HX+HW-92),HY+dy);}
  vl(ST.thr,CO.thr,'EER thr '+ST.thr.toFixed(2),12);
  vl(B.cA,CO.bl,'blend→'+NM[S.a]+' '+B.cA.toFixed(2),30);
  vl(B.cB,'#c4a2ff','blend→'+NM[S.b]+' '+B.cB.toFixed(2),48);

  var eD=S.nb?TAIL:D,ch=1/Math.sqrt(eD),sep=ST.mt-ST.mi;
  $('k1').textContent=ST.mt.toFixed(3);$('k2').textContent=ST.mi.toFixed(3);
  var e3=$('k3');e3.textContent=(ST.eer*100).toFixed(1)+' %';
  e3.className='v '+(ST.eer>.15?'bad':ST.eer>.05?'warn':'good');
  $('k4').textContent=ST.thr.toFixed(3);$('k5').textContent=B.c.toFixed(3);
  var e6=$('k6');e6.textContent=B.raw.toFixed(3);e6.className='v '+(B.raw<.85?'warn':'');
  $('k7').textContent=B.cA.toFixed(2)+' / '+B.cB.toFixed(2);
  var both=(B.cA>=ST.thr&&B.cB>=ST.thr),e8=$('k8');
  e8.textContent=both?'passes as BOTH':(B.cA>=ST.thr?'passes as '+NM[S.a]:(B.cB>=ST.thr?'passes as '+NM[S.b]:'passes as neither'));
  e8.className='v '+(both?'bad':(B.cA>=ST.thr||B.cB>=ST.thr)?'warn':'good');
  $('npair').textContent=ST.np.toLocaleString();

  var al=S.alpha,pred=((1-al)+al*B.c)/Math.sqrt((1-al)*(1-al)+al*al+2*al*(1-al)*B.c),d=[];
  d.push('<b>Scores.</b> '+ST.np.toLocaleString()+' pairs over '+pts.length+' utterances. Same-speaker mean <span class="hl">'
    +ST.mt.toFixed(3)+'</span>, impostor mean <span class="hl">'+ST.mi.toFixed(3)+'</span> — '+sep.toFixed(3)
    +' apart, and the threshold lives inside that gap. Chance on '+eD+' axes is 1/√'+eD+' = '+ch.toFixed(3)
    +', far below the impostor mean: every human voice shares a direction, so "above chance" is not "same person".');
  if(S.nb)d.push('<b>Narrowband.</b> '+(D-TAIL)+' of '+D+' axes zeroed: '
    +(100*((D-TAIL)*TW*TW/(TAIL+(D-TAIL)*TW*TW))).toFixed(0)+'% of the speaker-mean energy gone against only '
    +(100*(D-TAIL)/D).toFixed(0)+'% of the isotropic scatter, and the effective dimension drops to '+TAIL
    +' so each score is estimated from fewer axes. Bandwidth does the damage, not the '+QN.toFixed(2)+' mu-law term.');
  d.push('<b>Duration.</b> '+S.dur.toFixed(1)+' s → scatter '+(SW0*Math.sqrt(3/Math.max(.4,S.dur))).toFixed(2)
    +' against '+SW0.toFixed(2)+' at the 3 s reference. Halving the enrolment multiplies it by √2 — which is why 1–2 s snippets verify badly however good the encoder is.');
  d.push('<b>Channel.</b> '+(S.mm
    ?'Cross-channel — each speaker appears on all '+NCH+' lines, so the channel term lands <em>inside</em> the same-speaker distribution and widens it. The honest evaluation.'
    :'Matched-channel — each speaker always calls from one line, so the channel adds to every same-speaker score and flatters the EER, while pulling the speakers sharing a line ('
     +NM[0]+'/'+NM[3]+', '+NM[1]+'/'+NM[4]+', '+NM[2]+'/'+NM[5]+') together.'));
  d.push('<b>Blend.</b> cos('+NM[S.a]+','+NM[S.b]+') = '+B.c.toFixed(3)+'. The closed form ((1−α)+αc)/|w| predicts <span class="hl">'
    +pred.toFixed(3)+'</span> against '+NM[S.a]+' and the space returns '+B.cA.toFixed(3)+'. Un-normalised |w| = '+B.raw.toFixed(3)
    +(al>.4&&al<.6?', the √((1+c)/2) = '+Math.sqrt((1+B.c)/2).toFixed(3)+' of the code block above':'')
    +' — shorter than anything the decoder saw in training.');
  d.push(both
    ?'<b><span class="er">Both endpoints clear the threshold.</span></b> One voice verifying as '+NM[S.a]+' <em>and</em> '+NM[S.b]
     +' is why a verification score is an identity signal, not a proof — pair it with a knowledge factor before disclosing anything.'
    :'<b>Blend verdict.</b> At this α and threshold it clears '+(B.cA>=ST.thr?NM[S.a]:(B.cB>=ST.thr?NM[S.b]:'neither endpoint'))
     +'. Push α toward 0.5 on two similar speakers and watch it clear both.');
  $('det').innerHTML=d.join('<br/>');
}

function fill(sel,cur){sel.innerHTML='';for(var i=0;i<NS;i++){var o=document.createElement('option');o.value=i;o.textContent=NM[i];if(i===cur)o.selected=true;sel.appendChild(o);}}
function sync(){
  $('vutt').textContent=S.utt;$('vdur').textContent=S.dur.toFixed(1);
  $('vchan').textContent=S.chan;$('valpha').textContent=S.alpha.toFixed(2);
  $('sutt').value=S.utt;$('sdur').value=Math.round(S.dur*10);
  $('schan').value=S.chan;$('salpha').value=Math.round(S.alpha*100);
  $('nb').checked=S.nb;$('mm').checked=S.mm;$('rnm').checked=S.rnm;
  fill($('selA'),S.a);fill($('selB'),S.b);draw();
}
$('sutt').addEventListener('input',function(){S.utt=+this.value;sync();});
$('sdur').addEventListener('input',function(){S.dur=+this.value/10;sync();});
$('schan').addEventListener('input',function(){S.chan=+this.value;sync();});
$('salpha').addEventListener('input',function(){S.alpha=+this.value/100;sync();});
$('nb').addEventListener('change',function(){S.nb=this.checked;sync();});
$('mm').addEventListener('change',function(){S.mm=this.checked;sync();});
$('rnm').addEventListener('change',function(){S.rnm=this.checked;sync();});
$('selA').addEventListener('change',function(){S.a=+this.value;if(S.a===S.b)S.b=(S.a+1)%NS;sync();});
$('selB').addEventListener('change',function(){S.b=+this.value;if(S.a===S.b)S.a=(S.b+1)%NS;sync();});
$('rs').addEventListener('click',function(){S.seed=(S.seed*31+17)%99991;sync();});
function ps(o){for(var k in o)S[k]=o[k];sync();}
$('p0').addEventListener('click',function(){ps({utt:8,dur:3,chan:25,alpha:.5,nb:false,mm:true,rnm:true});});
$('p1').addEventListener('click',function(){ps({dur:3,chan:35,nb:true,mm:true});});
$('p2').addEventListener('click',function(){ps({dur:1.5,chan:25,nb:false,mm:true});});
$('p3').addEventListener('click',function(){ps({dur:3,chan:80,nb:false,mm:false});});
sync();
})();
</script>
</body>
</html>
