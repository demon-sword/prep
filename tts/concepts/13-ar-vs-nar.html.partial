<script>
(function(){
// A latency model of autoregressive vs non-autoregressive TTS, not a benchmark:
// every constant is an ILLUSTRATIVE default the reader can move, and the SHAPE
// of each curve is the claim, not the numbers on the axis.
var FRAME_MS = 256/22050*1000; // 11.60998 ms of audio per mel frame
var FPS      = 1000/FRAME_MS; // 86.1328 frames per audio second
var WARM     = 4; // fixed per-request overhead, both families
var NAR_BASE = 8; // kernel launches for one parallel pass
var NAR_QUAD = 2e-6; // decoder self-attention, O(T^2) term
var CLAUSE   = 150; // frames per clause when NAR text is chunked
var WMAX     = 60; // x-axis span, in words
function $(id){return document.getElementById(id);}
function P(){
 return {
  words: +$("sWrd").value,
  wps:   +$("sWps").value/10,
  step:  +$("sStp").value/100,
  narPF: +$("sNar").value/1000,
  voc:   +$("sVoc").value/100,
  chunk: +$("sChk").value,
  pFail: +$("sFal").value/10,
  maxSt: +$("sMax").value,
  rest:  +$("sRst").value,
  stream: $("cStream").checked,
  clause: $("cClause").checked
 };
}
function frames(w,p){ return Math.max(1, Math.round(w/p.wps*FPS)); }
function narPass(n,p){ return NAR_BASE + n*p.narPF + n*n*NAR_QUAD; }
function narMel(T,p){
 if(!p.clause) return narPass(T,p);
 var ms=0, left=T;
 while(left>0){ var n=Math.min(CLAUSE,left); ms+=narPass(n,p); left-=n; }
 return ms;
}
function ttfaAR(T,p){ var c=Math.min(p.chunk,T);
 return WARM + (p.stream ? c*p.step : T*p.step) + c*p.voc; }
function ttfaNAR(T,p){ var c=Math.min(p.chunk,T);
 return WARM + narPass(p.clause?Math.min(CLAUSE,T):T,p) + c*p.voc; }
function totAR(T,p){ return WARM + T*p.step + T*p.voc; }
function totNAR(T,p){ return WARM + narMel(T,p) + T*p.voc; }
// Two-point tail model: with probability pFail the stop token never fires and
// the decoder runs the full max_decoder_steps. p99 takes that value once the
// failure rate reaches 1%; below it, p99 is ordinary decode jitter.
function runAR(p){ return WARM + p.maxSt*p.step + p.maxSt*p.voc; }
function p99AR(T,p){ return p.pFail>=1 ? Math.max(runAR(p),totAR(T,p)) : totAR(T,p)*1.15; }
function fmt(ms){ return ms>=1000 ? (ms/1000).toFixed(2)+" s" : ms.toFixed(0)+" ms"; }
// --- upper chart: log-time vs utterance length ------------------------------
var ch=$("cvChart"), cx=ch.getContext("2d");
var L=62, R=16, TP=18, BT=30, LO=4, HI=20000;
function xOf(w){ return L + (w-1)/(WMAX-1)*(ch.width-L-R); }
function yOf(ms){
 var v=Math.max(LO,Math.min(HI,ms));
 return TP + (1-(Math.log(v/LO)/Math.log(HI/LO)))*(ch.height-TP-BT);
}
function curve(f,p,col,dash){
 cx.save(); cx.setLineDash(dash||[]); cx.strokeStyle=col; cx.lineWidth=2;
 cx.beginPath();
 for(var w=1;w<=WMAX;w++){ var y=yOf(f(frames(w,p),p));
  if(w===1) cx.moveTo(xOf(w),y); else cx.lineTo(xOf(w),y); }
 cx.stroke(); cx.restore();
}
function drawChart(p){
 cx.clearRect(0,0,ch.width,ch.height);
 cx.font="10px 'JetBrains Mono',monospace"; cx.textBaseline="middle";
 [10,100,1000,10000].forEach(function(v){
  var y=yOf(v);
  cx.strokeStyle="#252a3d"; cx.lineWidth=1;
  cx.beginPath(); cx.moveTo(L,y); cx.lineTo(ch.width-R,y); cx.stroke();
  cx.fillStyle="#8892a4"; cx.textAlign="right";
  cx.fillText(v>=1000?(v/1000)+" s":v+" ms",L-6,y);
 });
 // stop-token tail band: healthy AR total up to the runaway total
 var run=runAR(p);
 cx.fillStyle="rgba(255,71,87,.16)"; cx.beginPath();
 for(var w=1;w<=WMAX;w++) cx.lineTo(xOf(w),yOf(totAR(frames(w,p),p)));
 for(w=WMAX;w>=1;w--) cx.lineTo(xOf(w),yOf(Math.max(run,totAR(frames(w,p),p))));
 cx.closePath(); cx.fill();
 [[800,"800 ms turn"],[100,"100 ms TTS slice"]].forEach(function(m){
  var y=yOf(m[0]); cx.save(); cx.setLineDash([3,4]); cx.strokeStyle="#ffd700";
  cx.beginPath(); cx.moveTo(L,y); cx.lineTo(ch.width-R,y); cx.stroke(); cx.restore();
  cx.fillStyle="#ffd700"; cx.textAlign="left"; cx.fillText(m[1],L+6,y-8);
 });
 curve(totAR,p,"#00d4ff",[6,4]);
 curve(totNAR,p,"#00ff88",[6,4]);
 curve(ttfaAR,p,"#00d4ff");
 curve(ttfaNAR,p,"#00ff88");
 // crossover: where the single non-causal pass costs more than AR's lookahead
 var xo=0;
 for(w=1;w<=WMAX;w++){ var T=frames(w,p);
  if(ttfaNAR(T,p)>ttfaAR(T,p)){ xo=w; break; } }
 if(xo){
  var X=xOf(xo), Y=yOf(ttfaAR(frames(xo,p),p));
  cx.fillStyle="#ffd700"; cx.beginPath(); cx.arc(X,Y,4,0,6.284); cx.fill();
  cx.textAlign=xo>WMAX*0.7?"right":"left";
  cx.fillText("TTFA crossover "+xo+"w",X+(xo>WMAX*0.7?-8:8),Y-12);
 }
 var mx=xOf(p.words);
 cx.strokeStyle="#e2e8f0"; cx.lineWidth=1; cx.setLineDash([2,3]);
 cx.beginPath(); cx.moveTo(mx,TP); cx.lineTo(mx,ch.height-BT); cx.stroke();
 cx.setLineDash([]);
 cx.fillStyle="#8892a4"; cx.textAlign="center";
 cx.fillText(p.words+" words",mx,ch.height-BT+12);
 cx.textAlign="left"; cx.fillText("utterance length (words) →",L,ch.height-8);
 cx.textAlign="right"; cx.fillText("solid = first audio   dashed = total",ch.width-R,ch.height-8);
 return xo;
}
// --- lower chart: the turn, from the caller's end of speech ------------------
var tc=$("cvTurn"), tx=tc.getContext("2d");
var TL=118, TR=16, ROW=42;
function drawTurn(p,play){
 var T=frames(p.words,p), fa=ttfaAR(T,p), fn=ttfaNAR(T,p), run=runAR(p);
 var span=Math.max(1000, p.rest+Math.max(fa,fn)*1.1, p.rest+run*1.05);
 var W=tc.width-TL-TR;
 function X(ms){ return TL + ms/span*W; }
 tx.clearRect(0,0,tc.width,tc.height);
 tx.font="10px 'JetBrains Mono',monospace"; tx.textBaseline="middle";
 var rows=[
  ["NAR TTS",       fn, "#00ff88", 0],
  ["AR TTS"+(p.stream?" (streamed)":" (batched)"), fa, "#00d4ff", 0],
  ["AR, stop token fails", fa, "#00d4ff", run]
 ];
 rows.forEach(function(r,i){
  var y=16+i*ROW, h=22;
  tx.fillStyle="#8892a4"; tx.textAlign="right"; tx.fillText(r[0],TL-8,y+h/2);
  tx.fillStyle="#252a3d"; tx.fillRect(X(0),y,X(p.rest)-X(0),h);
  tx.fillStyle="#8892a4"; tx.textAlign="center";
  if(i===0) tx.fillText("endpoint + ASR + LLM + network = "+p.rest+" ms",(X(0)+X(p.rest))/2,y+h/2);
  tx.fillStyle=r[2]; tx.fillRect(X(p.rest),y,Math.max(2,X(p.rest+r[1])-X(p.rest)),h);
  if(r[3]){ // the runaway keeps decoding long after first audio
   var x0=X(p.rest+r[1]), x1=X(p.rest+Math.max(r[3],r[1]));
   tx.fillStyle="rgba(255,71,87,.45)"; tx.fillRect(x0,y,Math.max(1,x1-x0),h);
   tx.fillStyle="#ff4757";
   var right=x0>tc.width*0.55; tx.textAlign=right?"right":"left";
   tx.fillText(T>p.maxSt
    ? "max_decoder_steps ("+p.maxSt+") < T ("+T+"): utterance truncated mid-sentence"
    : "runs to max_decoder_steps: "+fmt(r[3])+" emitting "
      +(p.maxSt*FRAME_MS/1000).toFixed(1)+" s of audio", x0+(right?-6:6), y-8);
  } else {
   tx.fillStyle=r[2]; tx.textAlign="left";
   tx.fillText("first audio "+fmt(p.rest+r[1]),X(p.rest+r[1])+6,y+h/2);
  }
 });
 var by=X(800);
 tx.save(); tx.setLineDash([3,4]); tx.strokeStyle="#ffd700";
 tx.beginPath(); tx.moveTo(by,6); tx.lineTo(by,tc.height-16); tx.stroke(); tx.restore();
 tx.fillStyle="#ffd700"; tx.textAlign="left"; tx.fillText("800 ms",by+4,tc.height-8);
 if(play!=null){
  var px=X(Math.min(play,span));
  tx.strokeStyle="#e2e8f0"; tx.lineWidth=1;
  tx.beginPath(); tx.moveTo(px,6); tx.lineTo(px,tc.height-16); tx.stroke();
  tx.fillStyle="#e2e8f0"; tx.textAlign="left"; tx.fillText(play.toFixed(0)+" ms",px+4,8);
 }
 tx.fillStyle="#8892a4"; tx.textAlign="right";
 tx.fillText("wall clock from the caller's last sample →",tc.width-TR,tc.height-8);
}
// --- animation --------------------------------------------------------------
var raf=null, play=0, last=0;
function tick(now){
 var p=P(), T=frames(p.words,p);
 var span=Math.max(1000,p.rest+Math.max(ttfaAR(T,p),ttfaNAR(T,p))*1.1,p.rest+runAR(p)*1.05);
 var dt=Math.min(60,now-last); last=now;
 play+=dt*(span/1600);
 drawTurn(p,play);
 if(play<span){ raf=requestAnimationFrame(tick); }
 else { raf=null; drawTurn(p,null); }
}
// --- render -----------------------------------------------------------------
function update(){
 var p=P(), T=frames(p.words,p), sec=T*FRAME_MS/1000;
 $("vWrd").textContent=p.words; $("vWps").textContent=p.wps.toFixed(1);
 $("vStp").textContent=p.step.toFixed(2); $("vNar").textContent=$("sNar").value;
 $("vVoc").textContent=p.voc.toFixed(2); $("vChk").textContent=p.chunk;
 $("vFal").textContent=p.pFail.toFixed(1); $("vMax").textContent=p.maxSt;
 $("vRst").textContent=p.rest;
 var fa=ttfaAR(T,p), fn=ttfaNAR(T,p), ta=totAR(T,p), tn=totNAR(T,p), p9=p99AR(T,p);
 var xo=drawChart(p); if(raf===null) drawTurn(p,null);
 $("stT").textContent=T+" frames";
 $("stSec").textContent=sec.toFixed(2)+" s";
 $("stFa").textContent=fmt(fa); $("stFa").className="v "+(fa<=100?"good":fa<=250?"warn":"bad");
 $("stFn").textContent=fmt(fn); $("stFn").className="v "+(fn<=100?"good":fn<=250?"warn":"bad");
 $("stTa").textContent=fmt(ta)+"  ("+(ta/(sec*1000)).toFixed(3)+")";
 $("stTa").className="v "+(ta<sec*1000?"":"bad");
 $("stTn").textContent=fmt(tn)+"  ("+(tn/(sec*1000)).toFixed(3)+")";
 $("stP99").textContent=fmt(p9);
 $("stP99").className="v "+(p9>ta*1.5?"bad":"warn");
 var turnA=p.rest+fa, turnN=p.rest+fn, worst=Math.max(turnA,turnN);
 $("stTurn").textContent="AR "+fmt(turnA)+" / NAR "+fmt(turnN);
 $("stTurn").className="v "+(worst<=800?"good":worst<=1000?"warn":"bad");
 // Narrative is derived from the numbers above, never asserted alongside them.
 var lead = fn<fa ? "NAR reaches first audio "+fmt(fa-fn)+" sooner"
         : fa<fn ? "AR reaches first audio "+fmt(fn-fa)+" sooner"
             : "both families reach first audio at the same moment";
 var arWhat = p.stream ? "AR model's "+p.chunk+"-frame lookahead"
             : "un-streamed AR model's full-utterance decode";
 var cross = xo ? "TTFA crossover at <b>"+xo+" words</b> ("
    +(frames(xo,p)*FRAME_MS/1000).toFixed(1)+" s of audio): past that length the single "
    +"non-causal pass costs more than the "+arWhat+"."
   : "No TTFA crossover below "+WMAX+" words at these settings &mdash; the NAR pass stays cheaper "
    +"than the "+arWhat+" across the whole range.";
 var trunc = T>p.maxSt ? " <span class='er'>T exceeds max_decoder_steps ("+p.maxSt
  +"), so the utterance is truncated mid-sentence even when the stop token behaves.</span>" : "";
 var tail = p.pFail>=1
   ? "At <b>"+p.pFail.toFixed(1)+"%</b> the runaway lands inside p99: <span class='er'>"
    +fmt(runAR(p))+"</span> of synthesis for "+(p.maxSt*FRAME_MS/1000).toFixed(1)+" s of babble."
   : "At <b>"+p.pFail.toFixed(1)+"%</b> the runaway sits outside p99 (which falls back to decode "
    +"jitter, modelled here as 1.15&times; the healthy total), but it is still a "+fmt(runAR(p))
    +" event whenever it fires &mdash; and it stalls every call in the batch.";
 var budget = worst<=800
   ? "<span class='hl'>Both fit the 800 ms turn</span>: "+fmt(turnA)+" AR, "+fmt(turnN)+" NAR."
   : "<span class='er'>The turn overruns 800 ms</span>: "+fmt(turnA)+" AR, "+fmt(turnN)+" NAR"
    +(p.stream?"":", and un-streamed AR is carrying it")+".";
 $("detail").innerHTML =
  "<b>"+p.words+" words at "+p.wps.toFixed(1)+" w/s = "+sec.toFixed(2)+" s = "+T+" mel frames.</b> "
  +"AR pays "+T+" serial steps at "+p.step.toFixed(2)+" ms = "+fmt(T*p.step)+"; one NAR pass over "
  +"the same frames costs "+fmt(narMel(T,p))+". "+lead+", and total synthesis is "
  +(ta/tn).toFixed(1)+"&times; longer for AR."+trunc+"<br/>"+cross+"<br/>"+tail+"<br/>"+budget;
}
// --- controls ---------------------------------------------------------------
["sWrd","sWps","sStp","sNar","sVoc","sChk","sFal","sMax","sRst"].forEach(function(id){
 $(id).addEventListener("input",update);
});
$("cStream").addEventListener("change",update);
$("cClause").addEventListener("change",update);
$("bShort").addEventListener("click",function(){
 $("sWrd").value=8; $("sWps").value=25; $("cStream").checked=true; update(); });
$("bLong").addEventListener("click",function(){
 $("sWrd").value=48; $("sWps").value=25; $("cStream").checked=true; update(); });
$("bReset").addEventListener("click",function(){
 var d={sWrd:12,sWps:25,sStp:150,sNar:20,sVoc:7,sChk:30,sFal:5,sMax:1000,sRst:700};
 for(var k in d) $(k).value=d[k];
 $("cStream").checked=true; $("cClause").checked=false; update(); });
$("bPlay").addEventListener("click",function(){
 if(raf) cancelAnimationFrame(raf);
 play=0; last=performance.now(); raf=requestAnimationFrame(tick); });
ch.addEventListener("mousedown",function(e){
 var r=this.getBoundingClientRect();
 var x=(e.clientX-r.left)*(this.width/r.width);
 var w=Math.round(1+(x-L)/(this.width-L-R)*(WMAX-1));
 $("sWrd").value=Math.max(1,Math.min(WMAX,w)); update();
});
update();
})();
</script>
</body>
</html>
