<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Offline Evaluation Gates — MLOps Concepts</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #0d0f17;
      --surface:   #141720;
      --card:      #1a1e2e;
      --border:    #252a3d;
      --accent:    #00d4ff;
      --purple:    #7c3aed;
      --green:     #00ff88;
      --yellow:    #ffd700;
      --red:       #ff4757;
      --orange:    #ff9500;
      --text:      #e2e8f0;
      --text-dim:  #8892a4;
      --mono:      'JetBrains Mono', monospace;
      --sans:      'Inter', system-ui, sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.7;
      min-height: 100vh;
    }

    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 2rem 2rem 1.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .group-badge {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      background: rgba(0, 212, 255, 0.1);
      border: 1px solid rgba(0, 212, 255, 0.3);
      padding: 0.2em 0.7em;
      border-radius: 4px;
      margin-bottom: 0.75rem;
    }

    header h1 {
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 0.5rem;
    }

    header h1 span.id {
      color: var(--text-dim);
      font-size: 0.55em;
      font-family: var(--mono);
      margin-right: 0.5rem;
      vertical-align: middle;
    }

    header p.desc { color: var(--text-dim); font-size: 1.05rem; max-width: 780px; }

    main { max-width: 1100px; margin: 0 auto; padding: 0 2rem 4rem; }

    section { margin-top: 3rem; }

    section > h2 {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--accent);
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
    }

    h3 { font-size: 1.1rem; font-weight: 600; color: var(--yellow); margin: 1.6rem 0 0.6rem; }

    p { margin-bottom: 1rem; }
    ul, ol { padding-left: 1.5rem; margin-bottom: 1rem; }
    li { margin-bottom: 0.4rem; }

    code {
      font-family: var(--mono);
      font-size: 0.85em;
      background: rgba(0, 212, 255, 0.08);
      color: var(--accent);
      padding: 0.1em 0.35em;
      border-radius: 3px;
    }

    pre {
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 3px solid var(--green);
      border-radius: 0 8px 8px 0;
      padding: 1rem 1.2rem;
      margin: 1.1rem 0;
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 0.78rem;
      line-height: 1.65;
      color: var(--text);
    }
    pre code { background: none; color: inherit; padding: 0; font-size: 1em; }
    pre .cm { color: var(--text-dim); }
    pre .kw { color: var(--purple); }
    pre .st { color: var(--green); }
    pre .fn { color: var(--accent); }

    .callout {
      background: rgba(255, 149, 0, 0.07);
      border: 1px solid rgba(255, 149, 0, 0.3);
      border-radius: 8px;
      padding: 1rem 1.2rem;
      margin: 1.2rem 0;
    }
    .callout strong { color: var(--orange); }

    /* ── Visualization ── */
    .viz-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
    }
    .viz-card + .viz-card { margin-top: 1.5rem; }
    .viz-title { font-weight: 600; font-size: 1rem; margin-bottom: 0.3rem; }
    .viz-desc { font-size: 0.88rem; color: var(--text-dim); margin-bottom: 1.2rem; }

    .sub-h {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin: 1.4rem 0 0.5rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.3rem;
    }

    .preset-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; align-items: center; }

    .ctrl-btn {
      font-family: var(--mono);
      font-size: 0.75rem;
      padding: 0.45em 0.9em;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-dim);
      cursor: pointer;
      transition: all 0.18s;
    }
    .ctrl-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
    .ctrl-btn.primary { border-color: var(--accent); color: var(--accent); background: rgba(0,212,255,0.08); }
    .ctrl-btn.on { border-color: var(--green); color: var(--green); background: rgba(0,255,136,0.08); }
    .ctrl-btn.danger { border-color: rgba(255,71,87,0.5); color: var(--red); }
    .ctrl-btn:disabled { opacity: 0.35; cursor: default; }

    select.ctrl-btn { appearance: none; padding-right: 1.6em; }

    .chk {
      display: inline-flex; align-items: center; gap: 0.45rem;
      font-family: var(--mono); font-size: 0.74rem; color: var(--text-dim);
      border: 1px solid var(--border); background: var(--surface);
      padding: 0.4em 0.8em; border-radius: 6px; cursor: pointer;
    }
    .chk input { accent-color: var(--accent); cursor: pointer; }

    .slider-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
      gap: 0.9rem 1.5rem;
      margin-bottom: 1rem;
    }
    .slider-row label {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      color: var(--text-dim);
      margin-bottom: 0.25rem;
      gap: 0.5rem;
    }
    .slider-row .val { font-family: var(--mono); color: var(--accent); }
    .slider-row input[type=range] { width: 100%; accent-color: var(--purple); }

    .verdict {
      border-radius: 8px;
      padding: 0.85rem 1.1rem;
      font-family: var(--mono);
      font-size: 0.82rem;
      margin: 1rem 0 1.2rem;
      border: 1px solid var(--border);
      line-height: 1.6;
    }
    .verdict.pass  { border-color: rgba(0,255,136,0.45); background: rgba(0,255,136,0.07); color: var(--green); }
    .verdict.warn  { border-color: rgba(255,215,0,0.45); background: rgba(255,215,0,0.07); color: var(--yellow); }
    .verdict.fail  { border-color: rgba(255,71,87,0.45);  background: rgba(255,71,87,0.07);  color: var(--red); }
    .verdict .sub { display: block; color: var(--text-dim); font-size: 0.76rem; margin-top: 0.35rem; }

    /* ── Registry table ── */
    .tbl-wrap { overflow-x: auto; background: var(--surface); border-radius: 8px; border: 1px solid var(--border); }
    table.registry { width: 100%; min-width: 760px; border-collapse: collapse; font-family: var(--mono); font-size: 0.74rem; }
    table.registry th {
      text-align: left; color: var(--text-dim); font-weight: 500;
      font-size: 0.64rem; letter-spacing: 0.07em; text-transform: uppercase;
      padding: 0.6rem 0.7rem; border-bottom: 1px solid var(--border); white-space: nowrap;
    }
    table.registry td { padding: 0.55rem 0.7rem; border-bottom: 1px solid rgba(37,42,61,0.6); vertical-align: middle; white-space: nowrap; }
    table.registry tr:last-child td { border-bottom: none; }
    table.registry tr.is-prod { background: rgba(0,255,136,0.05); }
    table.registry tr.is-serving td:first-child { box-shadow: inset 3px 0 0 var(--accent); }
    .vnum { color: var(--text); font-weight: 700; }
    .dim { color: var(--text-dim); }
    .missing { color: var(--red); }
    .stage-pill {
      display: inline-block; padding: 0.12em 0.6em; border-radius: 999px;
      font-size: 0.66rem; border: 1px solid var(--border); color: var(--text-dim);
    }
    .stage-pill.Production { color: var(--green); border-color: rgba(0,255,136,0.5); background: rgba(0,255,136,0.08); }
    .stage-pill.Staging { color: var(--yellow); border-color: rgba(255,215,0,0.5); background: rgba(255,215,0,0.08); }
    .stage-pill.Archived { color: var(--text-dim); opacity: 0.7; }
    .stage-pill.None { color: var(--text-dim); }
    .lin-ok { color: var(--green); }
    .lin-bad { color: var(--red); }
    .row-btn {
      font-family: var(--mono); font-size: 0.66rem; padding: 0.22em 0.55em;
      margin-right: 0.28rem; border-radius: 4px; cursor: pointer;
      border: 1px solid var(--border); background: var(--card); color: var(--text-dim);
    }
    .row-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
    .row-btn:disabled { opacity: 0.28; cursor: default; }

    /* ── Serving pane ── */
    .serve-pane {
      background: #0b0d14; border: 1px solid var(--border); border-radius: 8px;
      padding: 0.9rem 1.1rem; font-family: var(--mono); font-size: 0.74rem; line-height: 1.8;
    }
    .serve-pane .k { color: var(--text-dim); display: inline-block; min-width: 148px; }
    .serve-pane .uri { color: var(--accent); word-break: break-all; }
    .serve-pane .warnv { color: var(--yellow); }
    .serve-pane .badv { color: var(--red); }
    .serve-pane .goodv { color: var(--green); }

    .ttlbar { height: 5px; background: var(--border); border-radius: 3px; overflow: hidden; margin-top: 0.5rem; }
    .ttlbar > div { height: 100%; background: var(--accent); width: 0%; }

    .logbox {
      background: #0b0d14; border: 1px solid var(--border); border-radius: 8px;
      font-family: var(--mono); font-size: 0.7rem; line-height: 1.65;
      padding: 0.7rem 0.9rem; height: 180px; overflow-y: auto;
    }
    .log-line { white-space: pre-wrap; color: var(--text-dim); }
    .log-line .t { color: #5b6479; }
    .log-line.ok .m { color: var(--green); }
    .log-line.info .m { color: var(--accent); }
    .log-line.warn .m { color: var(--yellow); }
    .log-line.err .m { color: var(--red); }

    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: 0.7rem; margin: 1rem 0 0.6rem; }
    .stat {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 0.6rem 0.8rem;
    }
    .stat .k { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); }
    .stat .v { font-family: var(--mono); font-size: 1.05rem; color: var(--accent); }
    .stat .v.warnv { color: var(--yellow); }
    .stat .v.badv { color: var(--red); }
    .stat .v.goodv { color: var(--green); }
    .stat .n { font-size: 0.64rem; color: var(--text-dim); font-family: var(--mono); }

    .note-line {
      font-family: var(--mono); font-size: 0.72rem; color: var(--text-dim);
      border-left: 2px solid var(--border); padding-left: 0.7rem; margin: 0.8rem 0 0.2rem;
    }

    .legend { display: flex; flex-wrap: wrap; gap: 0.9rem; font-size: 0.68rem; color: var(--text-dim); font-family: var(--mono); margin-top: 0.6rem; }

    /* ── Interview line ── */
    #interview-line .quote {
      background: linear-gradient(180deg, rgba(124,58,237,0.12), rgba(124,58,237,0.04));
      border: 1px solid rgba(124,58,237,0.45);
      border-left: 4px solid var(--purple);
      border-radius: 0 10px 10px 0;
      padding: 1.3rem 1.5rem;
      font-size: 1.02rem;
      line-height: 1.75;
    }
    #interview-line .quote p:last-child { margin-bottom: 0; }
    #interview-line .quote em { color: var(--yellow); font-style: normal; font-weight: 600; }

    #takeaways li strong { color: var(--accent); }

    .concept-nav {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.5rem 2rem 3rem;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      border-top: 1px solid var(--border);
    }
    .nav-link {
      display: flex; flex-direction: column; gap: 0.2rem;
      text-decoration: none; padding: 0.6rem 1rem;
      border-radius: 8px; border: 1px solid var(--border);
      background: var(--surface); max-width: 240px; transition: all 0.2s;
    }
    .nav-link:hover:not(.disabled) { border-color: var(--accent); }
    .nav-link.disabled { opacity: 0.35; pointer-events: none; }
    .nav-dir { font-family: var(--mono); font-size: 0.7rem; color: var(--text-dim); }
    .nav-title { font-size: 0.9rem; color: var(--text); font-weight: 500; }

    @media (max-width: 640px) {
      header, main { padding-left: 1rem; padding-right: 1rem; }
      .concept-nav { padding-left: 1rem; padding-right: 1rem; flex-direction: column; }
      .nav-link { max-width: 100%; }
    }
  </style>
  <style>
    /* ── Gate-specific ── */
    table.registry td.num { text-align: right; }
    table.registry tr.r-skip td { opacity: 0.42; }
    table.registry tr.r-block { background: rgba(255,71,87,0.07); }
    table.registry tr.r-block td:first-child { box-shadow: inset 3px 0 0 var(--red); }
    table.registry tr.r-noisy { background: rgba(255,215,0,0.05); }
    table.registry tr.r-noisy td:first-child { box-shadow: inset 3px 0 0 var(--yellow); }
    table.registry tr.r-agg td { border-top: 1px solid var(--border); background: rgba(0,212,255,0.05); font-weight: 700; }
    .dpos { color: var(--green); }
    .dneg { color: var(--red); }
    .pill-v {
      display: inline-block; padding: 0.1em 0.55em; border-radius: 999px;
      font-size: 0.64rem; border: 1px solid var(--border); color: var(--text-dim);
    }
    .pill-v.ok    { color: var(--green);    border-color: rgba(0,255,136,0.5); }
    .pill-v.block { color: var(--red);      border-color: rgba(255,71,87,0.5); }
    .pill-v.noisy { color: var(--yellow);   border-color: rgba(255,215,0,0.5); }
    .pill-v.skip  { color: var(--text-dim); }
    .chart-wrap {
      background: #0b0d14; border: 1px solid var(--border);
      border-radius: 8px; padding: 0.4rem; margin-top: 0.4rem;
    }
    .chart-wrap canvas { display: block; width: 100%; }
    .trap {
      border-radius: 8px; padding: 0.8rem 1.05rem; margin: 0.9rem 0 0;
      font-family: var(--mono); font-size: 0.76rem; line-height: 1.65;
      border: 1px solid rgba(255,149,0,0.45); background: rgba(255,149,0,0.07); color: var(--orange);
    }
    .trap.quiet { border-color: var(--border); background: var(--surface); color: var(--text-dim); }
  </style>
</head>
<body>

<header>
  <div class="group-badge">Training</div>
  <h1><span class="id">11</span>Offline Evaluation Gates</h1>
  <p class="desc">Automated promotion gates comparing a candidate against the incumbent on holdout and on named slices, with minimum-improvement and no-regression thresholds — and why a single aggregate metric happily promotes a model that is broken for one segment.</p>
</header>

<main>

<section id="theory">
  <h2>Theory</h2>

  <h3>A gate is a contract, not a leaderboard</h3>
  <p>
    An evaluation gate is the automated answer to one question: <em>is this candidate allowed to become
    <code>@production</code>?</em> It is a boolean computed in CI from metrics over a frozen holdout, and it exists
    because the manual version of that decision — someone glancing at a metrics table in a pull request — is
    exactly the process that waves through a model which is better on average and broken for one segment.
  </p>
  <p>
    The shape is the same in every tool. In TFX the gate is literal: the <code>Evaluator</code> component compares
    the candidate against the current blessed model using <code>MetricThreshold</code> value thresholds and change
    thresholds, emits a <em>blessing</em> artifact, and the <code>Pusher</code> refuses to push an unblessed model.
    TensorFlow Model Analysis computes those metrics per slice as a first-class concept rather than as a
    post-hoc notebook. MLflow's <code>mlflow.evaluate</code> accepts a baseline model plus validation thresholds
    and raises rather than returns when the candidate misses. Whatever the vendor noun, the inputs are candidate
    metrics, baseline metrics and thresholds, and the output is one boolean that a pipeline branches on.
  </p>
  <p>
    State the gate's job narrowly, because interviewers listen for the limits: it <em>blocks a promotion</em>. It
    does not prove the model is good, and it is structurally blind to everything that only exists once the model
    is serving — latency, feature-pipeline breakage, feedback loops, and the business metric nobody can compute
    offline. Passing the gate earns the candidate a shadow deployment and a 1–5% canary, not a rollout.
  </p>

  <h3>Three thresholds, and the one everybody forgets</h3>
  <p>
    <strong>Minimum improvement, not "not worse."</strong> A promotion is not free: it churns predictions users
    have already seen, invalidates downstream caches and precomputed scores, destabilises explanations, and buys a
    fresh opportunity to be wrong. So the gate should demand a lift big enough to be worth those costs, and big
    enough to be distinguishable from holdout noise. A candidate that is +0.0004 better is noise with a version
    number.
  </p>
  <p>
    <strong>Per-slice no-regression.</strong> For each named slice — protected attributes, top revenue segments,
    the platforms your business actually runs on — the candidate may not lose more than a tolerance. This is the
    threshold that catches the failure the aggregate hides.
  </p>
  <p>
    <strong>Minimum slice support.</strong> This is the third threshold and the one teams skip. A slice with 40
    rows has an enormous standard error; without a support floor it fires constantly and people learn to ignore
    the gate. But the support floor is also the most effective way ever invented to silently switch the gate off
    for exactly the segments you most need it for, because the smallest slices are usually the newest market, the
    minority language, or the highest-value tier. Raising <code>min_slice_support</code> until the noise stops is
    threshold gaming; the honest fix is to oversample those slices into the holdout so they clear the floor.
  </p>

  <h3>The aggregate is the wrong number</h3>
  <p>
    Aggregate accuracy is a support-weighted average, so a slice's influence on it is its share of traffic. A
    segment at 4.5% of rows can lose 9 points of accuracy and move the weighted aggregate by 0.4 points — roughly
    the half-width of the 95% interval on a single accuracy estimate from a 20,000-row holdout at ~91% accuracy
    (1.96·√(0.91·0.09/20000) ≈ 0.004). The aggregate does not merely under-weight the regression; it puts it
    underneath the noise floor of the very number the gate is thresholding.
  </p>
  <p>
    The stronger version is Simpson's paradox: the aggregate improves while <em>every</em> slice degrades. That
    requires the slice mix to differ between the two measurements, which is why the non-negotiable rule is that
    the candidate and the baseline are scored on <em>the same rows</em>. Comparing this week's candidate against
    last quarter's recorded baseline number lets a mix shift alone decide the promotion.
  </p>

  <h3>Same rows means a paired test</h3>
  <p>
    Because both models score the identical holdout, the two accuracies are not independent samples, and the
    two-proportion z-test is the wrong instrument. The right one is McNemar's test on the discordant pairs: let
    <code>b</code> be the rows the baseline got right and the candidate got wrong, and <code>c</code> the reverse.
    Rows both models agree on carry no information about which is better. The statistic is
    <code>χ² = (|b − c| − 1)² / (b + c)</code> with 1 degree of freedom, and the accuracy difference is
    <code>(c − b) / n</code> with variance <code>[b + c − (c − b)²/n] / n²</code>. Two production models typically
    agree on the large majority of rows, so that paired variance is much smaller than the unpaired one — the
    two-proportion test overstates the variance, and an underpowered gate is a gate that misses real regressions.
  </p>

  <h3>Slices multiply, and so do false alarms</h3>
  <p>
    Every slice you evaluate is another hypothesis test. Twenty slices at α = 0.05 on a genuinely
    equivalent candidate gives a 1 − 0.95²⁰ ≈ 64% chance of at least one spurious regression. Two defences, and
    you want both: a Bonferroni-style correction (α/m over the m evaluated slices) so significance means
    something, and an effect-size floor so that statistical significance alone cannot block a release. Requiring
    a regression to be <em>both</em> larger than the tolerance and significant is the practical compromise; it is
    also, note, a knob that can be tuned until nothing ever blocks.
  </p>

  <h3>The named failure modes</h3>
  <ul>
    <li><strong>Gate overfitting (holdout adaptivity).</strong> The fortieth candidate evaluated against the same
      holdout is no longer being measured by an unbiased estimate — the team has been doing gradient descent on
      the test set by hand. Rotate the holdout, and keep a sealed set that is used only for the final promotion.</li>
    <li><strong>Eval-set staleness.</strong> A holdout frozen a year ago measures a world that no longer exists.
      The gate stays green while production degrades, which is drift arriving through the evaluation set rather
      than the model.</li>
    <li><strong>Leakage into the holdout.</strong> If the feature join was not point-in-time correct, both models
      are inflated and the gate compares two fictional numbers. An offline gate cannot detect this; only the
      online result will.</li>
    <li><strong>Threshold laundering.</strong> Loosening the tolerance or raising the support floor to get a
      release out is the most common way a gate stops working, and it leaves no trace unless the thresholds live
      in version-controlled config, are reviewed like code, and are recorded on the model version.</li>
    <li><strong>Silent degradation past the gate.</strong> The gate answers a question about a frozen dataset. It
      says nothing about the model whose accuracy erodes three weeks after promotion, which is a monitoring
      problem and needs labels to detect at all.</li>
  </ul>
</section>

<section id="visualization">
  <h2>Visualization</h2>

  <div class="viz-card">
    <div class="viz-title">Gate simulator — find the thresholds that let a slice-regressing model through</div>
    <div class="viz-desc">
      A synthetic holdout is scored by both models row by row: every row gets a baseline outcome and a correlated
      candidate outcome, so the comparison is genuinely paired and the 2×2 discordance table below is real, not
      illustrative. Inject a true regression into one slice, then tune the three gate thresholds until a broken
      model gets a PROMOTE.
    </div>

    <div class="sub-h">Candidate under test</div>
    <div class="slider-grid">
      <div class="slider-row">
        <label>holdout rows <span class="val" id="vN">20,000</span></label>
        <input type="range" id="sldN" min="2000" max="60000" step="1000" value="20000"/>
      </div>
      <div class="slider-row">
        <label>true lift on other slices <span class="val" id="vLift">+0.60 pp</span></label>
        <input type="range" id="sldLift" min="-50" max="200" step="5" value="60"/>
      </div>
      <div class="slider-row">
        <label>true regression depth <span class="val" id="vReg">9.0 pp</span></label>
        <input type="range" id="sldReg" min="0" max="200" step="5" value="90"/>
      </div>
      <div class="slider-row">
        <label>model agreement rate <span class="val" id="vRho">0.90</span></label>
        <input type="range" id="sldRho" min="50" max="99" step="1" value="90"/>
      </div>
    </div>
    <div class="preset-row">
      <label class="chk">
        regress slice
        <select class="ctrl-btn" id="selReg" style="padding:0.1em 1.4em 0.1em 0.4em"></select>
      </label>
      <button class="ctrl-btn" id="btnResample">↻ resample holdout</button>
      <span class="note-line" style="margin:0">presets:</span>
      <button class="ctrl-btn primary" id="pTrap">the trap</button>
      <button class="ctrl-btn" id="pNoise">noisy slices, no regression</button>
      <button class="ctrl-btn" id="pCaught">regression caught</button>
      <button class="ctrl-btn" id="pClean">clean win</button>
    </div>

    <div class="sub-h">Gate configuration (promotion_gate.yaml)</div>
    <div class="slider-grid">
      <div class="slider-row">
        <label>min_overall_lift <span class="val" id="vMin">+0.10 pp</span></label>
        <input type="range" id="sldMin" min="-50" max="200" step="5" value="10"/>
      </div>
      <div class="slider-row">
        <label>slice_regression_tol <span class="val" id="vTol">1.0 pp</span></label>
        <input type="range" id="sldTol" min="0" max="100" step="5" value="10"/>
      </div>
      <div class="slider-row">
        <label>min_slice_support <span class="val" id="vSup">500 rows</span></label>
        <input type="range" id="sldSup" min="50" max="4000" step="50" value="500"/>
      </div>
    </div>
    <div class="preset-row">
      <label class="chk"><input type="checkbox" id="cbSig" checked/> require significance to block</label>
      <label class="chk">
        test
        <select class="ctrl-btn" id="selTest" style="padding:0.1em 1.4em 0.1em 0.4em">
          <option value="mcnemar">McNemar (paired — same rows)</option>
          <option value="zprop">two-proportion z (unpaired)</option>
        </select>
      </label>
      <label class="chk"><input type="checkbox" id="cbBonf"/> Bonferroni α/m across slices</label>
    </div>

    <div id="verdict" class="verdict pass"></div>
    <div id="trap" class="trap quiet"></div>

    <div class="stat-grid">
      <div class="stat"><div class="k">baseline accuracy</div><div class="v" id="stBase">—</div><div class="n">weighted over holdout</div></div>
      <div class="stat"><div class="k">candidate accuracy</div><div class="v" id="stCand">—</div><div class="n">same rows, paired</div></div>
      <div class="stat"><div class="k">overall Δ</div><div class="v" id="stDelta">—</div><div class="n">(c − b) / n</div></div>
      <div class="stat"><div class="k">discordant pairs</div><div class="v" id="stDisc">—</div><div class="n">b + c · all the signal</div></div>
      <div class="stat"><div class="k">slices evaluated</div><div class="v" id="stEval">—</div><div class="n">n ≥ min_slice_support</div></div>
      <div class="stat"><div class="k">rows not gated</div><div class="v" id="stUngated">—</div><div class="n">inside skipped slices</div></div>
    </div>
  </div>

  <div class="viz-card">
    <div class="viz-title">Per-slice evaluation</div>
    <div class="viz-desc">
      Measured Δ with its 95% interval, against the true Δ the simulator actually injected. When a red diamond
      sits outside a bar's interval, the holdout is too small to see the regression it contains.
    </div>
    <div class="chart-wrap"><canvas id="cv"></canvas></div>
    <div class="legend">
      <span style="color:var(--green)">■ candidate better</span>
      <span style="color:var(--red)">■ candidate worse</span>
      <span style="color:var(--yellow)">◆ true Δ (ground truth, unobservable in reality)</span>
      <span>├─┤ 95% interval</span>
      <span style="color:var(--red)">┆ regression tolerance</span>
    </div>

    <div class="sub-h">Slice table</div>
    <div class="tbl-wrap">
      <table class="registry">
        <thead>
          <tr>
            <th>slice</th><th>n</th><th>base acc</th><th>cand acc</th><th>Δ (pp)</th>
            <th>true Δ</th><th>b / c</th><th>p</th><th>verdict</th>
          </tr>
        </thead>
        <tbody id="tblBody"></tbody>
      </table>
    </div>
    <div class="note-line" id="alphaNote"></div>
  </div>

  <div class="viz-card">
    <div class="viz-title">The gate, as code</div>
    <div class="viz-desc">
      This is the function the simulator above runs, transcribed to Python. Note what it returns for a
      low-support slice: not a pass, but an unanswered question the caller has to decide about.
    </div>
<pre><code><span class="kw">from</span> math <span class="kw">import</span> erfc, sqrt

<span class="kw">def</span> <span class="fn">mcnemar_p</span>(b, c):
    <span class="st">"""Two-sided p-value for paired binary outcomes, continuity-corrected."""</span>
    n = b + c
    <span class="kw">if</span> n == 0:
        <span class="kw">return</span> 1.0
    chi2 = (abs(b - c) - 1) ** 2 / n      <span class="cm"># 1 degree of freedom</span>
    <span class="kw">return</span> erfc(sqrt(chi2 / 2))           <span class="cm"># == 2 * (1 - Phi(sqrt(chi2)))</span>

<span class="kw">def</span> <span class="fn">evaluate_gate</span>(rows, cfg):
    <span class="st">"""rows: (slice_id, baseline_correct, candidate_correct) over ONE holdout."""</span>
    tab = {}                              <span class="cm"># slice -> [n, a, b, c]</span>
    <span class="kw">for</span> s, base_ok, cand_ok <span class="kw">in</span> rows:
        t = tab.setdefault(s, [0, 0, 0, 0])
        t[0] += 1
        t[1] += base_ok <span class="kw">and</span> cand_ok           <span class="cm"># a: concordant right</span>
        t[2] += base_ok <span class="kw">and not</span> cand_ok       <span class="cm"># b: candidate lost the row</span>
        t[3] += cand_ok <span class="kw">and not</span> base_ok       <span class="cm"># c: candidate won the row</span>

    evaluated = [s <span class="kw">for</span> s, t <span class="kw">in</span> tab.items() <span class="kw">if</span> t[0] &gt;= cfg[<span class="st">"min_slice_support"</span>]]
    alpha = cfg[<span class="st">"alpha"</span>] / len(evaluated) <span class="kw">if</span> cfg[<span class="st">"bonferroni"</span>] <span class="kw">else</span> cfg[<span class="st">"alpha"</span>]

    failures, unevaluated = [], []
    <span class="kw">for</span> s, (n, _a, b, c) <span class="kw">in</span> tab.items():
        <span class="kw">if</span> n &lt; cfg[<span class="st">"min_slice_support"</span>]:
            unevaluated.append((s, n))    <span class="cm"># NOT a pass — an unanswered question</span>
            <span class="kw">continue</span>
        delta = (c - b) / n               <span class="cm"># candidate minus baseline accuracy</span>
        <span class="kw">if</span> delta &lt; -cfg[<span class="st">"slice_regression_tol"</span>]:
            p = mcnemar_p(b, c)
            <span class="kw">if</span> <span class="kw">not</span> cfg[<span class="st">"require_significance"</span>] <span class="kw">or</span> p &lt; alpha:
                failures.append((s, delta, p))

    n_all = sum(t[0] <span class="kw">for</span> t <span class="kw">in</span> tab.values())
    b_all = sum(t[2] <span class="kw">for</span> t <span class="kw">in</span> tab.values())
    c_all = sum(t[3] <span class="kw">for</span> t <span class="kw">in</span> tab.values())
    overall = (c_all - b_all) / n_all     <span class="cm"># paired: only discordants move it</span>

    <span class="kw">return</span> {
        <span class="st">"promote"</span>: overall &gt;= cfg[<span class="st">"min_overall_lift"</span>] <span class="kw">and not</span> failures,
        <span class="st">"overall_delta"</span>: overall,
        <span class="st">"slice_failures"</span>: failures,
        <span class="st">"unevaluated"</span>: unevaluated,
    }
</code></pre>
    <div class="note-line">
      Wire it into the pipeline so the boolean is the only thing that decides: <code>evaluate_gate(...)["promote"]</code>
      gates the <code>register_model</code> / stage-transition step, and <code>cfg</code> is committed alongside
      the training code and stamped onto the model version.
    </div>
  </div>
</section>

<section id="interview-line">
  <h2>The Interview Line</h2>
  <div class="quote">
    <p>
      "A promotion gate is three thresholds, not one: a <em>minimum lift</em> on the overall metric, a
      <em>per-slice regression tolerance</em>, and a <em>minimum slice support</em>. The aggregate on its own is
      almost useless as a safety check, because it is support-weighted — a segment that's four percent of traffic
      can lose nine points of accuracy and move the overall number by less than the confidence interval on that
      number. So the gate that actually protects you is the per-slice one."
    </p>
    <p>
      "Two details I'd insist on. Both models score <em>the same holdout rows</em>, which makes the comparison
      paired — so I use <em>McNemar on the discordant pairs</em>, not a two-proportion z-test, which overstates
      the variance and leaves the gate too underpowered to catch the regression it exists to catch. And the
      minimum-support threshold is the dangerous one: it's the knob people quietly raise to get a release out, and
      raising it silences the gate for exactly the small, high-value slices you cared about. I'd rather oversample
      those slices into the holdout so they clear the floor honestly, keep the thresholds in version-controlled
      config stamped onto the model version, and treat a green gate as permission to run a 1–5% canary — not as
      evidence the model is better."
    </p>
  </div>
</section>

<section id="takeaways">
  <h2>Key Takeaways</h2>
  <ul>
    <li><strong>Gate on slices or don't bother.</strong> Aggregate accuracy is support-weighted, so a 4.5% slice
      losing 9 points shifts it by ~0.4 points — under the noise floor of a 20k holdout. TFX's
      <code>Evaluator</code> + TFMA compute per-slice thresholds and emit a <em>blessing</em> the
      <code>Pusher</code> requires; MLflow's <code>mlflow.evaluate</code> takes a baseline model and validation
      thresholds and raises on failure. Both give you the slot — teams just configure one aggregate metric.</li>
    <li><strong>Same rows, paired test.</strong> Candidate and baseline must score the identical holdout, which
      makes McNemar (<code>χ² = (|b−c|−1)²/(b+c)</code>, 1 df) the correct test. The unpaired two-proportion z-test
      overstates variance because two models agree on most rows — an underpowered gate misses real regressions.
      Comparing against a baseline number recorded on a different eval set invites Simpson's paradox.</li>
    <li><strong><code>min_slice_support</code> is where gates go to die.</strong> It is necessary — a 40-row slice
      is pure noise — and it is the most effective silent off-switch in the config, because your smallest slices
      are your newest market and your highest-value tier. Report the number of holdout rows sitting inside
      skipped slices on every run; an unevaluated slice is an unanswered question, not a pass.</li>
    <li><strong>Require magnitude AND significance, and correct for m slices.</strong> Twenty slices at α=0.05
      gives ~64% chance of at least one false regression on an equivalent candidate. Bonferroni (α/m) plus an
      effect-size floor keeps the gate from crying wolf without letting a real 9-point drop through.</li>
    <li><strong>Demand a minimum improvement, not just "no worse."</strong> Every promotion costs prediction
      churn, cache invalidation and unstable explanations. If the lift is inside the interval, the correct action
      is to keep the incumbent — stability has value that the offline metric does not price.</li>
    <li><strong>The holdout wears out.</strong> By the fortieth candidate you are hand-tuning on the test set;
      rotate the holdout, keep a sealed final-decision set, and refresh it as traffic drifts. And version the
      thresholds with the model — a gate whose config can be edited in the release PR is documentation, not a
      control.</li>
    <li><strong>A green gate is not a green light.</strong> Offline evaluation cannot see latency regressions,
      feature-pipeline breakage, feedback loops or the business metric. It buys the candidate a shadow deployment
      and a 1–5% canary; the online result is the one that decides.</li>
  </ul>
</section>

</main>

<nav class="concept-nav">
  <a class="nav-link" href="./10-model-registry.html">
    <span class="nav-dir">← Previous</span>
    <span class="nav-title">Model Registry and Stage Promotion</span>
  </a>
  <a class="nav-link" href="./12-serving-patterns.html">
    <span class="nav-dir">Next →</span>
    <span class="nav-title">Batch, Online, and Streaming Inference</span>
  </a>
</nav>

<script>
(function () {
  'use strict';

  function el(id) { return document.getElementById(id); }
  function pp(x) { return (x * 100).toFixed(2); }
  function sgn(x) { return (x >= 0 ? '+' : '') + pp(x); }

  // Numerical Recipes erfcc — fractional error < 1.2e-7, plenty for a p-value readout.
  function erfc(x) {
    var z = Math.abs(x), t = 1 / (1 + 0.5 * z);
    var ans = t * Math.exp(-z * z - 1.26551223 + t * (1.00002368 + t * (0.37409196 +
      t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 +
      t * (1.48851587 + t * (-0.82215223 + t * 0.17087277))))))))); 
    return x >= 0 ? ans : 2 - ans;
  }
  // Two-sided p from a chi-square with 1 df: P(|Z| > sqrt(chi2)).
  function pFromChi1(chi2) { return erfc(Math.sqrt(Math.max(chi2, 0) / 2)); }
  function pFromZ(z) { return erfc(Math.abs(z) / Math.SQRT2); }

  function mcnemarP(b, c) {
    var n = b + c;
    if (n === 0) return 1;
    var chi2 = Math.pow(Math.abs(b - c) - 1, 2) / n;   // continuity-corrected, 1 df
    return pFromChi1(chi2);
  }
  // Unpaired pooled two-proportion z-test, equal n (same holdout size for both arms).
  function twoPropP(xb, xc, n) {
    var pHat = (xb + xc) / (2 * n);
    var se = Math.sqrt(pHat * (1 - pHat) * (2 / n));
    if (se === 0) return 1;
    return pFromZ(((xc / n) - (xb / n)) / se);
  }

  function mulberry32(a) {
    return function () {
      a |= 0; a = a + 0x6D2B79F5 | 0;
      var t = Math.imul(a ^ a >>> 15, 1 | a);
      t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    };
  }

  // Slice definition: share of holdout rows and the baseline model's true accuracy there.
  var SLICES = [
    { id: 'device=android',     share: 0.340, base: 0.912 },
    { id: 'device=ios',         share: 0.280, base: 0.926 },
    { id: 'device=web',         share: 0.190, base: 0.897 },
    { id: 'locale=pt-BR',       share: 0.080, base: 0.884 },
    { id: 'tier=enterprise',    share: 0.045, base: 0.933 },
    { id: 'channel=partner_api',share: 0.035, base: 0.871 },
    { id: 'device=kaios_lite',  share: 0.030, base: 0.842 }
  ];

  var seed = 20260903;

  // ── Populate the regression-target dropdown ──
  var sel = el('selReg');
  var opt = document.createElement('option');
  opt.value = 'none'; opt.textContent = 'none (candidate is uniformly better)';
  sel.appendChild(opt);
  SLICES.forEach(function (s) {
    var o = document.createElement('option');
    o.value = s.id; o.textContent = s.id;
    sel.appendChild(o);
  });
  sel.value = 'tier=enterprise';

  // ── Simulation: score every holdout row with BOTH models, paired ──
  // Each row draws a latent difficulty u. The baseline is right when u < p_base.
  // With probability rho the candidate reuses the same u (the models agree on the
  // easy/hard structure of the row); otherwise it draws its own. That produces a
  // correlated Bernoulli pair, so the 2x2 discordance table b/c is real.
  function simulate() {
    var N = +el('sldN').value,
        lift = +el('sldLift').value / 10000,
        reg = +el('sldReg').value / 1000,
        rho = +el('sldRho').value / 100,
        target = el('selReg').value;
    var rnd = mulberry32(seed);
    return SLICES.map(function (sl) {
      var n = Math.max(1, Math.round(N * sl.share));
      var pb = sl.base;
      var pc = (sl.id === target) ? pb - reg : pb + lift;
      pc = Math.min(0.999, Math.max(0.005, pc));
      var a = 0, b = 0, c = 0, d = 0;
      for (var i = 0; i < n; i++) {
        var u = rnd();
        var baseOk = u < pb;
        var u2 = (rnd() < rho) ? u : rnd();
        var candOk = u2 < pc;
        if (baseOk && candOk) a++;
        else if (baseOk) b++;
        else if (candOk) c++;
        else d++;
      }
      return { id: sl.id, n: n, a: a, b: b, c: c, d: d, trueDelta: pc - pb };
    });
  }

  // ── The gate itself ──
  function evaluate(rows, cfg) {
    var evaluated = rows.filter(function (r) { return r.n >= cfg.minSupport; });
    var alpha = cfg.bonf ? 0.05 / Math.max(1, evaluated.length) : 0.05;

    rows.forEach(function (r) {
      var xb = r.a + r.b, xc = r.a + r.c;
      r.baseAcc = xb / r.n;
      r.candAcc = xc / r.n;
      r.delta = (r.c - r.b) / r.n;
      // Paired Wald variance of the difference of proportions (Agresti):
      //   Var = [b + c - (c - b)^2 / n] / n^2
      var vPaired = (r.b + r.c - Math.pow(r.c - r.b, 2) / r.n) / (r.n * r.n);
      var vUnpaired = r.baseAcc * (1 - r.baseAcc) / r.n + r.candAcc * (1 - r.candAcc) / r.n;
      r.se = Math.sqrt(Math.max(cfg.test === 'mcnemar' ? vPaired : vUnpaired, 0));
      r.p = cfg.test === 'mcnemar' ? mcnemarP(r.b, r.c) : twoPropP(xb, xc, r.n);

      if (r.n < cfg.minSupport) {
        r.verdict = 'skip';
      } else if (r.delta < -cfg.tol - 1e-12) {
        r.verdict = (cfg.reqSig && r.p >= alpha) ? 'noisy' : 'block';
      } else {
        r.verdict = 'ok';
      }
    });

    var nAll = 0, bAll = 0, cAll = 0, aAll = 0;
    rows.forEach(function (r) { nAll += r.n; bAll += r.b; cAll += r.c; aAll += r.a; });
    var agg = {
      id: 'AGGREGATE (weighted)', n: nAll, a: aAll, b: bAll, c: cAll,
      baseAcc: (aAll + bAll) / nAll, candAcc: (aAll + cAll) / nAll,
      delta: (cAll - bAll) / nAll, trueDelta: null
    };
    var vAgg = (bAll + cAll - Math.pow(cAll - bAll, 2) / nAll) / (nAll * nAll);
    agg.se = Math.sqrt(Math.max(vAgg, 0));
    agg.p = cfg.test === 'mcnemar'
      ? mcnemarP(bAll, cAll)
      : twoPropP(aAll + bAll, aAll + cAll, nAll);

    var blocking = rows.filter(function (r) { return r.verdict === 'block'; });
    var liftOk = agg.delta >= cfg.minLift - 1e-12;

    return {
      agg: agg, alpha: alpha, blocking: blocking, liftOk: liftOk,
      evaluatedCount: evaluated.length,
      ungatedRows: rows.reduce(function (s, r) { return s + (r.verdict === 'skip' ? r.n : 0); }, 0),
      promote: liftOk && blocking.length === 0
    };
  }

  function readCfg() {
    return {
      minLift: +el('sldMin').value / 10000,
      tol: +el('sldTol').value / 1000,
      minSupport: +el('sldSup').value,
      reqSig: el('cbSig').checked,
      bonf: el('cbBonf').checked,
      test: el('selTest').value
    };
  }

  // ── Chart ──
  function draw(rows, res, cfg) {
    var cv = el('cv');
    var W = cv.parentNode.clientWidth || 700;
    var all = rows.concat([res.agg]);
    var rowH = 32;
    var H = rowH * all.length + 64;
    var dpr = window.devicePixelRatio || 1;
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    cv.style.height = H + 'px';
    var g = cv.getContext('2d');
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, W, H);

    var padL = Math.max(120, Math.min(196, W * 0.34)), padR = 46;
    var x0 = padL, x1 = W - padR, mid = (x0 + x1) / 2;

    var maxAbs = Math.max(cfg.tol, 0.015);
    all.forEach(function (r) {
      maxAbs = Math.max(maxAbs, Math.abs(r.delta) + 1.96 * r.se);
      if (r.trueDelta !== null && r.trueDelta !== undefined) maxAbs = Math.max(maxAbs, Math.abs(r.trueDelta));
    });
    maxAbs *= 1.18;
    function X(v) { return mid + (v / maxAbs) * ((x1 - x0) / 2); }

    g.font = '10px "JetBrains Mono", monospace';
    g.textBaseline = 'middle';

    // axis
    g.strokeStyle = '#252a3d'; g.lineWidth = 1;
    g.beginPath(); g.moveTo(mid, 22); g.lineTo(mid, H - 26); g.stroke();
    g.fillStyle = '#8892a4'; g.textAlign = 'center';
    g.fillText('-' + pp(maxAbs) + ' pp', x0 + 24, 12);
    g.fillText('0', mid, 12);
    g.fillText('+' + pp(maxAbs) + ' pp', x1 - 24, 12);

    // regression tolerance line
    var xt = X(-cfg.tol);
    g.save();
    g.setLineDash([4, 4]); g.strokeStyle = 'rgba(255,71,87,0.65)';
    g.beginPath(); g.moveTo(xt, 22); g.lineTo(xt, H - 26); g.stroke();
    g.restore();
    g.fillStyle = 'rgba(255,71,87,0.8)';
    g.fillText('tol', xt, H - 14);

    all.forEach(function (r, i) {
      var y = 34 + i * rowH + rowH / 2;
      var isAgg = (r === res.agg);

      if (isAgg) {
        g.strokeStyle = '#252a3d';
        g.beginPath(); g.moveTo(8, y - rowH / 2 - 2); g.lineTo(W - 8, y - rowH / 2 - 2); g.stroke();
      }

      g.textAlign = 'right';
      g.fillStyle = isAgg ? '#00d4ff' : (r.verdict === 'skip' ? '#5b6479' : '#e2e8f0');
      var label = r.id.length > 20 ? r.id.slice(0, 19) + '…' : r.id;
      g.fillText(label, x0 - 46, y - 5);
      g.fillStyle = '#5b6479';
      g.fillText('n=' + r.n.toLocaleString(), x0 - 46, y + 7);

      // bar
      var xd = X(r.delta);
      var pos = r.delta >= 0;
      var col = pos ? '0,255,136' : '255,71,87';
      var alphaBar = (r.verdict === 'skip') ? 0.3 : (isAgg ? 0.95 : 0.8);
      g.fillStyle = 'rgba(' + col + ',' + alphaBar + ')';
      g.fillRect(Math.min(mid, xd), y - 5, Math.abs(xd - mid), 10);

      // 95% interval
      var lo = X(r.delta - 1.96 * r.se), hi = X(r.delta + 1.96 * r.se);
      g.strokeStyle = 'rgba(226,232,240,' + (r.verdict === 'skip' ? 0.25 : 0.6) + ')';
      g.lineWidth = 1;
      g.beginPath();
      g.moveTo(lo, y); g.lineTo(hi, y);
      g.moveTo(lo, y - 5); g.lineTo(lo, y + 5);
      g.moveTo(hi, y - 5); g.lineTo(hi, y + 5);
      g.stroke();

      // true delta marker
      if (r.trueDelta !== null && r.trueDelta !== undefined) {
        var xtd = X(r.trueDelta);
        g.fillStyle = '#ffd700';
        g.beginPath();
        g.moveTo(xtd, y - 7); g.lineTo(xtd + 5, y); g.lineTo(xtd, y + 7); g.lineTo(xtd - 5, y);
        g.closePath(); g.fill();
      }

      g.textAlign = 'left';
      g.fillStyle = r.verdict === 'block' ? '#ff4757'
        : r.verdict === 'noisy' ? '#ffd700'
        : r.verdict === 'skip' ? '#5b6479' : '#8892a4';
      g.fillText(sgn(r.delta), x1 + 6, y);
    });
  }

  // ── Render ──
  function render() {
    el('vN').textContent = (+el('sldN').value).toLocaleString();
    el('vLift').textContent = (+el('sldLift').value >= 0 ? '+' : '') + (+el('sldLift').value / 100).toFixed(2) + ' pp';
    el('vReg').textContent = (+el('sldReg').value / 10).toFixed(1) + ' pp';
    el('vRho').textContent = (+el('sldRho').value / 100).toFixed(2);
    el('vMin').textContent = (+el('sldMin').value >= 0 ? '+' : '') + (+el('sldMin').value / 100).toFixed(2) + ' pp';
    el('vTol').textContent = (+el('sldTol').value / 10).toFixed(1) + ' pp';
    el('vSup').textContent = (+el('sldSup').value).toLocaleString() + ' rows';

    var cfg = readCfg();
    var rows = simulate();
    var res = evaluate(rows, cfg);

    // verdict banner
    var v = el('verdict');
    var reasons = [];
    if (!res.liftOk) reasons.push('overall Δ ' + sgn(res.agg.delta) + ' pp < min_overall_lift ' + sgn(cfg.minLift) + ' pp');
    res.blocking.forEach(function (r) {
      reasons.push(r.id + ' regressed ' + pp(r.delta) + ' pp (tol −' + pp(cfg.tol) + ', p=' + r.p.toFixed(4) + ')');
    });
    if (res.promote) {
      v.className = 'verdict pass';
      v.innerHTML = 'GATE PASSED → promote candidate to @production'
        + '<span class="sub">overall Δ ' + sgn(res.agg.delta) + ' pp (p=' + res.agg.p.toFixed(4) + ') · '
        + res.evaluatedCount + '/' + rows.length + ' slices evaluated · 0 blocking regressions</span>';
    } else {
      v.className = 'verdict fail';
      v.innerHTML = 'GATE BLOCKED → candidate stays in Staging'
        + '<span class="sub">' + reasons.join('<br>') + '</span>';
    }

    // the trap: a true regression the gate did not stop
    var hidden = rows.filter(function (r) {
      return r.trueDelta < -cfg.tol - 1e-12 && r.verdict !== 'block';
    });
    var falseAlarms = rows.filter(function (r) {
      return r.verdict === 'block' && r.trueDelta >= -cfg.tol - 1e-12;
    });
    var t = el('trap');
    if (res.promote && hidden.length) {
      var r0 = hidden[0], why;
      if (r0.verdict === 'skip') {
        why = 'min_slice_support = ' + cfg.minSupport.toLocaleString() + ' excludes it (n = ' + r0.n.toLocaleString() + '), so the gate never asked';
      } else if (r0.delta >= -cfg.tol - 1e-12) {
        why = 'the measured Δ is only ' + sgn(r0.delta) + ' pp — sampling noise on ' + r0.n.toLocaleString() + ' rows hid a ' + pp(r0.trueDelta) + ' pp drop';
      } else {
        why = 'the regression is real but p = ' + r0.p.toFixed(3) + ' ≥ α = ' + res.alpha.toFixed(4) + ', and "require significance to block" is on';
      }
      t.className = 'trap';
      t.innerHTML = '⚠ SHIPPED A REGRESSION — ' + r0.id + ' truly lost ' + Math.abs(r0.trueDelta * 100).toFixed(1)
        + ' pp of accuracy and the gate said PROMOTE.<br>Why it got through: ' + why + '.';
    } else if (falseAlarms.length) {
      t.className = 'trap';
      t.innerHTML = '⚠ FALSE ALARM — ' + falseAlarms.map(function (r) { return r.id; }).join(', ')
        + ' blocked the release with no true regression underneath. This is how teams learn to raise the thresholds.';
    } else if (hidden.length) {
      t.className = 'trap quiet';
      t.innerHTML = 'A true regression exists in ' + hidden.map(function (r) { return r.id; }).join(', ')
        + ' but something else blocked the gate first — it was stopped by luck, not by the slice check.';
    } else {
      t.className = 'trap quiet';
      t.innerHTML = 'No hidden regression and no false alarm at these thresholds. Raise min_slice_support past a '
        + 'small slice, or widen the tolerance, and watch that change.';
    }

    // stats
    el('stBase').textContent = (res.agg.baseAcc * 100).toFixed(2) + '%';
    el('stCand').textContent = (res.agg.candAcc * 100).toFixed(2) + '%';
    var sd = el('stDelta');
    sd.textContent = sgn(res.agg.delta) + ' pp';
    sd.className = 'v ' + (res.agg.delta >= 0 ? 'goodv' : 'badv');
    el('stDisc').textContent = (res.agg.b + res.agg.c).toLocaleString();
    el('stEval').textContent = res.evaluatedCount + ' / ' + rows.length;
    var su = el('stUngated');
    su.textContent = res.ungatedRows.toLocaleString();
    su.className = 'v ' + (res.ungatedRows > 0 ? 'warnv' : 'goodv');

    // table
    var body = el('tblBody');
    body.innerHTML = '';
    function cell(html, cls) {
      var td = document.createElement('td');
      if (cls) td.className = cls;
      td.innerHTML = html;
      return td;
    }
    function deltaCell(d) {
      return '<span class="' + (d >= 0 ? 'dpos' : 'dneg') + '">' + sgn(d) + '</span>';
    }
    rows.forEach(function (r) {
      var tr = document.createElement('tr');
      tr.className = 'r-' + r.verdict;
      tr.appendChild(cell(r.id));
      tr.appendChild(cell(r.n.toLocaleString(), 'num'));
      tr.appendChild(cell((r.baseAcc * 100).toFixed(2) + '%', 'num dim'));
      tr.appendChild(cell((r.candAcc * 100).toFixed(2) + '%', 'num'));
      tr.appendChild(cell(deltaCell(r.delta), 'num'));
      tr.appendChild(cell('<span class="dim">' + deltaCell(r.trueDelta) + '</span>', 'num'));
      tr.appendChild(cell('<span class="dim">' + r.b + ' / ' + r.c + '</span>', 'num'));
      tr.appendChild(cell(r.p < 0.0001 ? '&lt;0.0001' : r.p.toFixed(4), 'num'));
      var vp = { ok: 'pass', block: 'REGRESSION', noisy: 'not significant', skip: 'low support' }[r.verdict];
      tr.appendChild(cell('<span class="pill-v ' + r.verdict + '">' + vp + '</span>'));
      body.appendChild(tr);
    });
    var trA = document.createElement('tr');
    trA.className = 'r-agg';
    trA.appendChild(cell(res.agg.id));
    trA.appendChild(cell(res.agg.n.toLocaleString(), 'num'));
    trA.appendChild(cell((res.agg.baseAcc * 100).toFixed(2) + '%', 'num dim'));
    trA.appendChild(cell((res.agg.candAcc * 100).toFixed(2) + '%', 'num'));
    trA.appendChild(cell(deltaCell(res.agg.delta), 'num'));
    trA.appendChild(cell('<span class="dim">—</span>', 'num'));
    trA.appendChild(cell('<span class="dim">' + res.agg.b + ' / ' + res.agg.c + '</span>', 'num'));
    trA.appendChild(cell(res.agg.p < 0.0001 ? '&lt;0.0001' : res.agg.p.toFixed(4), 'num'));
    trA.appendChild(cell('<span class="pill-v ' + (res.liftOk ? 'ok' : 'block') + '">'
      + (res.liftOk ? 'lift met' : 'lift missed') + '</span>'));
    body.appendChild(trA);

    el('alphaNote').innerHTML = 'test: <code>' + (cfg.test === 'mcnemar'
      ? 'McNemar χ² on discordant pairs (paired)'
      : 'pooled two-proportion z (treats the two arms as independent samples)')
      + '</code> · α = ' + res.alpha.toFixed(4)
      + (cfg.bonf ? ' (0.05 / ' + res.evaluatedCount + ' evaluated slices)' : ' (uncorrected)')
      + ' · b = baseline right &amp; candidate wrong, c = the reverse; concordant rows carry no information.';

    draw(rows, res, cfg);
  }

  // ── Wiring ──
  ['sldN', 'sldLift', 'sldReg', 'sldRho', 'sldMin', 'sldTol', 'sldSup'].forEach(function (id) {
    el(id).addEventListener('input', render);
  });
  ['selReg', 'selTest', 'cbSig', 'cbBonf'].forEach(function (id) {
    el(id).addEventListener('change', render);
  });
  el('btnResample').addEventListener('click', function () {
    seed = (seed * 1664525 + 1013904223) >>> 0;
    render();
  });
  window.addEventListener('resize', render);

  function preset(cfg) {
    return function () {
      Object.keys(cfg).forEach(function (k) {
        var node = el(k);
        if (node.type === 'checkbox') node.checked = cfg[k];
        else node.value = cfg[k];
      });
      render();
    };
  }
  // The trap: enterprise is 4.5% of a 20k holdout = 900 rows, below a 1500-row support floor.
  el('pTrap').addEventListener('click', preset({
    sldN: 20000, sldLift: 60, sldReg: 90, sldRho: 90, selReg: 'tier=enterprise',
    sldMin: 10, sldTol: 10, sldSup: 1500, cbSig: true, cbBonf: false, selTest: 'mcnemar'
  }));
  // No true regression anywhere — whatever fires is sampling noise on a small slice.
  el('pNoise').addEventListener('click', preset({
    sldN: 6000, sldLift: 0, sldReg: 0, sldRho: 70, selReg: 'none',
    sldMin: -50, sldTol: 0, sldSup: 100, cbSig: false, cbBonf: false, selTest: 'mcnemar'
  }));
  // A regression in a slice big enough for the gate to see it.
  el('pCaught').addEventListener('click', preset({
    sldN: 20000, sldLift: 100, sldReg: 30, sldRho: 90, selReg: 'device=web',
    sldMin: 10, sldTol: 10, sldSup: 500, cbSig: true, cbBonf: false, selTest: 'mcnemar'
  }));
  // Uniformly better candidate, thresholds sane.
  el('pClean').addEventListener('click', preset({
    sldN: 30000, sldLift: 120, sldReg: 0, sldRho: 90, selReg: 'none',
    sldMin: 10, sldTol: 10, sldSup: 500, cbSig: true, cbBonf: false, selTest: 'mcnemar'
  }));

  render();
})();
</script>

</body>
</html>
