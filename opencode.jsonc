{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "colab-proxy-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "git+https://github.com/googlecolab/colab-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
